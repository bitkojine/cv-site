---
const target = '/operating-system#admin-map';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content={`0;url=${target}`} http-equiv="refresh" />
    <title>Redirecting…</title>
    <link href={target} rel="canonical" />
    <meta content={`Redirecting to ${target}`} name="description" />
    <script is:inline>
      window.location.replace('/operating-system#admin-map');
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>{target}</a>.
    </p>
  </body>
</html>
