---
import SiteLayout from '../layouts/SiteLayout.astro';
import OperatingSystemContent from '../components/content/OperatingSystemContent.astro';

const schemaExtras = {
  about:
    'Website system for routing inbound visitors into qualified conversations and signed outcomes.',
  mainEntity: {
    '@type': 'CreativeWork',
    name: 'Website System',
    creator: {
      '@type': 'Person',
      name: 'Robertas Rudys',
    },
  },
};
---

<SiteLayout
  canonicalPath="/operating-system"
  description="How this website routes visitor traffic, page flows, and CTAs into signed conversations and deals."
  roleLabel="Visitor: Investor / Advisor / Operator"
  schemaExtras={schemaExtras}
  schemaType="CollectionPage"
  title="Robertas Rudys | Website System"
>
  <OperatingSystemContent />
</SiteLayout>
