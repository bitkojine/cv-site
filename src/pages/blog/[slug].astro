---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { BookOpen, ChevronLeft } from '@lucide/astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import SectionLastUpdated from '../../components/SectionLastUpdated.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props,
  { Content } = await post.render();
---

<SiteLayout
  canonicalPath={`/blog/${post.slug}`}
  description={post.data.description}
  ogType="website"
  roleLabel={post.data.title}
  title={`${post.data.title} | Robertas Rudys`}
>
  <ReadingProgress targetSelector="#blog-post-content" />

  <nav aria-label="Post navigation" class="mode-indicator" data-role-indicator>
    <a
      class="switch-button"
      href="/blog"
      style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem; color: var(--accent); font-weight: 500;"
    >
      <ChevronLeft size={18} />
      <span>Open all posts</span>
    </a>
  </nav>

  <nav aria-label="Post sections" class="in-page-nav" data-blog-toc hidden>
    <p class="in-page-nav__label">On this page</p>
    <ul data-blog-toc-list></ul>
  </nav>

  <article class="card" id="blog-post-content">
    <div
      style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; color: var(--accent);"
    >
      <BookOpen size={24} />
      <time
        datetime={post.data.date.toISOString()}
        style="font-size: 0.9rem; font-weight: 500; color: var(--muted);"
      >
        {
          post.data.date.toLocaleDateString('lt-LT', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            timeZone: 'Europe/Vilnius',
          })
        }
      </time>
    </div>

    <h1
      style="margin: 0 0 0.7rem; font-size: clamp(1.8rem, 5vw, 2.75rem); line-height: 1.15; color: var(--text);"
    >
      {post.data.title}
    </h1>

    <SectionLastUpdated date={post.data.date} label="Post updated" />

    <div
      class="prose"
      style="margin-top: 1.35rem; color: var(--text); line-height: 1.7;"
    >
      <Content />
    </div>
  </article>
</SiteLayout>

<style is:global>
  .prose h2 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: var(--text);
    scroll-margin-top: calc(var(--safe-top) + 8rem);
  }
  .prose h3 {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
    color: var(--text);
    scroll-margin-top: calc(var(--safe-top) + 8rem);
  }
  .prose p {
    margin-bottom: 1.25rem;
  }
  .prose ul,
  .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose code {
    background: var(--accent-soft);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--accent);
  }
  .prose pre {
    background: #1e293b;
    color: #f8fafc;
    padding: 1.25rem;
    border-radius: 12px;
    overflow-x: auto;
    scrollbar-gutter: stable both-edges;
    padding-bottom: calc(1.25rem + var(--scrollbar-lane));
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }
</style>

<script>
  (() => {
    const init = () => {
      const tocRoot = document.querySelector('[data-blog-toc]');
      const tocList = document.querySelector('[data-blog-toc-list]');
      const contentRoot = document.querySelector('#blog-post-content .prose');
      if (
        !(tocRoot instanceof HTMLElement) ||
        !(tocList instanceof HTMLElement) ||
        !(contentRoot instanceof HTMLElement)
      ) {
        return;
      }

      if (tocRoot.dataset.boundToc === '1') return;
      tocRoot.dataset.boundToc = '1';

      const headings = Array.from(contentRoot.querySelectorAll('h2, h3'));
      if (headings.length === 0) {
        tocRoot.hidden = true;
        return;
      }

      tocList.innerHTML = '';
      headings.forEach((heading, index) => {
        if (!(heading instanceof HTMLElement)) return;
        if (!heading.id) {
          heading.id = `post-section-${index + 1}`;
        }
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || `Section ${index + 1}`;
        item.append(link);
        tocList.append(item);
      });
      tocRoot.hidden = false;
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
