---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('lt-LT', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Europe/Vilnius',
});
---

<Layout
  title={`${post.data.title} - Robertas Rudys`}
  description={post.data.description}
>
  <main class="container article-container">
    <nav class="article-nav">
      <a href="/blog" class="back-link">← All Posts</a>
    </nav>

    <article class="article-content">
      <header class="article-header">
        <h1>{post.data.title}</h1>
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    <footer class="article-footer">
      <a href="/blog" class="back-link">← Back to all posts</a>
      <a href="/" class="cv-link">View my CV →</a>
    </footer>
  </main>
</Layout>

<style>
  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .article-container {
      padding: 4rem 2rem;
    }
  }

  .article-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-600);
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-header h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .article-header h1 {
      font-size: 2.5rem;
    }
  }

  time {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: var(--accent-100);
    color: var(--accent-600);
    border-radius: 0.25rem;
    font-weight: 500;
  }

  /* Prose styling for article content */
  .prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--text-primary);
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose :global(h1) {
    font-size: 1.75rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    border-bottom: none;
  }

  .prose :global(h2)::after {
    display: none;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(a) {
    color: var(--accent-600);
    text-decoration: underline;
  }

  .prose :global(a:hover) {
    color: var(--accent-700);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent-600);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .prose :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    background: var(--bg-card);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border-subtle);
  }

  .prose :global(pre) {
    background: var(--bg-card);
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-subtle);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cv-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .cv-link:hover {
    color: var(--accent-600);
  }
</style>
