---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Blog - Robertas Rudys"
  description="Technical articles, opinions, and notes by Robertas Rudys."
>
  <h1>Blog</h1>

  <nav class="site-nav" aria-label="Blog navigation">
    <ul>
      <li><a href="/">CV</a></li>
    </ul>
  </nav>

  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list-item">
            <a class="post-link touch-link" href={`/blog/${post.slug}`}>
              {post.data.title}
            </a>
            <br />
            <small class="post-date">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('lt-LT', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit',
                  timeZone: 'Europe/Vilnius',
                })}
              </time>
            </small>
            <p class="post-description">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <section class="card brutal-ai-score" aria-labelledby="blog-index-ai-score">
    <details class="brutal-ai-details">
      <summary>
        <span id="blog-index-ai-score" class="brutal-ai-title"
          >Brutal AI Score</span
        >
        <span class="brutal-ai-meta">Automated strict page audit</span>
        <strong>Overall (5.2 / 10)</strong>
      </summary>
      <div>
        <h2>Score Breakdown</h2>
        <ul>
          <li>Point of view and originality: <strong>6.0 / 10</strong></li>
          <li>Evidence quality and citations: <strong>4.5 / 10</strong></li>
          <li>
            Actionability for a hiring audience: <strong>5.1 / 10</strong>
          </li>
        </ul>
        <h3>Top 3 Gaps</h3>
        <ul>
          <li>Some claims are not tied to measurable operating context.</li>
          <li>Cross-post consistency in KPI framing is uneven.</li>
          <li>Evidence cross-links are still partial across articles.</li>
        </ul>
        <h3>Can This Hold Water?</h3>
        <p>
          Useful for narrative context, but not yet decision-grade without
          tighter KPI attribution and explicit evidence mapping.
        </p>
      </div>
    </details>
  </section>
</BaseLayout>

<style>
  .brutal-ai-score {
    margin-top: var(--space-lg);
    border: 1px solid
      color-mix(in oklab, var(--color-border) 80%, var(--color-danger) 20%);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-danger-soft) 35%, transparent) 0%,
        color-mix(in oklab, var(--color-bg-elevated) 95%, transparent) 65%
      ),
      var(--color-bg-elevated);
    position: relative;
    overflow: hidden;
  }

  .brutal-ai-score::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-danger),
      color-mix(in oklab, var(--color-danger) 70%, #fff 30%)
    );
    opacity: 0.9;
    pointer-events: none;
  }

  .brutal-ai-score h2,
  .brutal-ai-score h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: color-mix(in oklab, var(--color-text) 88%, var(--color-danger) 12%);
  }

  .brutal-ai-score strong {
    color: color-mix(in oklab, var(--color-danger) 85%, var(--color-text) 15%);
  }

  .brutal-ai-details {
    width: 100%;
  }

  .brutal-ai-details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    flex-wrap: nowrap;
    gap: 0.5rem;
    line-height: 1.35;
    padding: 0.12rem 0;
  }

  .brutal-ai-details summary::-webkit-details-marker {
    display: none;
  }

  .brutal-ai-details summary::before {
    content: '▾';
    color: color-mix(in oklab, var(--color-danger) 78%, var(--color-text) 22%);
    font-size: 0.95rem;
    line-height: 1;
    transition: transform 150ms ease;
    transform: rotate(0deg);
    transform-origin: 50% 50%;
    margin-right: 0.1rem;
  }

  .brutal-ai-details:not([open]) summary::before {
    transform: rotate(-90deg);
  }

  .brutal-ai-details summary strong {
    margin-left: auto;
  }

  .brutal-ai-details > *:not(summary):first-of-type {
    margin-top: var(--space-sm);
  }

  @media (max-width: 560px) {
    .brutal-ai-details summary strong {
      margin-left: 0;
    }
  }
</style>
