---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Blog - Robertas Rudys"
  description="Technical articles, opinions, and notes by Robertas Rudys."
>
  <h1>Blog</h1>

  <nav class="site-nav" aria-label="Blog navigation">
    <ul>
      <li><a href="/">CV</a></li>
    </ul>
  </nav>

  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list-item">
            <a class="post-link touch-link" href={`/blog/${post.slug}`}>
              {post.data.title}
            </a>
            <br />
            <small class="post-date">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('lt-LT', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit',
                  timeZone: 'Europe/Vilnius',
                })}
              </time>
            </small>
            <p class="post-description">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
