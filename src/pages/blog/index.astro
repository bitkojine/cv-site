---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { BookText, House } from '@lucide/astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<SiteLayout
  canonicalPath="/blog"
  description="Technical articles, opinions, and notes by Robertas Rudys."
  roleLabel="Blog"
  title="Blog | Robertas Rudys"
>
  <nav aria-label="Blog navigation" class="mode-indicator" data-role-indicator>
    <a
      class="switch-button"
      href="/"
      style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem; color: var(--accent); font-weight: 500;"
    >
      <House size={18} />
      <span>Back to Home</span>
    </a>
  </nav>

  <section aria-labelledby="blog-heading" class="mode-hero">
    <div class="headline-row">
      <span aria-hidden="true" class="headline-icon"
        ><BookText size={86} /></span
      >
      <h1 id="blog-heading">Engineering notes and building in public.</h1>
    </div>
    <p class="cta-note">
      Articles on software reliability, .NET architecture, and the intersection
      of AI and development.
    </p>
  </section>

  {
    posts.length === 0 ? (
      <section class="card">
        <p>No posts yet.</p>
      </section>
    ) : (
      posts.map((post) => (
        <section class="card">
          <article>
            <h2 style="margin: 0; font-size: 1.25rem;">
              <a
                href={`/blog/${post.slug}`}
                style="text-decoration: none; color: var(--accent);"
              >
                {post.data.title}
              </a>
            </h2>
            <small style="display: block; margin-top: 0.4rem; color: var(--muted); font-size: 0.85rem;">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('lt-LT', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit',
                  timeZone: 'Europe/Vilnius',
                })}
              </time>
            </small>
            <p style="margin-top: 0.75rem; color: var(--text); font-size: 0.95rem;">
              {post.data.description}
            </p>
          </article>
        </section>
      ))
    )
  }
</SiteLayout>
