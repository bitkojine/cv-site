---
import SiteLayout from '../layouts/SiteLayout.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import HiringContent from '../components/content/HiringContent.astro';

const schemaExtras = {
  about:
    'Proof-led hiring profile for senior backend engineering with evidence, tradeoffs, and interview guidance.',
  mainEntity: {
    '@type': 'Person',
    name: 'Robertas Rudys',
    jobTitle: 'Senior .NET Software Engineer',
    worksFor: {
      '@type': 'Organization',
      name: 'Product Company (EU, Remote)',
    },
  },
};
---

<SiteLayout
  canonicalPath="/hiring"
  description="Senior backend hiring profile with evidence library, decision records, and tradeoff-led interview prompts."
  ogType="profile"
  roleLabel="Visitor: Recruiter / Hiring Manager"
  schemaExtras={schemaExtras}
  schemaType="ProfilePage"
  title="Robertas Rudys | Recruiter / Hiring Manager"
>
  <ModeSwitch currentRole="Recruiter / Hiring Manager" />
  <HiringContent />
</SiteLayout>
