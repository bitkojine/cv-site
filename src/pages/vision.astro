---
import SiteLayout from '../layouts/SiteLayout.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import VisionContent from '../components/content/VisionContent.astro';

const schemaExtras = {
  about:
    'Strategic product direction, experiments, and long-term trajectory for investor/advisor audiences.',
  mainEntity: {
    '@type': 'CreativeWork',
    name: 'Product and Technical Vision',
    creator: {
      '@type': 'Person',
      name: 'Robertas Rudys',
    },
  },
};
---

<SiteLayout
  canonicalPath="/vision"   description="Strategic profile of product direction, experiments, and long-term trajectory."   roleLabel="Visitor: Investor / Advisor"   schemaExtras={schemaExtras}   schemaType="CollectionPage"   title="Robertas Rudys | Investor / Advisor"
>
  <ModeSwitch currentRole="Investor / Advisor" />
  <VisionContent />
</SiteLayout>
