---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkflowStatusBadge from '../../components/WorkflowStatusBadge.astro';
import type { WorkflowRun } from '../../lib/github-actions.mts';

const runs: WorkflowRun[] = [
  {
    workflow_id: 1,
    name: 'CI',
    html_url: 'https://example.com/ci',
    status: 'completed',
    conclusion: 'success',
  },
  {
    workflow_id: 2,
    name: 'Deploy',
    html_url: 'https://example.com/deploy',
    status: 'in_progress',
    conclusion: null,
  },
  {
    workflow_id: 3,
    name: 'Publish',
    html_url: 'https://example.com/publish',
    status: 'completed',
    conclusion: 'failure',
  },
  {
    workflow_id: 4,
    name: 'Docs',
    html_url: 'https://example.com/docs',
    status: 'completed',
    conclusion: 'cancelled',
  },
];
---

<SiteLayout
  canonicalPath="/test/workflow-badge"   description="Visual test page for workflow status badges."   roleLabel="Badge Test"   title="Workflow Badge Test | Robertas Rudys"
>
  <section class="card">
    <h1>Workflow Badge Test</h1>
    <div style="display: grid; gap: 0.75rem;">
      {runs.map((run) => <WorkflowStatusBadge run={run} />)}
    </div>
  </section>
</SiteLayout>
