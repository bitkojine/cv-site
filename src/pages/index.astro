---
import SiteLayout from '../layouts/SiteLayout.astro';
import DoorSelection from '../components/DoorSelection.astro';

const schemaExtras = {
  about:
    'Role-based entry point for a personal site with dedicated hiring, builder, and vision routes.',
  potentialAction: {
    '@type': 'ChooseAction',
    target: ['/hiring', '/build', '/vision'],
  },
};
---

<SiteLayout
  title="Robertas Rudys | Choose Your Role"
  description="Select the role-based profile that matches your intent."
  canonicalPath="/"
  schemaType="WebPage"
  schemaExtras={schemaExtras}
>
  <DoorSelection />

  <section class="card brutal-ai-score" aria-labelledby="entry-ai-score">
    <h2 id="entry-ai-score">Brutal AI Score</h2>
    <p>
      Overall score: <strong>6.9 / 10</strong> (visitor intent is clearer and routing
      is low-friction, but proof is still thin before click-through).
    </p>
    <ul>
      <li>Audience self-selection clarity: 9.1/10</li>
      <li>Entry-page value proposition clarity: 6.2/10</li>
      <li>Role path differentiation signal: 8.5/10</li>
      <li>Friction to first meaningful click: 8.8/10</li>
      <li>Trust/evidence before click-through: 4.1/10</li>
      <li>Conversion readiness as marketing entry point: 4.7/10</li>
    </ul>
    <h3>Critical gaps</h3>
    <ul>
      <li>
        No evidence artifacts are visible before route selection, so trust must
        be earned on destination pages.
      </li>
      <li>
        Route promises are clear but still mostly directional, with no
        quantification at entry level.
      </li>
      <li>
        No hard qualification cues (pricing band, availability window, traction
        snapshot) are exposed pre-click.
      </li>
    </ul>
    <h3>Can this hold water?</h3>
    <p>
      This holds water as a high-clarity routing page and reduces decision
      friction for first click. It still cannot carry trust by itself without
      evidence on the next page.
    </p>
  </section>
</SiteLayout>

<style>
  .brutal-ai-score {
    position: relative;
    overflow: clip;
    border: 1px solid #f3c2cd;
    background:
      radial-gradient(circle at 100% 0%, #ffe9ef 0%, transparent 42%),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--surface) 93%, #fff0f4),
        var(--surface) 58%
      );
  }

  .brutal-ai-score::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #fb7185, #e11d48 38%, #be123c 78%);
    opacity: 0.8;
  }

  .brutal-ai-score h2,
  .brutal-ai-score h3 {
    color: #9f1239;
  }

  .brutal-ai-score strong {
    color: #be123c;
  }
</style>
