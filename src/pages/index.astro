---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Controls from '../components/Controls.astro';
import cvData from '../data/cv.json';

const { personalInfo, coreSkills, experience, independentProjects, lookingFor } = cvData;

const lastUpdated = new Date().toLocaleString('en-US', { 
	month: 'long', 
	day: 'numeric', 
	year: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
	timeZoneName: 'short'
});
---

<Layout 
	title={`${personalInfo.name} - ${personalInfo.title}`}
	description={`Software engineer with experience building high-performance applications. Specialized in ${personalInfo.contact.stack}.`}
>
	<Controls />
	
	<div class="container">
		<Header 
			name={personalInfo.name}
			title={personalInfo.title}
			contact={personalInfo.contact}
		/>

		<hr />

		<Section title="PROFILE" showCopy={true}>
			{personalInfo.profile.split('\n\n').map(p => <p>{p}</p>)}
		</Section>

		<Section title="CORE SKILLS">
			{coreSkills.map(skill => (
				<p>• <strong>{skill.label}:</strong> {skill.value}</p>
			))}
		</Section>

		<Section title="PROFESSIONAL EXPERIENCE">
			{experience.map(item => (
				<ExperienceItem {...item} />
			))}
		</Section>

		<Section title="INDEPENDENT PROJECT / STARTUP ATTEMPT">
			{independentProjects.map(item => (
				<ExperienceItem {...item} />
			))}
		</Section>

		<Section title="WHAT I'M LOOKING FOR NEXT">
			<ul>
				{lookingFor.map(item => <li>{item}</li>)}
			</ul>
		</Section>

		<div class="last-updated">
			Last updated: {lastUpdated}
		</div>
	</div>
</Layout>
