---
import SiteLayout from '../layouts/SiteLayout.astro';
import DoorSelection from '../components/DoorSelection.astro';

const schemaExtras = {
  about:
    'Role-based entry point for a personal site with dedicated hiring, builder, and vision routes.',
  potentialAction: {
    '@type': 'ChooseAction',
    target: ['/hiring', '/build', '/vision'],
  },
};
---

<SiteLayout
  title="Robertas Rudys | Choose Your Role"
  description="Select the role-based profile that matches your intent."
  canonicalPath="/"
  schemaType="WebPage"
  schemaExtras={schemaExtras}
>
  <DoorSelection />

  <section class="card" aria-labelledby="entry-truth-constraints">
    <h2 id="entry-truth-constraints">Before You Click: Evidence Boundaries</h2>
    <ul>
      <li>
        These doors segment by audience intent; they do not replace
        role-specific diligence.
      </li>
      <li>
        Public pages prioritize truthful constraints over inflated outcomes;
        some proof remains qualitative due to confidentiality limits.
      </li>
      <li>
        Use each route only if you need that decision lens: hiring, execution
        support, or investor/advisor thesis review.
      </li>
    </ul>
  </section>

  <section class="card" aria-labelledby="entry-observable-facts">
    <h2 id="entry-observable-facts">Observable Facts On This Page</h2>
    <ul>
      <li>Exactly 3 route options with distinct audience labels</li>
      <li>Engineering track record stated as starting in 2015</li>
      <li>
        Direct CTA path exists for hiring, build, and investor conversations
      </li>
    </ul>
  </section>

  <section class="card brutal-ai-score" aria-labelledby="entry-ai-score">
    <h2 id="entry-ai-score">Brutal AI Score</h2>
    <p>
      Overall score: <strong>7.1 / 10</strong> (excellent routing clarity, while trust
      proof is intentionally thin at entry level).
    </p>
    <ul>
      <li>Audience self-selection clarity: 9.0/10</li>
      <li>Entry-page value proposition clarity: 5.4/10</li>
      <li>Role path differentiation signal: 8.4/10</li>
      <li>Friction to first meaningful click: 8.8/10</li>
      <li>Trust/evidence before click-through: 5.4/10</li>
      <li>Conversion readiness as marketing entry point: 5.8/10</li>
    </ul>
    <h3>Critical gaps</h3>
    <ul>
      <li>
        Entry page contains minimal proof artifacts by design, so trust still
        depends on a second click.
      </li>
      <li>
        Value proposition is mostly directional and does not state quantified
        outcomes or hard constraints per route.
      </li>
      <li>No direct performance evidence is visible before route selection.</li>
    </ul>
    <h3>Can this hold water?</h3>
    <p>
      It holds water as a role router, not as an evidence-bearing conversion
      page. It earns clicks, but trust still has to be validated on destination
      pages.
    </p>
  </section>
</SiteLayout>

<style>
  .brutal-ai-score {
    position: relative;
    overflow: clip;
    border: 1px solid #f3c2cd;
    background:
      radial-gradient(circle at 100% 0%, #ffe9ef 0%, transparent 42%),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--surface) 93%, #fff0f4),
        var(--surface) 58%
      );
  }

  .brutal-ai-score::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #fb7185, #e11d48 38%, #be123c 78%);
    opacity: 0.8;
  }

  .brutal-ai-score h2,
  .brutal-ai-score h3 {
    color: #9f1239;
  }

  .brutal-ai-score strong {
    color: #be123c;
  }
</style>
