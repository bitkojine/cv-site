---
import SiteLayout from '../layouts/SiteLayout.astro';
import DoorSelection from '../components/DoorSelection.astro';

const schemaExtras = {
  about:
    'Hiring-first entry point with a direct recruiter path and secondary role routes.',
  potentialAction: {
    '@type': 'ChooseAction',
    target: ['/hiring', '/build', '/vision', '/dev', '/operating-system'],
  },
};
---

<SiteLayout
  title="Robertas Rudys | Hiring Inbox"
  description="Review backend hiring fit quickly, then request resume or schedule an intro."
  canonicalPath="/"
  roleLabel="Visitor: Recruiter / Hiring Manager"
  schemaType="WebPage"
  schemaExtras={schemaExtras}
  showBuildVersion={false}
  showLiveBuildBadge={false}
>
  <DoorSelection />
</SiteLayout>
