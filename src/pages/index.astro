---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildStatus from '../components/BuildStatus.astro';
import cvData from '../data/cv.json';

const {
  personalInfo,
  coreSkills,
  experience,
  independentProjects,
  lookingFor,
} = cvData;

const profileParagraphs = personalInfo.profile
  .split('\n\n')
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

function toStartYear(value: string) {
  return Number(value.slice(0, 4));
}

const earliestStartYear = Math.min(
  ...[...experience, ...independentProjects].map((item) =>
    toStartYear(item.startDate)
  )
);

const serviceOffers = [
  {
    name: 'Backend Stability Sprint',
    duration: '5 business days',
    fit: 'Teams that need fast bug fixing and safer releases in an existing .NET codebase.',
    outcomes: [
      'Prioritized production bug list with concrete fixes',
      'API reliability and error-handling improvements',
      'Short handoff note for ongoing team ownership',
    ],
  },
  {
    name: 'Feature Delivery Block',
    duration: '10 business days',
    fit: 'Product teams that need one important backend feature shipped without long onboarding.',
    outcomes: [
      'One scoped feature delivered end-to-end',
      'Backend and API changes with a regression-safe approach',
      'Implementation walkthrough and deployment support',
    ],
  },
  {
    name: 'Legacy Refactor Pass',
    duration: '2 to 3 weeks',
    fit: 'Mature systems that are slowing delivery due to brittle architecture or technical bottlenecks.',
    outcomes: [
      'Refactor plan focused on practical risk reduction',
      'Targeted cleanup in the highest-friction area',
      'Performance and maintainability recommendations',
    ],
  },
];

const engagementSteps = [
  '15-minute intro call to confirm scope and urgency.',
  'I send a fixed-scope proposal with timeline and deliverables.',
  'Work starts with async updates and a clear handoff at the end.',
];

const workRules = [
  {
    title: 'What I Do',
    points: [
      'Backend/API delivery in existing .NET systems',
      'Production issue fixes and reliability hardening',
      'Targeted refactors that reduce delivery friction',
    ],
  },
  {
    title: "What I Don't Do",
    points: [
      'Open-ended advisory without an execution scope',
      '24/7 on-call ownership after contract completion',
      'Large rewrites without milestones and acceptance gates',
    ],
  },
  {
    title: 'Communication Cadence',
    points: [
      'Kickoff alignment before implementation starts',
      'Concise async updates during execution',
      'Direct escalation when blockers affect timeline',
      'Transparent AI-assisted workflow with review checkpoints',
    ],
  },
  {
    title: 'Definition Of Done',
    points: [
      'Agreed scope delivered and demo-ready',
      'Known risks and tradeoffs documented',
      'Handoff notes for internal team ownership',
    ],
  },
  {
    title: 'Delivery Model',
    points: [
      'AI-assisted delivery is standard for analysis and implementation speed',
      'Decisions and diffs are reviewed before handoff',
      'Repository access must support agent-assisted execution',
    ],
  },
];

const highlightRoles = experience.slice(0, 3);
const trustFacts = [
  `Shipping production software since ${earliestStartYear}`,
  'C#/.NET specialist for existing systems',
  'AI-assisted delivery by default',
  'Remote collaboration across EU time zones',
  'Fixed-scope engagements with clean handoff',
];
const faqItems = [
  {
    question: 'Can you start inside an existing team quickly?',
    answer:
      'Yes. Most contracts begin with one scoped problem and existing code ownership boundaries.',
  },
  {
    question: 'What if our requirements are still moving?',
    answer:
      'Requirements can change. Work is split into short blocks, and each block has a locked scope, so new requests are queued for the next block instead of disrupting delivery.',
  },
  {
    question: 'How is progress communicated?',
    answer:
      'Expect concise async updates, early blocker escalation, and a final handoff summary for your team.',
  },
  {
    question: 'Do you use AI tools during delivery?',
    answer:
      'Yes. Delivery is AI-assisted by default, with decisions, diffs, and outputs reviewed before handoff.',
  },
];

function toIsoDate(value: string) {
  return value.length === 4 ? `${value}-01-01` : `${value}-01`;
}

function toHumanDate(value: string) {
  if (value.length === 4) return value;
  const [year, month] = value.split('-');
  const monthIndex = Number(month) - 1;
  const monthNames = [
    'Jan',
    'Feb',
    'Mar',
    'Apr',
    'May',
    'Jun',
    'Jul',
    'Aug',
    'Sep',
    'Oct',
    'Nov',
    'Dec',
  ];
  return `${monthNames[monthIndex]} ${year}`;
}
---

<BaseLayout
  title="Robertas Rudys - Contract .NET Engineer"
  description="Contract-ready CV and service offers for Robertas Rudys."
>
  <h1>Robertas Rudys</h1>

  <section class="business-hero" aria-labelledby="hero-heading">
    <p class="eyebrow">Contract .NET Engineering</p>
    <h2 id="hero-heading">
      Stable backend delivery for teams that cannot pause product work.
    </h2>
    <p>
      Senior C#/.NET engineering focused on production issue resolution, backend
      feature delivery, and reliability upgrades in mature systems.
    </p>
    <ul class="trust-facts" aria-label="Trust indicators">
      {trustFacts.map((fact) => <li>{fact}</li>)}
    </ul>
    <div class="cta-row">
      <a class="cta-primary" href={`mailto:${personalInfo.contact.email}`}>
        Book an intro call
      </a>
      <a class="cta-secondary" href="https://www.linkedin.com/in/robertasr/">
        View LinkedIn
      </a>
    </div>
  </section>

  <section class="profile-sketch" aria-labelledby="profile-overview-heading">
    <h2 id="profile-overview-heading">Profile Overview</h2>
    <div class="profile-sketch__row">
      <p class="profile-sketch__label">Role</p>
      <p class="profile-sketch__value">{personalInfo.title}</p>
    </div>
    <div class="profile-sketch__row">
      <p class="profile-sketch__label">Email</p>
      <p class="profile-sketch__value">
        <a href={`mailto:${personalInfo.contact.email}`}>
          {personalInfo.contact.email}
        </a>
      </p>
    </div>
    <div class="profile-sketch__row">
      <p class="profile-sketch__label">Location</p>
      <p class="profile-sketch__value">{personalInfo.contact.location}</p>
    </div>
    <div class="profile-sketch__row">
      <p class="profile-sketch__label">Remote</p>
      <p class="profile-sketch__value">{personalInfo.contact.remote}</p>
    </div>
    <div class="profile-sketch__row">
      <p class="profile-sketch__label">Stack</p>
      <p class="profile-sketch__value">{personalInfo.contact.stack}</p>
    </div>
  </section>

  <section aria-labelledby="summary-heading">
    <h2 id="summary-heading">Professional Summary</h2>
    {profileParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section aria-labelledby="services-heading">
    <h2 id="services-heading">Fixed-Scope Service Offers</h2>
    <p class="section-intro">
      These engagements are designed for fast starts, clear outcomes, and low
      process overhead.
    </p>
    <div class="offer-grid">
      {
        serviceOffers.map((offer) => (
          <article class="offer-card">
            <h3>{offer.name}</h3>
            <p class="offer-meta">{offer.duration}</p>
            <p>{offer.fit}</p>
            <ul>
              {offer.outcomes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <aside class="cta-panel" aria-label="Fast contact">
      <h3>Ready to scope one problem?</h3>
      <p>
        Send a short email with your context, and we can confirm fit on a brief
        intro call.
      </p>
      <div class="cta-row">
        <a class="cta-primary" href={`mailto:${personalInfo.contact.email}`}>
          Start by email
        </a>
      </div>
    </aside>
  </section>

  <section aria-labelledby="proof-heading">
    <h2 id="proof-heading">Proof From Recent Roles</h2>
    <div class="proof-grid">
      {
        highlightRoles.map((role) => (
          <article class="proof-card">
            <h3>{role.title}</h3>
            <p>
              <span class="experience-item__company">{role.company}</span>
              {' · '}
              <time datetime={toIsoDate(role.startDate)}>
                {toHumanDate(role.startDate)}
              </time>
              {role.endDate ? (
                role.endDate === role.startDate ? null : (
                  <>
                    {' - '}
                    <time datetime={toIsoDate(role.endDate)}>
                      {toHumanDate(role.endDate)}
                    </time>
                  </>
                )
              ) : (
                ' - Present'
              )}
            </p>
            <ul>
              {role.description.slice(0, 2).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="engagement-heading">
    <h2 id="engagement-heading">How Engagement Works</h2>
    <ol class="process-list">
      {engagementSteps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section aria-labelledby="work-style-heading">
    <h2 id="work-style-heading">How I Work</h2>
    <div class="work-grid">
      {
        workRules.map((rule) => (
          <article class="work-card">
            <h3>{rule.title}</h3>
            <ul>
              {rule.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="faq-heading">
    <h2 id="faq-heading">Common Questions</h2>
    <div class="faq-list">
      {
        faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Technical Skills</h2>
    <ul class="skills-list">
      {
        coreSkills.map((skill) => (
          <li>
            <strong>{skill.label}:</strong> {skill.value}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="experience-heading">
    <h2 id="experience-heading">Professional Experience</h2>
    {
      experience.map((role) => (
        <article class="experience-item">
          <header class="experience-item__header">
            <h3>{role.title}</h3>
            <p>
              <span class="experience-item__company">{role.company}</span>
              {role.location && (
                <>
                  {' '}
                  <span aria-hidden="true">-</span> {role.location}
                </>
              )}
              <br />
              <time datetime={toIsoDate(role.startDate)}>
                {toHumanDate(role.startDate)}
              </time>
              {role.endDate ? (
                role.endDate === role.startDate ? null : (
                  <>
                    {' - '}
                    <time datetime={toIsoDate(role.endDate)}>
                      {toHumanDate(role.endDate)}
                    </time>
                  </>
                )
              ) : (
                ' - Present'
              )}
            </p>
          </header>
          <ul>
            {role.description.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  {
    independentProjects.length > 0 && (
      <section aria-labelledby="independent-work-heading">
        <h2 id="independent-work-heading">Independent Work</h2>
        {independentProjects.map((project) => (
          <article class="experience-item">
            <header class="experience-item__header">
              <h3>{project.title}</h3>
              <p>
                <span class="experience-item__company">{project.company}</span>
                {project.location && (
                  <>
                    {' '}
                    <span aria-hidden="true">-</span> {project.location}
                  </>
                )}
                <br />
                <time datetime={toIsoDate(project.startDate)}>
                  {toHumanDate(project.startDate)}
                </time>
                {project.endDate ? (
                  project.endDate === project.startDate ? null : (
                    <>
                      {' - '}
                      <time datetime={toIsoDate(project.endDate)}>
                        {toHumanDate(project.endDate)}
                      </time>
                    </>
                  )
                ) : (
                  ' - Present'
                )}
              </p>
            </header>
            <ul>
              {project.description.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    )
  }

  <section aria-labelledby="target-role-heading">
    <h2 id="target-role-heading">Best Contract Fit</h2>
    <ul>
      {lookingFor.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="writing-heading">
    <h2 id="writing-heading">Blog</h2>
    <ul class="writing-list">
      <li><a class="touch-link" href="/blog">Blog index</a></li>
    </ul>
  </section>

  <section class="site-utility" aria-labelledby="build-heading">
    <h2 id="build-heading">Site Build</h2>
    <BuildStatus />
  </section>
</BaseLayout>
