---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import WorkflowStatusBadge from '../components/WorkflowStatusBadge.astro';

import cvDataRaw from '../data/cv.json';
import { CVSchema } from '../data/schema';
import { getCollection } from 'astro:content';
import { getGithubData } from '../lib/github-actions.mts';
import type { GitHubCommit, WorkflowRun } from '../lib/github-actions.mts';

// Validate data at build time
const cvData = CVSchema.parse(cvDataRaw);

const {
  personalInfo,
  coreSkills,
  experience,
  independentProjects,
  lookingFor,
} = cvData;

// Get latest blog posts (max 3)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const githubOwner = 'bitkojine';
const githubRepo = 'cv-site';
const shouldFetchGithub = !import.meta.env.DEV;
let latestWorkflowRuns: WorkflowRun[] = [];
let latestCommits: GitHubCommit[] = [];

if (shouldFetchGithub) {
  const cacheData = await getGithubData({
    owner: githubOwner,
    repo: githubRepo,
    branch: 'main',
  });
  latestWorkflowRuns = cacheData.latestWorkflowRuns;
  latestCommits = cacheData.latestCommits;
}

const formatVilniusDateTime = (raw: string) => {
  const date = new Date(raw);
  const datePart = date.toLocaleDateString('lt-LT', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Europe/Vilnius',
  });
  const timePart = date.toLocaleTimeString('lt-LT', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Vilnius',
    hour12: false,
    timeZoneName: 'short',
  });
  return `${datePart}d. ${timePart}`;
};

const extractStartYear = (period: string) => {
  const match = period.match(/\d{4}/);
  return match ? Number.parseInt(match[0], 10) : 0;
};

const combinedExperience = [...experience, ...independentProjects].sort(
  (a, b) => extractStartYear(b.period) - extractStartYear(a.period)
);
---

<Layout
  title={`${personalInfo.name} - ${personalInfo.title}`}
  description={`Software engineer specializing in ${personalInfo.contact.stack}. ${personalInfo.profile.slice(0, 150)}...`}
>
  <main class="container">
    <Header
      name={personalInfo.name}
      title={personalInfo.title}
      contact={personalInfo.contact}
    />

    <Section title="PROFILE">
      {personalInfo.profile.split('\n\n').map((p) => <p>{p}</p>)}
    </Section>

    <Section title="CORE SKILLS">
      <ul class="skills-list">
        {
          coreSkills.map((skill) => (
            <li>
              <strong>{skill.label}:</strong> {skill.value}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="EXPERIENCE">
      {
        combinedExperience.map((item) => (
          <ExperienceItem
            title={item.title}
            company={item.company}
            period={item.period}
            description={item.description}
          />
        ))
      }
    </Section>

    <Section title="WHAT I'M LOOKING FOR NEXT">
      <ul class="next-list">
        {lookingFor.map((item) => <li>{item}</li>)}
      </ul>
    </Section>

    <div class="no-print">
      <Section title="ENDORSEMENTS">
        <p>
          If we worked together or you reviewed my work, a short public
          endorsement helps hiring teams move faster.
        </p>
        <p class="endorsement-explainer">
          Clicking "Post Endorsement" opens a prefilled GitHub issue draft in a
          new tab. You review it and click "Submit new issue" yourself—nothing
          is posted automatically.
        </p>
        <form
          id="endorsement-form"
          class="endorsement-form"
          data-github-owner={githubOwner}
          data-github-repo={githubRepo}
        >
          <label class="endorsement-field">
            <span>Name</span>
            <input
              type="text"
              name="name"
              placeholder="Ada Lovelace"
              autocomplete="name"
              required
            />
          </label>
          <label class="endorsement-field">
            <span>Company / Role</span>
            <input
              type="text"
              name="company"
              placeholder="Acme Corp · Engineering Manager"
              required
            />
          </label>
          <label class="endorsement-field">
            <span>Endorsement (1–3 sentences)</span>
            <textarea
              name="note"
              rows="3"
              placeholder="Robertas shipped critical backend migrations with calm, clear communication."
              required></textarea>
          </label>
          <button type="submit" class="endorsement-submit btn-primary">
            Post Endorsement on GitHub
          </button>
        </form>
        <p
          id="endorsement-success"
          class="endorsement-success"
          role="status"
          aria-live="polite"
        >
        </p>
        <p class="endorsement-help">
          A draft issue opens in a new tab so you can review before posting.
        </p>
      </Section>
    </div>

    {
      latestPosts.length > 0 && (
        <div class="no-print">
          <Section title="LATEST ARTICLES">
            <div class="articles-preview">
              {latestPosts.map((post) => (
                <a href={`/blog/${post.slug}`} class="article-link">
                  <span class="article-title">{post.data.title}</span>
                  <span class="article-date">
                    {post.data.date.toLocaleDateString('lt-LT', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit',
                      timeZone: 'Europe/Vilnius',
                    })}
                  </span>
                </a>
              ))}
              <a href="/blog" class="view-all-link">
                View all posts →
              </a>
            </div>
          </Section>
        </div>
      )
    }

    <footer class="last-updated no-print">
      <div
        id="github-actions-container"
        class="github-actions-container no-print"
        data-github-owner={githubOwner}
        data-github-repo={githubRepo}
        data-github-branch="main"
      >
        {
          latestWorkflowRuns.length > 0 ? (
            latestWorkflowRuns.map((run) => {
              return <WorkflowStatusBadge run={run} />;
            })
          ) : (
            <a
              href="https://github.com/bitkojine/cv-site/actions"
              target="_blank"
              rel="noopener noreferrer"
              class="workflow-badge workflow-badge--fallback"
              data-status="unknown"
            >
              <span class="workflow-badge__dot" aria-hidden="true" />
              <span class="workflow-badge__meta">
                <span class="workflow-badge__name">View Build Status</span>
                <span class="workflow-badge__status">on GitHub</span>
              </span>
            </a>
          )
        }
      </div>

      <div
        id="github-commits-container"
        class="github-commits-container no-print"
      >
        <h2>LATEST COMMITS</h2>
        {
          latestCommits.length > 0 ? (
            <ul class="commits-list">
              {latestCommits.map((commit) => {
                const message = commit.commit.message.split('\n')[0];
                const date = formatVilniusDateTime(commit.commit.author.date);
                return (
                  <li>
                    <a
                      href={commit.html_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {message}
                    </a>
                    <span class="commit-meta"> ({date})</span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="fallback-text">
              <a
                href="https://github.com/bitkojine/cv-site/commits"
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub →
              </a>
            </p>
          )
        }
      </div>
    </footer>
  </main>
</Layout>

<script is:inline>
  const endorsementForm = document.getElementById('endorsement-form');
  const endorsementSuccess = document.getElementById('endorsement-success');

  if (endorsementForm) {
    let started = false;
    endorsementForm.addEventListener('focusin', () => {
      if (!started) {
        started = true;
        window.cvTrack?.('endorsement_started');
      }
    });

    endorsementForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(endorsementForm);
      const name = (formData.get('name') || '').toString().trim();
      const company = (formData.get('company') || '').toString().trim();
      const note = (formData.get('note') || '').toString().trim();

      if (!name || !company || !note) {
        return;
      }

      const owner = endorsementForm.dataset.githubOwner || 'bitkojine';
      const repo = endorsementForm.dataset.githubRepo || 'cv-site';
      const issueUrl = new URL(
        `https://github.com/${owner}/${repo}/issues/new`
      );
      issueUrl.searchParams.set(
        'title',
        `Endorsement from ${name} (${company})`
      );
      issueUrl.searchParams.set(
        'body',
        `**Endorser**: ${name}\n**Company/Role**: ${company}\n\n${note}\n\n---\nSubmitted via ${window.location.origin}`
      );
      issueUrl.searchParams.set('labels', 'endorsement');

      window.cvTrack?.('endorsement_submitted', { channel: 'github_issue' });
      window.open(issueUrl.toString(), '_blank', 'noopener,noreferrer');

      endorsementForm.reset();
      if (endorsementSuccess) {
        endorsementSuccess.textContent =
          'Thanks! A GitHub issue draft opened in a new tab.';
      }
    });
  }

  const actionsContainer = document.getElementById('github-actions-container');
  if (actionsContainer) {
    const badges = Array.from(
      actionsContainer.querySelectorAll('.workflow-badge[data-workflow-id]')
    );
    const owner = actionsContainer.dataset.githubOwner;
    const repo = actionsContainer.dataset.githubRepo;
    const branch = actionsContainer.dataset.githubBranch;

    const resolveBadge = (status, conclusion) => {
      if (status === 'in_progress' || status === 'queued') {
        return { state: 'running', label: 'Running' };
      }
      if (status === 'completed' && conclusion === 'success') {
        return { state: 'success', label: 'success' };
      }
      if (status === 'completed' && conclusion === 'failure') {
        return { state: 'failure', label: 'failure' };
      }
      return { state: 'unknown', label: 'Unknown' };
    };

    const applyRuns = (runs) => {
      const latestRuns = new Map();
      for (const run of runs || []) {
        if (run && !latestRuns.has(run.workflow_id)) {
          latestRuns.set(run.workflow_id, run);
        }
      }
      badges.forEach((badge) => {
        const workflowId = Number(badge.dataset.workflowId);
        const run = latestRuns.get(workflowId);
        if (!run) {
          return;
        }
        const resolved = resolveBadge(run.status, run.conclusion);
        badge.dataset.status = resolved.state;
        const statusEl = badge.querySelector('.workflow-badge__status');
        if (statusEl) {
          statusEl.textContent = resolved.label;
        }
        const nameEl = badge.querySelector('.workflow-badge__name');
        const nameText = nameEl ? nameEl.textContent : 'Workflow';
        badge.setAttribute(
          'aria-label',
          `${nameText} workflow status: ${resolved.label}`
        );
      });
    };

    if (owner && repo) {
      const runsUrl = new URL(
        `https://api.github.com/repos/${owner}/${repo}/actions/runs`
      );
      runsUrl.searchParams.set('per_page', '30');
      if (branch) {
        runsUrl.searchParams.set('branch', branch);
      }

      fetch(runsUrl.toString(), {
        headers: {
          Accept: 'application/vnd.github+json',
        },
      })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (data && Array.isArray(data.workflow_runs)) {
            applyRuns(data.workflow_runs);
          }
        })
        .catch(() => {});
    }
  }
</script>

<style>
  .skills-list,
  .next-list {
    list-style: disc;
    margin: 0 0 0.75rem 1.25rem;
    padding: 0;
  }

  .skills-list li,
  .next-list li {
    margin-bottom: 0.4rem;
    padding-left: 0;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .container {
      padding: 4rem 2rem;
    }
  }

  .articles-preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .endorsement-form {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    margin: 1rem 0 0.5rem;
  }

  .endorsement-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--text-primary);
    background: transparent;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.6rem;
    box-shadow: none;
  }

  .endorsement-field input,
  .endorsement-field textarea {
    border-radius: var(--radius-md);
    padding: 0.6rem 0.75rem;
    font-family: inherit;
    font-size: var(--fs-md);
    color: var(--text-primary);
    background: var(--bg-app);
    box-shadow: none;
  }

  .endorsement-field textarea {
    resize: vertical;
    min-height: 84px;
  }

  .endorsement-success {
    margin-top: 0.75rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .endorsement-help {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .endorsement-explainer {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-top: -0.25rem;
  }

  .article-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: var(--shadow-sm);
  }

  .article-link:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .article-title {
    color: var(--text-primary);
    font-weight: 500;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .article-date {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .view-all-link {
    color: var(--accent-text);
    font-size: var(--fs-sm);
    text-decoration: none;
    margin-top: 0.5rem;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .github-actions-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
    margin-top: 0;
  }

  :global(.workflow-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  :global(.workflow-badge:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  :global(.workflow-badge__dot) {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--workflow-dot-bg);
    box-shadow: none;
    opacity: 0.75;
    flex: 0 0 auto;
  }

  :global(.workflow-badge__meta) {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
    text-align: left;
  }

  :global(.workflow-badge__name) {
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }

  :global(.workflow-badge__status) {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  :global(.workflow-badge[data-status='running'] .workflow-badge__dot) {
    background: var(--workflow-dot-running);
    opacity: 1;
    box-shadow: 0 0 0 3px var(--workflow-dot-running-glow);
    animation: workflowPulse 1.2s ease-in-out infinite;
  }

  :global(.workflow-badge[data-status='success'] .workflow-badge__dot) {
    background: var(--workflow-dot-success);
    border-radius: 3px;
    opacity: 1;
    box-shadow: none;
  }

  :global(.workflow-badge[data-status='failure'] .workflow-badge__dot) {
    background: var(--workflow-dot-failure-bg);
    opacity: 1;
    box-shadow: none;
    transform: rotate(45deg);
  }

  :global(.workflow-badge[data-status='failure'] .workflow-badge__dot)::after {
    content: '!';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: var(--workflow-dot-failure-text);
    transform: rotate(-45deg);
  }

  :global(.workflow-badge[data-status='unknown'] .workflow-badge__dot) {
    background: var(--workflow-dot-bg);
    opacity: 0.7;
  }

  .github-commits-container {
    margin-top: 2rem;
    font-size: var(--fs-sm);
    text-align: left;
  }

  .github-commits-container h2 {
    text-align: left;
  }

  .fallback-text {
    color: var(--text-muted);
  }

  :global(.commits-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
    text-align: left;
  }

  :global(.commits-list li) {
    display: flex;
    justify-content: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
    text-align: left;
  }

  :global(.commits-list a) {
    color: var(--text-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.commits-list a:hover) {
    color: var(--accent-text);
    text-decoration: underline;
  }

  :global(.commit-meta) {
    color: var(--text-muted);
    opacity: 0.7;
  }

  @keyframes workflowPulse {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.5;
    }
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.workflow-badge[data-status='running'] .workflow-badge__dot) {
      animation: none;
    }
  }
</style>
