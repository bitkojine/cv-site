---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Controls from '../components/Controls.astro';

import cvDataRaw from '../data/cv.json';
import { CVSchema } from '../data/schema';

// Validate data at build time
const cvData = CVSchema.parse(cvDataRaw);

const {
  personalInfo,
  coreSkills,
  experience,
  independentProjects,
  lookingFor,
} = cvData;

const now = new Date();
const datePart = now.toLocaleDateString('lt-LT', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Europe/Vilnius',
});
const timePart = now.toLocaleTimeString('lt-LT', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Vilnius',
  hour12: false,
  timeZoneName: 'short',
});
const lastUpdated = `${datePart}d. ${timePart}`;
---

<Layout
  title={`${personalInfo.name} - ${personalInfo.title}`}
  description={`Software engineer specializing in ${personalInfo.contact.stack}. ${personalInfo.profile.slice(0, 150)}...`}
>
  <Controls />

  <main class="container">
    <Header
      name={personalInfo.name}
      title={personalInfo.title}
      contact={personalInfo.contact}
    />

    <hr aria-hidden="true" />

    <Section title="PROFILE">
      {personalInfo.profile.split('\n\n').map((p) => <p>{p}</p>)}
    </Section>

    <Section title="CORE SKILLS">
      <ul class="skills-list">
        {
          coreSkills.map((skill) => (
            <li>
              <strong>{skill.label}:</strong> {skill.value}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="PROFESSIONAL EXPERIENCE">
      {experience.map((item) => <ExperienceItem {...item} />)}
    </Section>

    <Section title="INDEPENDENT PROJECT / STARTUP ATTEMPT">
      {independentProjects.map((item) => <ExperienceItem {...item} />)}
    </Section>

    <Section title="WHAT I'M LOOKING FOR NEXT">
      <ul class="next-list">
        {lookingFor.map((item) => <li>{item}</li>)}
      </ul>
    </Section>

    <footer class="last-updated">
      <p>
        Last updated: <time datetime={new Date().toISOString()}
          >{lastUpdated}</time
        >
      </p>
      <div
        id="github-actions-container"
        class="github-actions-container no-print"
      >
        <!-- Statuses will be injected here -->
      </div>

      <div
        id="github-commits-container"
        class="github-commits-container no-print"
      >
        <!-- Commits will be injected here -->
      </div>
    </footer>
  </main>
</Layout>

<script>
  // Fetch latest GitHub Action runs and display status for each workflow
  (async function fetchBuildStatus() {
    try {
      const response = await fetch(
        'https://api.github.com/repos/bitkojine/cv-site/actions/runs?per_page=30'
      );
      if (!response.ok) return;

      const data = await response.json();
      if (!data.workflow_runs || data.workflow_runs.length === 0) return;

      const container = document.getElementById('github-actions-container');
      if (!container) return;

      // Group by workflow_id, keeping only the first (latest) run
      const latestRuns = new Map();

      for (const run of data.workflow_runs) {
        if (!latestRuns.has(run.workflow_id)) {
          latestRuns.set(run.workflow_id, run);
        }
      }

      // Clear container
      container.innerHTML = '';

      // Create elements for each workflow
      latestRuns.forEach((run) => {
        const link = document.createElement('a');
        link.href = run.html_url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'workflow-status-link';
        link.setAttribute('aria-label', `View ${run.name} Status on GitHub`);

        const iconDiv = document.createElement('div');
        iconDiv.className = 'status-icon';

        let statusClass = '';
        if (run.status === 'in_progress' || run.status === 'queued') {
          statusClass = 'status-running';
        } else if (run.conclusion === 'success') {
          statusClass = 'status-success';
        } else if (run.conclusion === 'failure') {
          statusClass = 'status-failure';
        }
        if (statusClass) iconDiv.classList.add(statusClass);

        // Simple SVG icon
        iconDiv.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`;

        const textDiv = document.createElement('div');
        textDiv.className = 'status-text';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'workflow-name';
        nameSpan.textContent = run.name;

        const statusSpan = document.createElement('span');
        statusSpan.className = 'workflow-status';
        statusSpan.textContent =
          run.status === 'in_progress' || run.status === 'queued'
            ? 'Running'
            : run.conclusion || 'Unknown';

        textDiv.appendChild(nameSpan);
        textDiv.appendChild(statusSpan);

        link.appendChild(iconDiv);
        link.appendChild(textDiv);
        container.appendChild(link);
      });
    } catch (e) {
      console.error('Failed to fetch build status', e);
    }
  })();

  // Fetch latest commits
  (async function fetchCommits() {
    try {
      const response = await fetch(
        'https://api.github.com/repos/bitkojine/cv-site/commits?per_page=5'
      );
      if (!response.ok) return;

      const data = await response.json();
      if (!data || data.length === 0) return;

      const container = document.getElementById('github-commits-container');
      if (!container) return;

      container.innerHTML = '<h2>LATEST COMMITS</h2>';
      const list = document.createElement('ul');
      list.className = 'commits-list';

      interface GitHubCommit {
        html_url: string;
        commit: {
          message: string;
          author: {
            date: string;
          };
        };
      }

      data.forEach((commit: GitHubCommit) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = commit.html_url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';

        const msg = commit.commit.message.split('\n')[0]; // First line
        const commitDate = new Date(commit.commit.author.date);
        const datePart = commitDate.toLocaleDateString('lt-LT', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          timeZone: 'Europe/Vilnius',
        });
        const timePart = commitDate.toLocaleTimeString('lt-LT', {
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'Europe/Vilnius',
          hour12: false,
          timeZoneName: 'short',
        });
        const date = `${datePart}d. ${timePart}`;

        link.textContent = msg;

        const meta = document.createElement('span');
        meta.className = 'commit-meta';
        meta.textContent = ` (${date})`;

        li.appendChild(link);
        li.appendChild(meta);
        list.appendChild(li);
      });

      container.appendChild(list);
    } catch (e) {
      console.error('Failed to fetch commits', e);
    }
  })();
</script>

<style>
  .skills-list,
  .next-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skills-list li,
  .next-list li {
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .skills-list li::before,
  .next-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-600);
    font-weight: bold;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .container {
      padding: 4rem 2rem;
    }
  }

  .github-actions-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  :global(.workflow-status-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    font-size: 0.825rem;
    text-decoration: none;
    transition: all 0.2s;
    padding: 0.5rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  :global(.workflow-status-link:hover) {
    color: var(--text-primary);
    border-color: var(--accent-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  :global(.workflow-name) {
    font-weight: 600;
    font-size: 0.8rem;
  }

  :global(.workflow-status) {
    font-size: 0.7rem;
    opacity: 0.8;
    text-transform: capitalize;
  }

  :global(.status-text) {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    text-align: left;
  }

  .github-commits-container {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    text-align: left;
  }

  .github-commits-container h2 {
    /* Use global h2 styling - no overrides needed */
  }

  :global(.commits-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.commits-list li) {
    display: flex;
    justify-content: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
    text-align: left;
  }

  :global(.commits-list a) {
    color: var(--text-muted);
    text-decoration: none;
    font-family: monospace;
  }

  :global(.commits-list a:hover) {
    color: var(--accent-600);
    text-decoration: underline;
  }

  :global(.commit-meta) {
    color: var(--text-muted);
    opacity: 0.7;
  }

  :global(.status-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-app);
    color: var(--text-muted);
    transition: all 0.3s;
  }

  :global(.status-success) {
    color: #10b981; /* Green */
    background: #d1fae5;
  }

  :global(.dark-mode .status-success) {
    color: #34d399;
    background: #064e3b;
  }

  :global(.status-failure) {
    color: #ef4444; /* Red */
    background: #fee2e2;
  }

  :global(.dark-mode .status-failure) {
    color: #f87171;
    background: #7f1d1d;
  }

  :global(.status-running) {
    color: #f59e0b; /* Amber */
    background: #fef3c7;
    animation: pulse 2s infinite;
  }

  :global(.dark-mode .status-running) {
    color: #fbbf24;
    background: #78350f;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
    }
  }
</style>
