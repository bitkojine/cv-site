---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

import cvDataRaw from '../data/cv.json';
import { CVSchema } from '../data/schema';
import { getCollection } from 'astro:content';

// Validate data at build time
const cvData = CVSchema.parse(cvDataRaw);

const {
  personalInfo,
  coreSkills,
  experience,
  independentProjects,
  lookingFor,
} = cvData;

// Get latest blog posts (max 3)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const now = new Date();
const datePart = now.toLocaleDateString('lt-LT', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Europe/Vilnius',
});
const timePart = now.toLocaleTimeString('lt-LT', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Vilnius',
  hour12: false,
  timeZoneName: 'short',
});
const lastUpdated = `${datePart}d. ${timePart}`;

const githubOwner = 'bitkojine';
const githubRepo = 'cv-site';
const shouldFetchGithub = !import.meta.env.DEV;

interface WorkflowRun {
  workflow_id: number;
  name: string;
  html_url: string;
  status: 'completed' | 'in_progress' | 'queued';
  conclusion: string | null;
}

interface GitHubCommit {
  html_url: string;
  commit: {
    message: string;
    author: {
      date: string;
    };
  };
}

let latestWorkflowRuns: WorkflowRun[] = [];
let latestCommits: GitHubCommit[] = [];

if (shouldFetchGithub) {
  try {
    const runsResponse = await fetch(
      `https://api.github.com/repos/${githubOwner}/${githubRepo}/actions/runs?per_page=30`,
      {
        headers: { Accept: 'application/vnd.github+json' },
      }
    );
    if (runsResponse.ok) {
      const data = await runsResponse.json();
      if (data?.workflow_runs?.length) {
        const latestRuns = new Map<number, WorkflowRun>();
        for (const run of data.workflow_runs as WorkflowRun[]) {
          if (!latestRuns.has(run.workflow_id)) {
            latestRuns.set(run.workflow_id, run);
          }
        }
        latestWorkflowRuns = Array.from(latestRuns.values());
      }
    }
  } catch {
    // Fail silently and keep fallback links
  }

  try {
    const commitsResponse = await fetch(
      `https://api.github.com/repos/${githubOwner}/${githubRepo}/commits?per_page=5`,
      {
        headers: { Accept: 'application/vnd.github+json' },
      }
    );
    if (commitsResponse.ok) {
      const data = await commitsResponse.json();
      if (Array.isArray(data) && data.length) {
        latestCommits = data as GitHubCommit[];
      }
    }
  } catch {
    // Fail silently and keep fallback links
  }
}

const formatVilniusDateTime = (raw: string) => {
  const date = new Date(raw);
  const datePart = date.toLocaleDateString('lt-LT', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Europe/Vilnius',
  });
  const timePart = date.toLocaleTimeString('lt-LT', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Vilnius',
    hour12: false,
    timeZoneName: 'short',
  });
  return `${datePart}d. ${timePart}`;
};
---

<Layout
  title={`${personalInfo.name} - ${personalInfo.title}`}
  description={`Software engineer specializing in ${personalInfo.contact.stack}. ${personalInfo.profile.slice(0, 150)}...`}
>
  <main class="container">
    <Header
      name={personalInfo.name}
      title={personalInfo.title}
      contact={personalInfo.contact}
    />

    <Section title="PROFILE">
      {personalInfo.profile.split('\n\n').map((p) => <p>{p}</p>)}
    </Section>

    <Section title="CORE SKILLS">
      <ul class="skills-list">
        {
          coreSkills.map((skill) => (
            <li>
              <strong>{skill.label}:</strong> {skill.value}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="PROFESSIONAL EXPERIENCE">
      {experience.map((item) => <ExperienceItem {...item} />)}
    </Section>

    <Section title="INDEPENDENT PROJECT / STARTUP ATTEMPT">
      {independentProjects.map((item) => <ExperienceItem {...item} />)}
    </Section>

    <Section title="WHAT I'M LOOKING FOR NEXT">
      <ul class="next-list">
        {lookingFor.map((item) => <li>{item}</li>)}
      </ul>
    </Section>

    <Section title="ENDORSEMENTS">
      <p>
        If we worked together or you reviewed my work, a short public
        endorsement helps hiring teams move faster.
      </p>
      <p class="endorsement-explainer">
        Clicking "Post Endorsement" opens a prefilled GitHub issue draft in a
        new tab. You review it and click "Submit new issue" yourself—nothing is
        posted automatically.
      </p>
      <form
        id="endorsement-form"
        class="endorsement-form no-print"
        data-github-owner={githubOwner}
        data-github-repo={githubRepo}
      >
        <label class="endorsement-field">
          <span>Name</span>
          <input
            type="text"
            name="name"
            placeholder="Ada Lovelace"
            autocomplete="name"
            required
          />
        </label>
        <label class="endorsement-field">
          <span>Company / Role</span>
          <input
            type="text"
            name="company"
            placeholder="Acme Corp · Engineering Manager"
            required
          />
        </label>
        <label class="endorsement-field">
          <span>Endorsement (1–3 sentences)</span>
          <textarea
            name="note"
            rows="3"
            placeholder="Robertas shipped critical backend migrations with calm, clear communication."
            required></textarea>
        </label>
        <button type="submit" class="endorsement-submit">
          Post Endorsement on GitHub
        </button>
      </form>
      <p
        id="endorsement-success"
        class="endorsement-success"
        role="status"
        aria-live="polite"
      >
      </p>
      <p class="endorsement-help no-print">
        A draft issue opens in a new tab so you can review before posting.
      </p>
    </Section>

    {
      latestPosts.length > 0 && (
        <Section title="LATEST ARTICLES">
          <div class="articles-preview no-print">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="article-link">
                <span class="article-title">{post.data.title}</span>
                <span class="article-date">
                  {post.data.date.toLocaleDateString('lt-LT', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    timeZone: 'Europe/Vilnius',
                  })}
                </span>
              </a>
            ))}
            <a href="/blog" class="view-all-link">
              View all posts →
            </a>
          </div>
        </Section>
      )
    }

    <footer class="last-updated">
      <p>
        CV/Resume last updated: <time datetime={new Date().toISOString()}
          >{lastUpdated}</time
        >
      </p>
      <div
        id="github-actions-container"
        class="github-actions-container no-print"
      >
        {
          latestWorkflowRuns.length > 0 ? (
            latestWorkflowRuns.map((run) => {
              let statusClass = '';
              if (run.status === 'in_progress' || run.status === 'queued') {
                statusClass = 'status-running';
              } else if (run.conclusion === 'success') {
                statusClass = 'status-success';
              } else if (run.conclusion === 'failure') {
                statusClass = 'status-failure';
              }

              const statusLabel =
                run.status === 'in_progress' || run.status === 'queued'
                  ? 'Running'
                  : run.conclusion || 'Unknown';

              return (
                <a
                  href={run.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="workflow-status-link"
                  aria-label={`View ${run.name} Status on GitHub`}
                >
                  <div class={`status-icon ${statusClass}`}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  </div>
                  <div class="status-text">
                    <span class="workflow-name">{run.name}</span>
                    <span class="workflow-status">{statusLabel}</span>
                  </div>
                </a>
              );
            })
          ) : (
            <a
              href="https://github.com/bitkojine/cv-site/actions"
              target="_blank"
              rel="noopener noreferrer"
              class="workflow-status-link fallback-link"
            >
              <div class="status-icon">⚡</div>
              <div class="status-text">
                <span class="workflow-name">View Build Status</span>
                <span class="workflow-status">on GitHub</span>
              </div>
            </a>
          )
        }
      </div>

      <div
        id="github-commits-container"
        class="github-commits-container no-print"
      >
        <h2>LATEST COMMITS</h2>
        {
          latestCommits.length > 0 ? (
            <ul class="commits-list">
              {latestCommits.map((commit) => {
                const message = commit.commit.message.split('\n')[0];
                const date = formatVilniusDateTime(commit.commit.author.date);
                return (
                  <li>
                    <a
                      href={commit.html_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {message}
                    </a>
                    <span class="commit-meta"> ({date})</span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="fallback-text">
              <a
                href="https://github.com/bitkojine/cv-site/commits"
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub →
              </a>
            </p>
          )
        }
      </div>
    </footer>
  </main>
</Layout>

<script is:inline>
  const endorsementForm = document.getElementById('endorsement-form');
  const endorsementSuccess = document.getElementById('endorsement-success');

  if (endorsementForm) {
    let started = false;
    endorsementForm.addEventListener('focusin', () => {
      if (!started) {
        started = true;
        window.cvTrack?.('endorsement_started');
      }
    });

    endorsementForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(endorsementForm);
      const name = (formData.get('name') || '').toString().trim();
      const company = (formData.get('company') || '').toString().trim();
      const note = (formData.get('note') || '').toString().trim();

      if (!name || !company || !note) {
        return;
      }

      const owner = endorsementForm.dataset.githubOwner || 'bitkojine';
      const repo = endorsementForm.dataset.githubRepo || 'cv-site';
      const issueUrl = new URL(
        `https://github.com/${owner}/${repo}/issues/new`
      );
      issueUrl.searchParams.set(
        'title',
        `Endorsement from ${name} (${company})`
      );
      issueUrl.searchParams.set(
        'body',
        `**Endorser**: ${name}\n**Company/Role**: ${company}\n\n${note}\n\n---\nSubmitted via ${window.location.origin}`
      );
      issueUrl.searchParams.set('labels', 'endorsement');

      window.cvTrack?.('endorsement_submitted', { channel: 'github_issue' });
      window.open(issueUrl.toString(), '_blank', 'noopener,noreferrer');

      endorsementForm.reset();
      if (endorsementSuccess) {
        endorsementSuccess.textContent =
          'Thanks! A GitHub issue draft opened in a new tab.';
      }
    });
  }
</script>

<style>
  .skills-list,
  .next-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skills-list li,
  .next-list li {
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .skills-list li::before,
  .next-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-600);
    font-weight: bold;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .container {
      padding: 4rem 2rem;
    }
  }

  .articles-preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .endorsement-form {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    margin: 1rem 0 0.5rem;
  }

  .endorsement-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .endorsement-field input,
  .endorsement-field textarea {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.75rem;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-primary);
    background: var(--bg-app);
  }

  .endorsement-field textarea {
    resize: vertical;
    min-height: 84px;
  }

  .endorsement-submit {
    border: none;
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    font-weight: 600;
    background: var(--accent-600);
    color: #fff;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .endorsement-submit:hover {
    background: var(--accent-700);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .endorsement-success {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .endorsement-help {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .endorsement-explainer {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: -0.25rem;
  }

  .article-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s;
  }

  .article-link:hover {
    border-color: var(--accent-600);
    transform: translateX(4px);
  }

  .article-title {
    color: var(--text-primary);
    font-weight: 500;
  }

  .article-date {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .view-all-link {
    color: var(--accent-600);
    font-size: 0.875rem;
    text-decoration: none;
    margin-top: 0.5rem;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .github-actions-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  :global(.workflow-status-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    font-size: 0.825rem;
    text-decoration: none;
    transition: all 0.2s;
    padding: 0.5rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  :global(.workflow-status-link:hover) {
    color: var(--text-primary);
    border-color: var(--accent-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  :global(.workflow-name) {
    font-weight: 600;
    font-size: 0.8rem;
  }

  :global(.workflow-status) {
    font-size: 0.7rem;
    opacity: 0.8;
    text-transform: capitalize;
  }

  :global(.status-text) {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    text-align: left;
  }

  .github-commits-container {
    margin-top: 2rem;
    font-size: 0.8rem;
    text-align: left;
  }

  .github-commits-container h2 {
    text-align: left;
  }

  .fallback-text {
    color: var(--text-muted);
    font-style: italic;
  }

  :global(.commits-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
    text-align: left;
  }

  :global(.commits-list li) {
    display: flex;
    justify-content: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
    text-align: left;
  }

  :global(.commits-list a) {
    color: var(--text-muted);
    text-decoration: none;
    font-family: monospace;
  }

  :global(.commits-list a:hover) {
    color: var(--accent-600);
    text-decoration: underline;
  }

  :global(.commit-meta) {
    color: var(--text-muted);
    opacity: 0.7;
  }

  :global(.status-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-app);
    color: var(--text-muted);
    transition: all 0.3s;
  }

  :global(.status-success) {
    color: #10b981; /* Green */
    background: #d1fae5;
  }

  :global(.dark-mode .status-success) {
    color: #34d399;
    background: #064e3b;
  }

  :global(.status-failure) {
    color: #ef4444; /* Red */
    background: #fee2e2;
  }

  :global(.dark-mode .status-failure) {
    color: #f87171;
    background: #7f1d1d;
  }

  :global(.status-running) {
    color: #f59e0b; /* Amber */
    background: #fef3c7;
    animation: pulse 2s infinite;
  }

  :global(.dark-mode .status-running) {
    color: #fbbf24;
    background: #78350f;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.status-running) {
      animation: none;
    }
  }
</style>
