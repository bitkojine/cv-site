---
import SiteLayout from '../layouts/SiteLayout.astro';
import DoorSelection from '../components/DoorSelection.astro';

const schemaExtras = {
  about:
    'Role-based entry point for a personal site with dedicated hiring, builder, and vision routes.',
  potentialAction: {
    '@type': 'ChooseAction',
    target: ['/hiring', '/build', '/vision'],
  },
};
---

<SiteLayout
  title="Robertas Rudys | Choose Your Role"
  description="Select the role-based profile that matches your intent."
  canonicalPath="/"
  schemaType="WebPage"
  schemaExtras={schemaExtras}
>
  <DoorSelection />

  <section class="card brutal-ai-score" aria-labelledby="entry-ai-score">
    <details class="brutal-ai-details">
      <summary>
        <span id="entry-ai-score" class="brutal-ai-title">Brutal AI Score</span>
        <span class="brutal-ai-meta">Automated strict page audit</span>
        <strong>Overall (6.3 / 10)</strong>
      </summary>
      <ul>
        <li>Audience self-selection: 7.4/10</li>
        <li>Value proposition clarity: 6.0/10</li>
        <li>Role-path differentiation: 7.2/10</li>
        <li>Friction to first action: 7.6/10</li>
        <li>Trust/evidence before click: 4.0/10</li>
        <li>Conversion readiness: 5.5/10</li>
      </ul>
      <h3>Top 3 gaps</h3>
      <ul>
        <li>No proof artifacts are shown before route selection.</li>
        <li>
          Route promises are directional and mostly non-quantified at entry
          level.
        </li>
        <li>
          No hard qualification cues (price band, availability, traction
          snapshot) are visible pre-click.
        </li>
      </ul>
      <h3>Can this hold water?</h3>
      <p>
        This holds as a routing layer that quickly sorts visitors by intent. It
        is not sufficient for commitment decisions by itself because pre-click
        trust evidence is minimal.
      </p>
    </details>
  </section>
</SiteLayout>

<style>
  .brutal-ai-score {
    position: relative;
    overflow: clip;
    border: 1px solid #f3c2cd;
    background:
      radial-gradient(circle at 100% 0%, #ffe9ef 0%, transparent 42%),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--surface) 93%, #fff0f4),
        var(--surface) 58%
      );
  }

  .brutal-ai-score::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #fb7185, #e11d48 38%, #be123c 78%);
    opacity: 0.8;
  }

  .brutal-ai-score h2,
  .brutal-ai-score h3 {
    color: #9f1239;
  }

  .brutal-ai-title {
    color: #9f1239;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .brutal-ai-score strong {
    color: #be123c;
  }

  .brutal-ai-details {
    margin: 0;
  }

  .brutal-ai-details summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.12rem 0;
  }

  .brutal-ai-details summary::-webkit-details-marker {
    display: none;
  }

  .brutal-ai-details summary::before {
    content: '▾';
    color: #6d28d9;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    transition: transform 0.14s ease;
  }

  .brutal-ai-details:not([open]) summary::before {
    transform: rotate(-90deg);
  }

  .brutal-ai-details summary strong {
    margin-left: auto;
    white-space: nowrap;
    font-size: 0.95rem;
  }

  .brutal-ai-details > *:not(summary):first-of-type {
    margin-top: 0.45rem;
  }
</style>
