---
import { LibraryBig } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import SectionLastUpdated from '../components/SectionLastUpdated.astro';
import { hiringEvidenceData } from '../data/hiring-evidence.mts';

const themeOrder = [
  'reliability',
  'performance',
  'architecture',
  'delivery',
  'data',
  'quality',
];

const sectionedEvidence = [
  {
    id: 'case-studies',
    title: 'Case Studies',
    type: 'case-study',
    items: hiringEvidenceData.caseStudies,
  },
  {
    id: 'decision-records',
    title: 'Decision Records',
    type: 'decision',
    items: hiringEvidenceData.decisionRecords,
  },
  {
    id: 'production-patterns',
    title: 'Production Patterns',
    type: 'pattern',
    items: hiringEvidenceData.productionPatterns,
  },
] as const;

const schemaExtras = {
  about:
    'Practical backend learning library with case studies, decision records, and production patterns.',
};

const toTitleCase = (value: string) =>
  value.charAt(0).toUpperCase() + value.slice(1);

const sectionLearningNotes = {
  'case-study':
    'Read end-to-end examples and focus on why decisions were made.',
  decision: 'Use these short records to compare options and tradeoffs quickly.',
  pattern:
    'Treat these as reusable production patterns you can apply in your own systems.',
} as const;
---

<SiteLayout
  canonicalPath="/library"
  description="Engineering learning library: practical case studies, decision records, and production patterns."
  ogType="profile"
  roleLabel="Learning Library"
  schemaExtras={schemaExtras}
  schemaType="CollectionPage"
  title="Robertas Rudys | Engineering Learning Library"
>
  <ModeSwitch currentRole="Recruiter / Hiring Manager" />
  <ReadingProgress targetSelector="#evidence-library-content" />

  <section aria-labelledby="evidence-heading" class="mode-hero">
    <div class="headline-row">
      <span aria-hidden="true" class="headline-icon"
        ><LibraryBig size={86} /></span
      >
      <h1 id="evidence-heading">Engineering Learning Library</h1>
    </div>
    <p class="cta-note">
      This is a learning library. Use it to study real backend decisions,
      tradeoffs, and production patterns you can reuse.
    </p>
    <p class="cta-note">
      Topics include C#, TypeScript, AI coding agents, GitHub CI/CD, Docker,
      reliability, data, and delivery.
    </p>
  </section>

  <nav aria-label="Evidence sections" class="in-page-nav">
    <p class="in-page-nav__label">Jump to</p>
    <ul>
      <li><a href="#evidence-controls">Search</a></li>
      <li><a href="#case-studies">Case studies</a></li>
      <li><a href="#decision-records">Decision records</a></li>
      <li><a href="#production-patterns">Patterns</a></li>
    </ul>
  </nav>

  <div id="evidence-library-content">
    <section aria-labelledby="evidence-controls" class="card">
      <h2 id="evidence-controls">Search And Filters</h2>
      <SectionLastUpdated />
      <p>
        Pick one topic, open one item, and focus on the decision and tradeoffs.
      </p>
      <div class="evidence-controls-grid">
        <label class="control-group" for="evidence-search">
          <span>Search evidence</span>
          <input
            autocomplete="off"
            id="evidence-search"
            name="evidence-search"
            placeholder="Search by situation, tradeoff, outcome, or learning"
            type="search"
          />
        </label>
        <label class="control-group" for="stack-match">
          <span>Match my stack (optional)</span>
          <select id="stack-match" name="stack-match">
            <option value="">All contexts</option>
            {
              hiringEvidenceData.stackMatchOptions.map((option) => (
                <option value={option}>{option}</option>
              ))
            }
          </select>
        </label>
      </div>
      <div aria-label="Theme filters" class="theme-filter-row">
        {
          themeOrder.map((theme) => (
            <button
              class="theme-filter"
              data-theme-filter={theme}
              type="button"
            >
              {toTitleCase(theme)}
            </button>
          ))
        }
      </div>
      <div class="filter-actions">
        <button
          class="cta-secondary filter-reset"
          data-filter-reset
          type="button"
        >
          Reset Filters
        </button>
      </div>
      <p class="result-count" data-evidence-result-count>
        Showing all evidence items.
      </p>
      <div class="empty-state" data-evidence-empty hidden>
        <p>No evidence matched this filter combination.</p>
        <div class="empty-state__actions">
          <button data-empty-suggest="reliability|delivery" type="button">
            Try Reliability + Delivery
          </button>
          <button data-empty-reset type="button">Clear all filters</button>
        </div>
      </div>
    </section>

    {
      sectionedEvidence.map((section) => (
        <section
          aria-labelledby={section.id}
          class="card evidence-section"
          data-evidence-section
        >
          <h2 id={section.id}>{section.title}</h2>
          <SectionLastUpdated />
          <p>{sectionLearningNotes[section.type]}</p>
          <div class="evidence-grid">
            {section.items.map((item) => (
              <article
                class="evidence-item"
                data-evidence-item
                data-evidence-id={item.id}
                data-evidence-type={section.type}
                data-search={`${item.title} ${item.context} ${item.situation} ${item.decision} ${item.outcome} ${item.learnings.join(' ')}`.toLowerCase()}
                data-stack={item.stackHints.join('|').toLowerCase()}
                data-themes={item.themes.join('|')}
                id={`evidence-${item.id}`}
              >
                <header>
                  <h3>{item.title}</h3>
                  <p class="evidence-tags">
                    {item.themes.map((theme) => toTitleCase(theme)).join(' · ')}
                  </p>
                </header>
                <p>{item.context}</p>
                <div class="evidence-details-body">
                  <p>
                    <strong>Situation:</strong> {item.situation}
                  </p>
                  <p>
                    <strong>Constraints:</strong> {item.constraints.join('; ')}
                  </p>
                  <p>
                    <strong>Options:</strong> {item.options.join('; ')}
                  </p>
                  <p>
                    <strong>Decision:</strong> {item.decision}
                  </p>
                  <p>
                    <strong>Tradeoffs:</strong> {item.tradeoffs.join('; ')}
                  </p>
                  <p>
                    <strong>Outcome:</strong> {item.outcome}
                  </p>
                  <p>
                    <strong>Learnings:</strong> {item.learnings.join('; ')}
                  </p>
                  {item.discussionPrompts && (
                    <p>
                      <strong>Discussion prompts:</strong>
                      {item.discussionPrompts.join('; ')}
                    </p>
                  )}
                  {item.evaluationSignals && (
                    <p>
                      <strong>What strong answers include:</strong>
                      {item.evaluationSignals.join('; ')}
                    </p>
                  )}
                  {item.antiPatterns && (
                    <p>
                      <strong>Anti-patterns to watch for:</strong>
                      {item.antiPatterns.join('; ')}
                    </p>
                  )}
                  {item.snippet && (
                    <pre class="pattern-snippet">
                      <code>{item.snippet}</code>
                    </pre>
                  )}
                </div>
                <div class="evidence-actions">
                  <button
                    class="cta-secondary"
                    data-copy-summary
                    data-summary-title={item.title}
                    data-summary-context={item.context}
                    data-summary-decision={item.decision}
                    data-summary-tradeoffs={item.tradeoffs.join('; ')}
                    data-summary-outcome={item.outcome}
                    data-summary-link={`/library#evidence-${item.id}`}
                    type="button"
                  >
                    Copy Summary
                  </button>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</SiteLayout>

<style>
  .evidence-controls-grid {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.75rem;
  }

  .control-group {
    display: grid;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .control-group input,
  .control-group select {
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
  }

  .theme-filter-row {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .theme-filter {
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.78rem;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
  }

  .theme-filter[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--accent) 45%, white);
    background: color-mix(in oklab, var(--accent-soft) 62%, white);
    color: var(--accent);
  }

  .filter-actions {
    margin-top: 0.6rem;
  }

  .filter-reset {
    width: 100%;
  }

  .result-count,
  .empty-state {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .empty-state {
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 0.7rem;
    background: color-mix(in oklab, var(--surface-muted) 86%, white);
  }

  .empty-state p {
    margin: 0;
  }

  .empty-state__actions {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .empty-state__actions button {
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .evidence-grid {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.75rem;
  }

  .evidence-item {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.7rem;
    background: var(--surface);
  }

  .evidence-item h3 {
    margin: 0;
    font-size: 1rem;
  }

  .evidence-tags {
    margin-top: 0.3rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .evidence-item > p {
    margin: 0.55rem 0 0;
  }

  .evidence-details-body {
    margin-top: 0.45rem;
    display: grid;
    gap: 0.45rem;
  }

  .evidence-details-body p {
    margin: 0;
  }

  .evidence-actions {
    margin-top: 0.65rem;
  }

  .evidence-actions .cta-secondary {
    width: 100%;
    cursor: pointer;
  }

  .pattern-snippet {
    margin: 0;
    background: color-mix(in oklab, var(--surface-muted) 80%, white);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.55rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.84rem;
  }

  @media (min-width: 900px) {
    .evidence-controls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evidence-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filter-reset {
      width: auto;
    }

    .evidence-actions .cta-secondary {
      width: auto;
    }
  }
</style>

<script>
  import { showToast } from '../lib/ui-feedback.mts';

  (() => {
    const reportEvent = (eventName, props = {}) => {
      const sendEvent = window.cvReportEvent ?? window.cvTrack;
      if (typeof sendEvent === 'function') {
        sendEvent(eventName, props);
      }
    };

    const normalize = (value) => value.trim().toLowerCase();

    const initEvidenceFiltering = () => {
      const searchInput = document.querySelector('#evidence-search');
      const stackSelect = document.querySelector('#stack-match');
      const themeButtons = Array.from(
        document.querySelectorAll('[data-theme-filter]')
      );
      const evidenceItems = Array.from(
        document.querySelectorAll('[data-evidence-item]')
      );
      const evidenceSections = Array.from(
        document.querySelectorAll('[data-evidence-section]')
      );
      const resultNode = document.querySelector('[data-evidence-result-count]');
      const emptyNode = document.querySelector('[data-evidence-empty]');
      const resetButton = document.querySelector('[data-filter-reset]');

      if (
        !(searchInput instanceof HTMLInputElement) ||
        !(stackSelect instanceof HTMLSelectElement) ||
        !resultNode ||
        !emptyNode
      ) {
        return;
      }

      const activeThemes = new Set();
      let searchTimer;
      let lastAnalyticsSignature = '';

      const setThemeState = (theme, isActive) => {
        const button = themeButtons.find(
          (candidate) =>
            candidate instanceof HTMLButtonElement &&
            candidate.dataset.themeFilter === theme
        );
        if (!(button instanceof HTMLButtonElement)) return;
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      };

      const clearAllFilters = (showFeedback = false) => {
        searchInput.value = '';
        stackSelect.value = '';
        activeThemes.clear();
        themeButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.setAttribute('aria-pressed', 'false');
        });
        applyFilters();
        if (showFeedback) {
          showToast(
            document,
            'Filters reset. Showing all evidence.',
            'success'
          );
        }
      };

      const applyFilters = () => {
        const query = normalize(searchInput.value);
        const selectedStack = normalize(stackSelect.value);
        let visibleCount = 0;

        evidenceItems.forEach((itemNode) => {
          if (!(itemNode instanceof HTMLElement)) return;
          const haystack = itemNode.dataset.search || '';
          const itemThemes = (itemNode.dataset.themes || '').split('|');
          const itemStacks = (itemNode.dataset.stack || '').split('|');
          const queryMatch = !query || haystack.includes(query);
          const themeMatch =
            activeThemes.size === 0 ||
            Array.from(activeThemes).every((theme) =>
              itemThemes.includes(theme)
            );
          const stackMatch =
            !selectedStack || itemStacks.includes(selectedStack);
          const isVisible = queryMatch && themeMatch && stackMatch;

          itemNode.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        });

        evidenceSections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;
          const hasVisibleItems = Array.from(
            section.querySelectorAll('[data-evidence-item]')
          ).some((node) => !node.hidden);
          section.hidden = !hasVisibleItems;
        });

        if (visibleCount === evidenceItems.length) {
          resultNode.textContent = 'Showing all evidence items.';
        } else {
          resultNode.textContent = `Showing ${visibleCount} matching evidence item${visibleCount === 1 ? '' : 's'}.`;
        }

        emptyNode.hidden = visibleCount !== 0;

        const analyticsSignature = `${query}|${selectedStack}|${Array.from(activeThemes).sort().join(',')}|${visibleCount}`;
        if (analyticsSignature !== lastAnalyticsSignature) {
          lastAnalyticsSignature = analyticsSignature;
          reportEvent('evidence_search', {
            source: 'hiring_evidence_library',
            query_length: query.length,
            result_count: visibleCount,
            selected_stack: selectedStack || 'all',
            active_themes: Array.from(activeThemes),
          });
        }
      };

      searchInput.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(applyFilters, 250);
      });

      stackSelect.addEventListener('change', applyFilters);

      themeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.setAttribute('aria-pressed', 'false');
        button.addEventListener('click', () => {
          const theme = button.dataset.themeFilter || '';
          if (!theme) return;
          if (activeThemes.has(theme)) {
            activeThemes.delete(theme);
            button.setAttribute('aria-pressed', 'false');
          } else {
            activeThemes.add(theme);
            button.setAttribute('aria-pressed', 'true');
          }
          applyFilters();
        });
      });

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener('click', () => {
          clearAllFilters(true);
          reportEvent('evidence_filter_reset', {
            source: 'hiring_evidence_library',
          });
        });
      }

      document.querySelectorAll('[data-empty-suggest]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          clearAllFilters(false);
          const raw = button.dataset.emptySuggest || '';
          raw
            .split('|')
            .map((entry) => normalize(entry))
            .filter(Boolean)
            .forEach((theme) => {
              activeThemes.add(theme);
              setThemeState(theme, true);
            });
          applyFilters();
          showToast(document, 'Applied suggested filters.', 'success');
          reportEvent('evidence_filter_suggestion', {
            source: 'hiring_evidence_library',
            themes: raw,
          });
        });
      });

      document.querySelectorAll('[data-empty-reset]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => clearAllFilters(true));
      });

      applyFilters();
    };

    const initCopySummary = () => {
      document.querySelectorAll('[data-copy-summary]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.boundCopySummary === '1') return;
        button.dataset.boundCopySummary = '1';

        button.addEventListener('click', async () => {
          const title = button.dataset.summaryTitle || 'Evidence item';
          const context = button.dataset.summaryContext || '';
          const decision = button.dataset.summaryDecision || '';
          const tradeoffs = button.dataset.summaryTradeoffs || '';
          const outcome = button.dataset.summaryOutcome || '';
          const link = button.dataset.summaryLink || '/library';

          const text = [
            `${title}`,
            '',
            `Context: ${context}`,
            `Decision: ${decision}`,
            `Tradeoffs: ${tradeoffs}`,
            `Outcome: ${outcome}`,
            `Source: ${new URL(link, window.location.origin).toString()}`,
          ].join('\n');

          try {
            await navigator.clipboard.writeText(text);
            showToast(document, 'Summary copied for sharing.', 'success');
            reportEvent('evidence_summary_copied', {
              source: 'hiring_evidence_library',
              evidence_title: title,
            });
          } catch {
            showToast(document, 'Copy failed. Please try again.', 'warning');
          }
        });
      });
    };

    const initEvidenceOpened = () => {
      document.querySelectorAll('[data-evidence-item]').forEach((itemNode) => {
        if (!(itemNode instanceof HTMLElement)) return;
        if (itemNode.dataset.boundEvidenceOpened === '1') return;
        itemNode.dataset.boundEvidenceOpened = '1';
        itemNode.addEventListener(
          'click',
          () => {
            if (itemNode.dataset.evidenceOpenedSent === '1') return;
            itemNode.dataset.evidenceOpenedSent = '1';
            reportEvent('evidence_opened', {
              source: 'hiring_evidence_library',
              evidence_id: itemNode.dataset.evidenceId || 'unknown',
              evidence_type: itemNode.dataset.evidenceType || 'unknown',
            });
          },
          { once: true }
        );
      });
    };

    const init = () => {
      initEvidenceFiltering();
      initCopySummary();
      initEvidenceOpened();
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
