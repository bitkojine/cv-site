---
import SiteLayout from '../layouts/SiteLayout.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import DevContent from '../components/content/DevContent.astro';

const schemaExtras = {
  about:
    'Open source projects, architecture patterns, and technical methodology for developers and builders.',
  mainEntity: {
    '@type': 'CreativeWork',
    name: 'Open Source and Engineering Methodology',
    creator: {
      '@type': 'Person',
      name: 'Robertas Rudys',
    },
  },
};
---

<SiteLayout
  canonicalPath="/dev"
  description="Open source projects, architecture patterns, and technical methodology."
  roleLabel="Visitor: Developer / Builder"
  schemaExtras={schemaExtras}
  schemaType="CollectionPage"
  title="Robertas Rudys | Developer / Builder"
>
  <ModeSwitch currentRole="Developer / Builder" />
  <DevContent />
</SiteLayout>
