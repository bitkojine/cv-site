---
import SiteLayout from '../layouts/SiteLayout.astro';
import TemplateNotice from '../components/TemplateNotice.astro';
import { FolderSearch } from '@lucide/astro';

const schemaExtras = {
  about:
    'Centralized evidence registry for CV and resume outcome claims used across profile pages.',
};
---

<SiteLayout
  title="Robertas Rudys | Evidence Registry"
  description="Central proof page for CV and resume metrics and references."
  canonicalPath="/evidence"
  schemaType="CollectionPage"
  schemaExtras={schemaExtras}
>
  <TemplateNotice id="evidence-template-heading">
    <p>
      This Evidence Registry is currently populated with illustrative example
      figures while the website system is being built out.
    </p>
    <p>
      With real data, this page keeps the same structure: each highlighted claim
      on the CV/Resume maps to a specific evidence record with clear baseline,
      result, timeframe, and operating context.
    </p>
    <p>
      Goal: make every material metric traceable so recruiters and hiring
      managers can validate claims quickly.
    </p>
  </TemplateNotice>

  <section class="mode-hero" aria-labelledby="evidence-heading">
    <div class="headline-row">
      <span class="headline-icon" aria-hidden="true"
        ><FolderSearch size={86} /></span
      >
      <h1 id="evidence-heading">Evidence Registry</h1>
    </div>
    <div class="cta-row">
      <a class="cta-primary" href="/hiring">Back to Candidate CV/Resume</a>
    </div>
    <p class="cta-note">
      Central source for demo references used in the hiring CV/resume page.
      Every highlighted material result maps to a matching section below.
    </p>
  </section>

  <section class="card" id="snapshot" aria-labelledby="snapshot-heading">
    <h2 id="snapshot-heading">Snapshot Metrics</h2>
    <ul>
      <li>Lead-Time Dashboard (Release Cycles, baseline vs. current)</li>
      <li>Incident and Hotfix Trends (quarter-over-quarter)</li>
      <li>Roadmap On-Time Delivery Review (quarterly planning cadence)</li>
    </ul>
  </section>

  <section class="card" id="reliability" aria-labelledby="reliability-heading">
    <h2 id="reliability-heading">Reliability KPI Track Record</h2>
    <ul>
      <li>SLO Availability Reports (pre/post release hardening)</li>
      <li>Change-Failure Rate by Release (baseline vs. current)</li>
      <li>Outage Minutes and Downtime Logs (two release trains)</li>
    </ul>
  </section>

  <section class="card" id="product-company" aria-labelledby="pc-heading">
    <h2 id="pc-heading">Product Company (EU, Remote)</h2>

    <h3 id="product-company-lead-time">Lead Time and Early Delivery</h3>
    <ul>
      <li>Jira Lead-Time Dashboard (Q1-Q2 2026)</li>
      <li>Lead-Time Baseline vs Current (13 days -&gt; 9 days)</li>
      <li>Roadmap Release Calendar (4 days earlier delivery)</li>
    </ul>

    <h3 id="product-company-reliability">Incident and Hotfix Reduction</h3>
    <ul>
      <li>Opsgenie Incident Summary (Q2 2026)</li>
      <li>Incident Severity Trend (Sev-2/3 -34% QoQ)</li>
      <li>Hotfix Volume Trend (-29% QoQ)</li>
    </ul>

    <h3 id="product-company-roadmap">Roadmap Delivery Predictability</h3>
    <ul>
      <li>Quarterly Roadmap Delivery Review (H1 2026)</li>
      <li>Delivery SLA Attainment (68% -&gt; 88%)</li>
      <li>Spillover and Forecast Accuracy Log</li>
    </ul>
  </section>

  <section class="card" id="adform" aria-labelledby="adform-heading">
    <h2 id="adform-heading">Adform Lithuania</h2>

    <h3 id="adform-availability">Availability</h3>
    <ul>
      <li>SLO Availability Report (Peak Campaign Windows)</li>
      <li>Availability Baseline vs Current (99.90% -&gt; 99.95%)</li>
      <li>Peak Traffic Revenue Path Monitoring</li>
    </ul>

    <h3 id="adform-change-failure">Change-Failure Rate</h3>
    <ul>
      <li>Release Change-Failure Dashboard (2025)</li>
      <li>Change-Failure Baseline vs Current (12% -&gt; 7%)</li>
      <li>Rollback and Customer Impact Log</li>
    </ul>

    <h3 id="adform-regressions">Regression and Capacity Recovery</h3>
    <ul>
      <li>QA Regression Reopen Tracker (Q3 2025)</li>
      <li>Regression Reopen Reduction (37% over one quarter)</li>
      <li>Recovered Engineering Capacity (~11 hours per sprint)</li>
    </ul>
  </section>

  <section class="card" id="ignitis" aria-labelledby="ignitis-heading">
    <h2 id="ignitis-heading">Ignitis Group Services Center</h2>

    <h3 id="ignitis-outage">Critical Outage Reduction</h3>
    <ul>
      <li>Outage Minutes Trend (Internal Services, 2023)</li>
      <li>Critical Outage Reduction (46% QoQ)</li>
      <li>Business Workflow Impact Report</li>
    </ul>

    <h3 id="ignitis-downtime">Unplanned Downtime Control</h3>
    <ul>
      <li>Release Train Stability Log (Train A + Train B)</li>
      <li>Unplanned Downtime Report (0 minutes)</li>
      <li>Change Window Business Continuity Notes</li>
    </ul>

    <h3 id="ignitis-effort">Engineering Effort Reduction</h3>
    <ul>
      <li>Engineering Effort Benchmark (Q2-Q4 2023)</li>
      <li>Implementation Effort Reduction (23% over two quarters)</li>
      <li>Capacity Allocation Without Headcount Increase</li>
    </ul>
  </section>

  <section class="card" id="super-how" aria-labelledby="super-how-heading">
    <h2 id="super-how-heading">Super How</h2>

    <h3 id="super-how-predictability">Sprint Predictability</h3>
    <ul>
      <li>Sprint Commitment Accuracy Board (2022)</li>
      <li>Sprint Predictability Baseline vs Current (62% -&gt; 84%)</li>
      <li>Launch Planning Variance Log</li>
    </ul>

    <h3 id="super-how-go-live">Go-Live Acceleration</h3>
    <ul>
      <li>Integration Go-Live Timeline Comparison</li>
      <li>Go-Live Acceleration (4 weeks per integration cycle)</li>
      <li>Account Activation Timing Report</li>
    </ul>

    <h3 id="super-how-scope">Scope Churn Reduction</h3>
    <ul>
      <li>Scope Churn Report (Quarterly)</li>
      <li>Scope Churn Reduction (28% QoQ)</li>
      <li>Rework Hours and Sprint Commitment Tracker</li>
    </ul>
  </section>

  <section class="card" id="euromonitor" aria-labelledby="euromonitor-heading">
    <h2 id="euromonitor-heading">Euromonitor International</h2>

    <h3 id="euromonitor-pipeline">Pipeline Reliability</h3>
    <ul>
      <li>Report Pipeline Failure Trends (2019-2020)</li>
      <li>Report Failure Reduction (41% over two quarters)</li>
      <li>Analyst Delay and Support Ticket Correlation</li>
    </ul>

    <h3 id="euromonitor-throughput">Release Throughput</h3>
    <ul>
      <li>Release Throughput Dashboard (Team Metrics)</li>
      <li>Throughput Uplift (22% per quarter)</li>
      <li>Feature Output and Integration Boundary Notes</li>
    </ul>

    <h3 id="euromonitor-stability">System Stability</h3>
    <ul>
      <li>Global Ticket Interruption Summary (YoY)</li>
      <li>Uptime Report (&gt;99.9%)</li>
      <li>Business Interruption Ticket Reduction (33% YoY)</li>
    </ul>
  </section>

  <section class="card" id="invenis" aria-labelledby="invenis-heading">
    <h2 id="invenis-heading">Invenis</h2>

    <h3 id="invenis-milestones">Milestone Delivery</h3>
    <ul>
      <li>Contract Milestone Acceptance Records (2015)</li>
      <li>Milestone Delivery Completion (100% on schedule)</li>
      <li>Fixed-Scope Revenue Realization Notes</li>
    </ul>

    <h3 id="invenis-defects">Defect Backlog Reduction</h3>
    <ul>
      <li>Post-Release Defect Backlog Trend</li>
      <li>Defect Backlog Reduction (26% by release-cycle close)</li>
      <li>Client UAT Sign-Off Notes</li>
    </ul>
  </section>

  <section class="card brutal-ai-score" aria-labelledby="evidence-ai-score">
    <details class="brutal-ai-details">
      <summary>
        <span id="evidence-ai-score" class="brutal-ai-title"
          >Brutal AI Score</span
        >
        <span class="brutal-ai-meta">Automated strict page audit</span>
        <strong>Overall (6.1 / 10)</strong>
      </summary>
      <ul>
        <li>Claim-to-reference mapping: 8.0/10</li>
        <li>Evidence structure consistency: 7.6/10</li>
        <li>Cross-page traceability: 7.2/10</li>
        <li>Evidence depth realism: 4.3/10</li>
        <li>Decision-readiness for hiring: 5.5/10</li>
        <li>Auditability under verification: 4.1/10</li>
      </ul>
      <h3>Top 3 gaps</h3>
      <ul>
        <li>
          Evidence remains illustrative and not yet backed by real artifacts.
        </li>
        <li>
          No signed-off source bundle proving each metric outside demo context.
        </li>
        <li>
          Registry quality is strong structurally, but still pre-verification.
        </li>
      </ul>
      <h3>Can this hold water?</h3>
      <p>
        Strong as a reference architecture for claim traceability. It is not a
        substitute for verified production evidence in a real hiring decision.
      </p>
    </details>
  </section>

  <style>
    .card[id],
    h3[id] {
      scroll-margin-top: 0.9rem;
    }

    .card[id]:target {
      position: relative;
      border-color: #7ca9f4;
      background:
        radial-gradient(circle at 100% 0%, #eef5ff 0%, transparent 42%),
        linear-gradient(
          165deg,
          color-mix(in oklab, var(--surface) 90%, #e8f2ff),
          var(--surface) 62%
        );
      outline: 3px solid color-mix(in oklab, #9fc4ff 34%, transparent);
    }

    h3[id]:target {
      display: inline-block;
      margin-top: 0.25rem;
      padding: 0.12rem 0.48rem 0.18rem;
      border-radius: 0.45rem;
      background: color-mix(in oklab, #c9e2ff 70%, #edf5ff);
      border: 1px solid color-mix(in oklab, #90b9ff 38%, transparent);
      color: color-mix(in oklab, var(--text) 88%, #174ea0);
      outline: 2px solid color-mix(in oklab, #9fc4ff 30%, transparent);
    }

    h3[id]:target + ul {
      margin-top: 0.45rem;
      padding: 0.62rem 0.78rem 0.7rem 1.2rem;
      border-radius: 0.55rem;
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--surface) 89%, #edf5ff),
        color-mix(in oklab, var(--surface) 94%, #f5f9ff)
      );
      border: 1px solid color-mix(in oklab, var(--line) 72%, #9ebef3);
    }

    .brutal-ai-score {
      position: relative;
      overflow: clip;
      border: 1px solid #f3c2cd;
      background:
        radial-gradient(circle at 100% 0%, #ffe9ef 0%, transparent 42%),
        linear-gradient(
          168deg,
          color-mix(in oklab, var(--surface) 93%, #fff0f4),
          var(--surface) 58%
        );
    }

    .brutal-ai-score::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #fb7185, #e11d48 38%, #be123c 78%);
      opacity: 0.8;
    }

    .brutal-ai-score h2,
    .brutal-ai-score h3 {
      color: #9f1239;
    }

    .brutal-ai-title {
      color: #9f1239;
      font-size: 1.1rem;
      font-weight: 700;
    }

    .brutal-ai-score strong {
      color: #be123c;
    }

    .brutal-ai-details {
      margin: 0;
    }

    .brutal-ai-details summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0.12rem 0;
    }

    .brutal-ai-details summary::-webkit-details-marker {
      display: none;
    }

    .brutal-ai-details summary::before {
      content: '▾';
      color: #6d28d9;
      font-weight: 700;
      font-size: 0.95rem;
      line-height: 1;
      transition: transform 0.14s ease;
    }

    .brutal-ai-details:not([open]) summary::before {
      transform: rotate(-90deg);
    }

    .brutal-ai-details summary strong {
      margin-left: auto;
      white-space: nowrap;
      font-size: 0.95rem;
    }

    .brutal-ai-details > *:not(summary):first-of-type {
      margin-top: 0.45rem;
    }
  </style>
</SiteLayout>
