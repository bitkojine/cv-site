---
interface Props {
	name: string;
	title: string;
	contact: {
		email: string;
		location: string;
		remote: string;
		stack: string;
	};
}

const { name, title, contact } = Astro.props;
---

<header class="cv-header">
	<h1>{name}</h1>
	<p class="role-title">{title}</p>
	<div class="contact-grid">
		<div class="contact-item">
			<span class="icon">📧</span>
			<a href={`mailto:${contact.email}`}>{contact.email}</a>
		</div>
		<div class="contact-item">
			<span class="icon">📍</span>
			<span>{contact.location}</span>
		</div>
		<div class="contact-item">
			<span class="icon">🌍</span>
			<span>{contact.remote}</span>
		</div>
		<div class="contact-item">
			<span class="icon">💻</span>
			<span>{contact.stack}</span>
		</div>
	</div>
</header>

<style>
	.role-title {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--accent-600);
		margin-bottom: 1.5rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
		font-size: 0.875rem;
	}

	.contact-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-secondary);
	}

	.icon {
		opacity: 0.8;
	}

	@media (min-width: 768px) {
		.contact-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem 1.5rem;
		}
	}
</style>
