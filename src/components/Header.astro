---
import { Mail, MapPin, Globe, Monitor } from '@lucide/astro';

interface Props {
  name: string;
  title: string;
  contact: {
    email: string;
    location: string;
    remote: string;
    stack: string;
  };
}

const { name, title, contact } = Astro.props;
---

<header class="cv-header">
  <h1>{name}<span class="domain-suffix">.com</span></h1>
  <p class="role-title">{title}</p>
  <div class="contact-grid">
    <div class="contact-item">
      <Mail size={18} class="icon" aria-hidden="true" />
      <a href={`mailto:${contact.email}`} aria-label={`Email: ${contact.email}`}
        >{contact.email}</a
      >
    </div>
    <div class="contact-item">
      <MapPin size={18} class="icon" aria-hidden="true" />
      <span>{contact.location}</span>
    </div>
    <div class="contact-item">
      <Globe size={18} class="icon" aria-hidden="true" />
      <span>{contact.remote}</span>
    </div>
    <div class="contact-item">
      <Monitor size={18} class="icon" aria-hidden="true" />
      <span>{contact.stack}</span>
    </div>
  </div>
</header>

<style>
  .cv-header {
    margin-bottom: 2rem;
  }

  .cv-header h1 {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    max-width: 100%;
    font-size: clamp(1.6rem, 6vw, var(--fs-2xl));
  }

  .role-title {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 1.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    font-size: var(--fs-sm);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-secondary);
    min-width: 0;
  }

  .contact-item a,
  .contact-item span {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .icon {
    color: var(--accent-text);
    opacity: 0.8;
  }

  .domain-suffix {
    color: var(--accent-text);
    font-weight: 400;
    opacity: 0.8;
    margin-left: 0.25em;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem 2rem;
    }
  }
</style>
