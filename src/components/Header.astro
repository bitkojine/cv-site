---
interface Props {
  name: string;
  title: string;
  contact: {
    email: string;
    location: string;
    remote: string;
    stack: string;
  };
}

const { name, title, contact } = Astro.props;
---

<header class="cv-header">
  <h1>{name}</h1>
  <p class="role-title">{title}</p>
  <div class="contact-grid">
    <div class="contact-item">
      <span class="contact-label">Email:</span>
      <a href={`mailto:${contact.email}`} aria-label={`Email: ${contact.email}`}>
        {contact.email}
      </a>
    </div>
    <div class="contact-item">
      <span class="contact-label">Location:</span>
      <span>{contact.location}</span>
    </div>
    <div class="contact-item">
      <span class="contact-label">Remote:</span>
      <span>{contact.remote}</span>
    </div>
    <div class="contact-item">
      <span class="contact-label">Stack:</span>
      <span>{contact.stack}</span>
    </div>
  </div>
</header>

<style>
  .cv-header {
    margin-bottom: 1.75rem;
  }

  .cv-header h1 {
    font-size: var(--fs-2xl);
  }

  .role-title {
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    font-size: var(--fs-sm);
  }

  .contact-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--text-secondary);
    min-width: 0;
  }

  .contact-label {
    font-weight: 600;
    color: var(--text-primary);
  }

  .contact-item a,
  .contact-item span {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem 1.75rem;
    }
  }
</style>
