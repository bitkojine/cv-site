---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  tags?: string[];
}

const { title, date, description, slug, tags } = Astro.props,
  formattedDate = date.toLocaleDateString('lt-LT', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Europe/Vilnius',
  });
---

<article class="blog-card">
  <a class="blog-card-link" href={`/blog/${slug}`}>
    <h3>{title}</h3>
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <p>{description}</p>
    {
      tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </a>
</article>

<style>
  .blog-card {
    margin-bottom: 1.5rem;
  }

  .blog-card-link {
    display: block;
    padding: 1rem 0;
    background: transparent;
    border-top: 1px solid var(--line);
    border-radius: 0;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .blog-card-link:hover {
    border-color: #b9cbe9;
  }

  h3 {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    overflow-wrap: anywhere;
  }

  time {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  p {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: var(--fs-xs);
    padding: 0.2rem 0.5rem;
    background: color-mix(in oklab, var(--accent-soft) 60%, white);
    color: var(--accent-tag-text);
    border-radius: 0.25rem;
    font-weight: 500;
  }
</style>
