---
import { Briefcase, Cog, DollarSign } from '@lucide/astro';
---

<section class="door-screen" aria-labelledby="door-heading">
  <p class="eyebrow">Personal Site</p>
  <h1 id="door-heading">What brings you here?</h1>
  <p>
    Choose the door that matches your intent and you will see only the most
    relevant information for that context.
  </p>
  <p class="door-cta-copy">Select one door to continue to a focused view.</p>
  <nav aria-label="Role doors" class="door-grid">
    <a class="door" href="/hiring" data-role-door="Recruiter / Hiring Manager">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <Briefcase size={20} />
        </span>
        <span class="door-label">I’m a Recruiter / Hiring Manager</span>
      </span>
      <span class="door-subtext">Hiring for a role</span>
    </a>
    <a class="door" href="/build" data-role-door="Founder / Operator">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <Cog size={20} />
        </span>
        <span class="door-label">I’m a Founder / Operator</span>
      </span>
      <span class="door-subtext">Building or fixing a product</span>
    </a>
    <a class="door" href="/vision" data-role-door="Investor / Advisor">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <DollarSign size={20} />
        </span>
        <span class="door-label">I’m an Investor / Advisor</span>
      </span>
      <span class="door-subtext">Evaluating vision or direction</span>
    </a>
  </nav>
</section>
