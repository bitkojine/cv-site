---
import { Briefcase, Code2, Cog, DollarSign, Layers } from '@lucide/astro';
---

<section aria-labelledby="home-heading" class="home-inbox">
  <p class="eyebrow">Recruiter Path</p>
  <h1 id="home-heading">Review backend hiring fit in under a minute.</h1>
  <p class="home-lead">
    Open the hiring profile first to check role fit, availability, and next
    steps.
  </p>

  <div class="home-actions">
    <a
      class="home-primary-cta"
      data-role-door="Recruiter / Hiring Manager"
      href="/hiring"
    >
      <span aria-hidden="true" class="menu-icon"><Briefcase size={16} /></span>
      View Candidate Fit
    </a>
    <p class="home-primary-note">
      Includes experience snapshot, resume request, and intro scheduling.
    </p>
    <p class="home-primary-note">
      Need full timeline? Open <a href="/cv">/cv</a> for a printable CV.
    </p>
  </div>

  <nav aria-label="Other visitor paths" class="home-secondary">
    <p class="home-secondary-label">Not visiting as recruiter?</p>
    <div class="home-secondary-links">
      <a data-role-door="Founder / Operator" href="/build">
        <span aria-hidden="true" class="menu-icon"><Cog size={16} /></span>
        I am a Founder / Operator
      </a>
      <a data-role-door="Investor / Advisor" href="/vision">
        <span aria-hidden="true" class="menu-icon"
          ><DollarSign size={16} /></span
        >
        I am an Investor / Advisor
      </a>
      <a data-role-door="Developer / Builder" href="/dev">
        <span aria-hidden="true" class="menu-icon"><Code2 size={16} /></span>
        I am a Developer / Builder
      </a>
      <a href="/operating-system">
        <span aria-hidden="true" class="menu-icon"><Layers size={16} /></span>
        I want to see this Website System
      </a>
    </div>
  </nav>
</section>
