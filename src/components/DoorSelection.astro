---
import { Briefcase, Cog, DollarSign } from '@lucide/astro';
---

<section class="door-screen" aria-labelledby="door-heading">
  <p class="eyebrow">I’m Robertas Rudys</p>
  <h1 id="door-heading">And who are you?</h1>
  <p>
    Choose the visitor type that matches your intent. You will see the most
    relevant information first.
  </p>
  <p class="door-cta-copy">Select one option to continue.</p>
  <nav aria-label="Visitor options" class="door-grid">
    <a class="door" href="/hiring" data-role-door="Recruiter / Hiring Manager">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <Briefcase size={20} />
        </span>
        <span class="door-label">I’m a Recruiter / Hiring Manager</span>
      </span>
      <span class="door-subtext">Hiring for an open position</span>
    </a>
    <a class="door" href="/build" data-role-door="Founder / Operator">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <Cog size={20} />
        </span>
        <span class="door-label">I’m a Founder / Operator</span>
      </span>
      <span class="door-subtext">Building or scaling a product</span>
    </a>
    <a class="door" href="/vision" data-role-door="Investor / Advisor">
      <span class="door-head">
        <span class="door-icon" aria-hidden="true">
          <DollarSign size={20} />
        </span>
        <span class="door-label">I’m an Investor / Advisor</span>
      </span>
      <span class="door-subtext">
        Evaluating traction, execution quality, and long-term potential
      </span>
    </a>
  </nav>
</section>
