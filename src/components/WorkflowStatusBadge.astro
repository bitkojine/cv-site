---
import type { WorkflowRun } from '../lib/github-actions.mts';
import { resolveWorkflowBadge } from '../lib/github-status.mts';

interface Props {
  run: WorkflowRun;
}

const { run } = Astro.props;
const resolved = resolveWorkflowBadge(run.status, run.conclusion);
---

<a
  href={run.html_url}
  target="_blank"
  rel="noopener noreferrer"
  class="workflow-badge"
  data-status={resolved.state}
  data-workflow-id={run.workflow_id}
  aria-label={`${run.name} workflow status: ${resolved.label}`}
>
  <span class="workflow-badge__dot" aria-hidden="true"></span>
  <span class="workflow-badge__meta">
    <span class="workflow-badge__name">{run.name}</span>
    <span class="workflow-badge__status">{resolved.label}</span>
  </span>
</a>
