---
import type { WorkflowRun } from '../lib/github-actions.mts';
import { resolveWorkflowBadge } from '../lib/github-status.mts';

interface Props {
  run: WorkflowRun;
}

const { run } = Astro.props,
 resolved = resolveWorkflowBadge(run.status, run.conclusion);
---

<a
  aria-label={`${run.name} workflow status: ${resolved.label}`}   class="workflow-badge"   data-status={resolved.state}   data-workflow-id={run.workflow_id}   href={run.html_url}   rel="noopener noreferrer"   target="_blank"
>
  <span class="workflow-badge__meta">
    <span class="workflow-badge__name">{run.name}</span>
    <span class="workflow-badge__status">{resolved.label}</span>
  </span>
</a>
