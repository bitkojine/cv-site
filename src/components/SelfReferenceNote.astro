---
import type { EchoNote } from '../data/echo-notes.mts';

interface Props {
  className?: string;
  ariaLabel?: string;
  mascotName?: string;
  note: EchoNote;
  pathname?: string;
}

const {
  className = '',
  ariaLabel = 'Website self-reference note',
  mascotName = 'Echo the Horse',
  note,
  pathname = '',
} = Astro.props;

const notePayload = JSON.stringify(note).replaceAll('<', '\\u003c');
---

<div
  aria-label={ariaLabel}
  class:list={['self-reference', className]}
  data-echo-note={notePayload}
  data-echo-pathname={pathname}
  data-echo-root
  role="note"
>
  <details class="self-reference__panel">
    <summary class="self-reference__summary">
      <span aria-hidden="true" class="self-reference__mascot">
        <span class="self-reference__mascot-glyph">♞</span>
      </span>
      <span class="self-reference__meta">
        <span class="self-reference__mascot-name">{mascotName}</span>
        <span class="self-reference__word-count">
          <span>Words:</span>
          <strong data-echo-word-count>0</strong>
          <span data-echo-word-hint>Calculating...</span>
        </span>
      </span>
      <span class="self-reference__summary-label">
        <span class="self-reference__summary-open">↓ Open</span>
        <span class="self-reference__summary-close">↑ Close</span>
      </span>
    </summary>
    <div class="self-reference__body">
      <p class="self-reference__message" data-echo-message>
        {note.variants.full}
      </p>
      {
        note.actionPrompts.length > 0 && (
          <div class="self-reference__actions">
            <p class="self-reference__action-label">Use this page to:</p>
            <ol>
              {note.actionPrompts.map((prompt) => (
                <li>{prompt}</li>
              ))}
            </ol>
          </div>
        )
      }
      {
        note.crossRoute && (
          <p class="self-reference__cross-route">
            <a href={note.crossRoute.href}>{note.crossRoute.label}</a>
          </p>
        )
      }
    </div>
  </details>
</div>

<script is:inline>
  (() => {
    const echoCountCacheKey = 'echo-word-count:v1';

    const scheduleIdle = (task) => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(task, { timeout: 500 });
        return;
      }
      window.setTimeout(task, 0);
    };

    const chooseVariant = (note) => note.variants.full || '';
    const countWords = (text) =>
      text.trim().split(/\s+/).filter(Boolean).length;

    const computeWordCount = (routePath = window.location.pathname) => {
      const target = routePath.startsWith('/blog/')
        ? document.querySelector('#blog-post-content .prose') ||
          document.querySelector('#blog-post-content') ||
          document.querySelector('main#main-content') ||
          document.querySelector('main.page-shell') ||
          document.body
        : document.querySelector('main#main-content') ||
          document.querySelector('main.page-shell') ||
          document.body;
      if (!(target instanceof HTMLElement)) return 0;

      const clone = target.cloneNode(true);
      if (!(clone instanceof HTMLElement)) return 0;

      clone
        .querySelectorAll(
          [
            '[data-echo-root]',
            '.mode-indicator',
            '.site-footer',
            '.site-footer-note',
            'script',
            'style',
            'noscript',
            'template',
            'svg',
          ].join(',')
        )
        .forEach((node) => node.remove());

      const text = (clone.textContent || '').replace(/\s+/g, ' ').trim();
      return text ? countWords(text) : 0;
    };

    const hintForCount = (count) => {
      if (count < 120) return 'Lean';
      if (count > 800) return 'Dense';
      return 'Balanced';
    };

    const bindEcho = (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.echoBound === '1') return;
      root.dataset.echoBound = '1';

      const noteRaw = root.dataset.echoNote ?? '{}';
      let note;
      try {
        note = JSON.parse(noteRaw);
      } catch {
        return;
      }
      const messageEl = root.querySelector('[data-echo-message]');
      const panelEl = root.querySelector('.self-reference__panel');
      const countEl = root.querySelector('[data-echo-word-count]');
      const hintEl = root.querySelector('[data-echo-word-hint]');
      const routePath = root.dataset.echoPathname || window.location.pathname;
      if (!(messageEl instanceof HTMLElement)) return;
      if (!(panelEl instanceof HTMLDetailsElement)) return;
      if (!(countEl instanceof HTMLElement)) return;
      if (!(hintEl instanceof HTMLElement)) return;

      const applyVariantIfCollapsed = () => {
        if (panelEl.open) return;
        messageEl.textContent = chooseVariant(note);
      };

      const updateWordCount = () => {
        const total = computeWordCount(routePath);
        const hint = hintForCount(total);
        countEl.textContent = total.toLocaleString('en-US');
        hintEl.textContent = hint;
        try {
          const current = JSON.parse(
            localStorage.getItem(echoCountCacheKey) || '{}'
          );
          current[routePath] = {
            count: total,
            hint,
            updatedAt: Date.now(),
          };
          localStorage.setItem(echoCountCacheKey, JSON.stringify(current));
        } catch {}
      };

      applyVariantIfCollapsed();
      try {
        const current = JSON.parse(
          localStorage.getItem(echoCountCacheKey) || '{}'
        );
        const cached = current[routePath];
        if (cached && Number.isFinite(cached.count)) {
          countEl.textContent = Number(cached.count).toLocaleString('en-US');
          hintEl.textContent =
            typeof cached.hint === 'string'
              ? cached.hint
              : hintForCount(Number(cached.count));
        }
      } catch {}
      scheduleIdle(updateWordCount);

      panelEl.addEventListener('toggle', () => {
        if (!panelEl.open) {
          applyVariantIfCollapsed();
        }
      });
    };

    const init = () => {
      document.querySelectorAll('[data-echo-root]').forEach(bindEcho);
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
