---
import { Sun, Moon, FileText, NotebookPen, Share2 } from '@lucide/astro';

const isCvPage =
  Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<script>
  function trackEvent(name: string, data: Record<string, unknown> = {}) {
    try {
      const key = 'cv_event_counts';
      const raw = localStorage.getItem(key);
      const payload = raw ? JSON.parse(raw) : { counts: {}, last: {} };
      payload.counts[name] = (payload.counts[name] || 0) + 1;
      payload.last[name] = { ts: Date.now(), ...data };
      localStorage.setItem(key, JSON.stringify(payload));
      if (window.location.search.includes('debug=1')) {
        console.info('[track]', name, data);
      }
    } catch (e) {
      console.warn('Tracking failed', e);
    }
  }

  function showToast(message: string) {
    const toast = document.querySelector('.share-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('hidden');
    toast.classList.add('visible');
    window.setTimeout(() => {
      toast.classList.remove('visible');
      toast.classList.add('hidden');
    }, 2200);
  }

  async function shareProfile() {
    const url = new URL(window.location.href);
    if (!url.searchParams.get('ref')) {
      url.searchParams.set('ref', 'share');
    }
    const title =
      document.title || document.querySelector('h1')?.textContent || 'CV';
    const description =
      document
        .querySelector('meta[name="description"]')
        ?.getAttribute('content') || 'Professional CV';
    const shareData = {
      title,
      text: description,
      url: url.toString(),
    };

    trackEvent('share_clicked');

    if (navigator.share) {
      try {
        await navigator.share(shareData);
        trackEvent('share_completed', { method: 'web_share' });
        showToast('Share sent');
        return;
      } catch (err) {
        console.warn('Share canceled or failed', err);
      }
    }

    try {
      await navigator.clipboard.writeText(shareData.url);
      trackEvent('share_completed', { method: 'copy_link' });
      showToast('Link copied');
    } catch (err) {
      console.warn('Copy failed', err);
      showToast('Copy failed');
    }
  }

  function downloadPDF() {
    // Professional notice before printing
    console.log('Preparing PDF export...');
    window.print();
  }

  function toggleDarkMode() {
    const isDark = document.documentElement.classList.toggle('dark-mode');
    localStorage.setItem('darkMode', isDark ? 'enabled' : 'disabled');
    updateThemeAssets(isDark);
  }

  function updateThemeAssets(isDark: boolean) {
    const sunIcon = document.querySelector('.sun-icon');
    const moonIcon = document.querySelector('.moon-icon');
    const toggleText = document.querySelector('.toggle-text');

    if (sunIcon && moonIcon && toggleText) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        toggleText.textContent = 'Light';
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        toggleText.textContent = 'Dark';
      }
    }
  }

  // Initialization logic
  document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark-mode');
    updateThemeAssets(isDark);
    const isCvPage =
      window.location.pathname === '/' || window.location.pathname === '';
    document
      .querySelectorAll('.cv-only')
      .forEach((el) => el.classList.toggle('hidden', !isCvPage));
    document
      .querySelectorAll('.non-cv-only')
      .forEach((el) => el.classList.toggle('hidden', isCvPage));

    document
      .querySelector('.dark-mode-toggle')
      ?.addEventListener('click', toggleDarkMode);
    document
      .querySelector('.download-btn')
      ?.addEventListener('click', downloadPDF);
    document
      .querySelector('.share-btn')
      ?.addEventListener('click', shareProfile);
  });
</script>

<div class="controls-dock no-print">
  <button
    class="btn-primary dark-mode-toggle"
    type="button"
    aria-label="Toggle dark mode"
  >
    <Sun class="sun-icon hidden" size={20} />
    <Moon class="moon-icon" size={20} />
    <span class="toggle-text">Dark</span>
  </button>
  <button
    class={`btn-primary download-btn cv-only${isCvPage ? '' : ' hidden'}`}
    type="button"
    aria-label="Download CV as PDF"
  >
    <FileText size={20} />
    <span>PDF</span>
  </button>
  <a
    href="/"
    class={`btn-primary cv-btn non-cv-only${isCvPage ? ' hidden' : ''}`}
    aria-label="Back to CV"
  >
    <FileText size={20} />
    <span>CV</span>
  </a>
  <button class="btn-primary share-btn" type="button" aria-label="Share CV">
    <Share2 size={20} />
    <span>Share</span>
  </button>
  <a href="/blog" class="btn-primary blog-btn" aria-label="Read my blog">
    <NotebookPen size={20} />
    <span>Blog</span>
  </a>
</div>
<div class="share-toast hidden" role="status" aria-live="polite"></div>

<style>
  .hidden {
    display: none;
  }

  .share-toast {
    position: fixed;
    left: 50%;
    bottom: 5.5rem;
    transform: translateX(-50%) translateY(8px);
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: var(--fs-sm);
    max-width: calc(100vw - 2rem);
    box-sizing: border-box;
    text-align: center;
    box-shadow: var(--shadow-md);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 1100;
  }

  .share-toast.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>
