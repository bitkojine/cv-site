---
import { FileText, NotebookPen, Share2 } from '@lucide/astro';

const isCvPage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<script>
  function reportEvent(name: string, data: Record<string, unknown> = {}) {
    const sendEvent = window.cvReportEvent ?? window.cvTrack;
    if (typeof sendEvent === 'function') {
      sendEvent(name, data);
      return;
    }

    if (window.location.search.includes('debug=1')) {
      console.info('[event-report]', name, data);
    }
  }

  function showToast(message: string) {
    const toast = document.querySelector('.share-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('hidden');
    toast.classList.add('visible');
    window.setTimeout(() => {
      toast.classList.remove('visible');
      toast.classList.add('hidden');
    }, 2200);
  }

  async function shareProfile() {
    const url = new URL(window.location.href);
    if (!url.searchParams.get('ref')) {
      url.searchParams.set('ref', 'share');
    }
    const title =
      document.title || document.querySelector('h1')?.textContent || 'CV';
    const description =
      document
        .querySelector('meta[name="description"]')
        ?.getAttribute('content') || 'Professional CV';
    const shareData = {
      title,
      text: description,
      url: url.toString(),
    };

    reportEvent('share_clicked');

    if (navigator.share) {
      try {
        await navigator.share(shareData);
        reportEvent('share_completed', { method: 'web_share' });
        showToast('Share sent');
        return;
      } catch (err) {
        console.warn('Share canceled or failed', err);
      }
    }

    try {
      await navigator.clipboard.writeText(shareData.url);
      reportEvent('share_completed', { method: 'copy_link' });
      showToast('Link copied');
    } catch (err) {
      console.warn('Copy failed', err);
      showToast('Copy failed');
    }
  }

  function downloadPDF() {
    console.log('Preparing PDF export...');
    window.print();
  }

  function toggleDebugGrid() {
    document.body.classList.toggle('debug-grid');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const isCvPage =
      window.location.pathname === '/' || window.location.pathname === '';
    document
      .querySelectorAll('.cv-only')
      .forEach((el) => el.classList.toggle('hidden', !isCvPage));
    document
      .querySelectorAll('.non-cv-only')
      .forEach((el) => el.classList.toggle('hidden', isCvPage));

    document
      .querySelector('.download-btn')
      ?.addEventListener('click', downloadPDF);
    document
      .querySelector('.share-btn')
      ?.addEventListener('click', shareProfile);
    document
      .querySelector('.debug-grid-toggle')
      ?.addEventListener('click', toggleDebugGrid);
  });
</script>

<div class="controls-dock no-print">
  <button
    class={`btn-primary download-btn cv-only${isCvPage ? '' : ' hidden'}`}
    type="button"
    aria-label="Download CV as PDF"
  >
    <FileText size={20} />
    <span>PDF</span>
  </button>
  <a
    href="/"
    class={`btn-primary cv-btn non-cv-only${isCvPage ? ' hidden' : ''}`}
    aria-label="Back to CV"
  >
    <FileText size={20} />
    <span>CV</span>
  </a>
  <button class="btn-primary share-btn" type="button" aria-label="Share CV">
    <Share2 size={20} />
    <span>Share</span>
  </button>
  <a href="/blog" class="btn-primary blog-btn" aria-label="Read my blog">
    <NotebookPen size={20} />
    <span>Blog</span>
  </a>
</div>
<button class="debug-grid-toggle" type="button" aria-label="Toggle debug grid"
></button>
<div class="share-toast hidden" role="status" aria-live="polite"></div>

<style>
  .hidden {
    display: none;
  }

  .share-toast {
    position: fixed;
    left: 50%;
    bottom: 5.5rem;
    transform: translateX(-50%) translateY(8px);
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: var(--fs-sm);
    max-width: calc(100vw - 2rem);
    box-sizing: border-box;
    text-align: center;
    box-shadow: var(--shadow-md);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 1100;
  }

  .share-toast.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .debug-grid-toggle {
    position: fixed;
    bottom: 8px;
    left: 8px;
    width: 36px;
    height: 36px;
    opacity: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: 1200;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>
