---
import snakeScript from '../scripts/snake-background.mts?url';

const tickMs = 120;
---

<div class="snake-background" data-tick-ms={tickMs}>
  <canvas class="snake-canvas" aria-hidden="true"></canvas>
  <div class="snake-controls" aria-hidden="true">
    <button class="snake-control" type="button" data-dir="up">Up</button>
    <div class="snake-controls-row">
      <button class="snake-control" type="button" data-dir="left">Left</button>
      <button class="snake-control" type="button" data-dir="down">Down</button>
      <button class="snake-control" type="button" data-dir="right">Right</button
      >
    </div>
  </div>
</div>

<script type="module" src={snakeScript}></script>
