---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string[];
  year: number;
  kind: 'Company' | 'Startup';
}

const { title, company, period, description, year, kind } = Astro.props;
---

<article class="timeline-item">
  <div class="timeline-year" aria-hidden="true">
    <span>{year}</span>
  </div>
  <div class="timeline-card">
    <header class="timeline-header">
      <div>
        <h3>{title}</h3>
        <span class="company">{company}</span>
      </div>
      <div class="timeline-meta">
        <span class="timeline-tag">{kind}</span>
        <span class="timeline-period" aria-label={`Period: ${period}`}>
          {period}
        </span>
      </div>
    </header>
    <div class="timeline-content">
      {description.map((item) => <p>{item}</p>)}
    </div>
  </div>
</article>

<style>
  .timeline-item {
    position: relative;
    padding-top: 3rem;
    height: 100%;
  }

  .timeline-year {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 48px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .timeline-year::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent-600);
    box-shadow: 0 0 0 7px var(--bg-app);
    flex: 0 0 auto;
  }

  .timeline-card {
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    width: 100%;
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .timeline-tag {
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-inverse);
    background: var(--accent-600);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
  }

  .timeline-period {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-inverse);
    background: var(--accent-600);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    width: fit-content;
  }

  .timeline-content p {
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .timeline-content p::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent-text);
    font-weight: bold;
  }

  .company {
    font-weight: 600;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .timeline-year {
      height: 56px;
    }

    .timeline-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .timeline-card {
      padding: 2rem;
    }
  }
</style>
