---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string[];
  year: number;
  kind: 'Company' | 'Startup';
}

const { title, company, period, description, year, kind } = Astro.props;
---

<article class="timeline-item">
  <div aria-hidden="true" class="timeline-year">
    <span>{year}</span>
  </div>
  <div class="timeline-card">
    <header class="timeline-header">
      <div>
        <h3>{title}</h3>
        <span class="company">{company}</span>
      </div>
      <div class="timeline-meta">
        <span class="timeline-tag">{kind}</span>
        <span aria-label={`Period: ${period}`} class="timeline-period">
          {period}
        </span>
      </div>
    </header>
    <ul class="timeline-content">
      {description.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</article>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: minmax(64px, 88px) 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-top: calc(
      var(--timeline-line-y) - (var(--timeline-year-height, 28px) * 0.5)
    );
    padding-bottom: 1.5rem;
  }

  .timeline-year {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .timeline-year span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--timeline-year-height, 28px);
    padding: 0 0.55rem;
    border-radius: 999px;
    background: var(--bg-app);
    box-shadow: 0 0 0 4px var(--bg-app);
  }

  .timeline-year span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent-600);
    flex: 0 0 auto;
  }

  .timeline-card {
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: 0.75rem;
  }

  .timeline-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: start;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-end;
    align-items: center;
  }

  .timeline-tag,
  .timeline-period {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .timeline-content {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }

  .timeline-content li {
    margin: 0;
  }

  .company {
    font-weight: 600;
    color: var(--text-secondary);
  }

  @media (max-width: 720px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .timeline-header {
      grid-template-columns: 1fr;
    }

    .timeline-meta {
      justify-content: flex-start;
    }
  }

  @media (min-width: 768px) {
    .timeline-card {
      padding: 1.5rem;
    }
  }
</style>
