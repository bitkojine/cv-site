---
import { Briefcase, Code2, Cog, DollarSign, House } from '@lucide/astro';

interface Props {
  currentRole:
    | 'Recruiter / Hiring Manager'
    | 'Founder / Operator'
    | 'Investor / Advisor'
    | 'Developer / Builder';
}

const { currentRole } = Astro.props;
---

<aside class="mode-indicator" data-role-indicator hidden>
  <details class="switch-details" data-role-switch-details>
    <summary class="switch-summary">
      You are visiting as: <strong data-role-label>{currentRole}</strong>
      <span class="switch-button">(Change visitor role)</span>
    </summary>
    <nav aria-label="Switch role" class="switch-list" data-role-switch-list>
      <a class="switch-return-link" data-return-door href="/?choose=1">
        <span aria-hidden="true" class="menu-icon"><House size={16} /></span>
        Return to visitor role picker
      </a>
      <a data-role-switch="Recruiter / Hiring Manager" href="/hiring">
        <span aria-hidden="true" class="menu-icon"><Briefcase size={16} /></span
        >
        Visit as Recruiter / Hiring Manager
      </a>
      <a data-role-switch="Founder / Operator" href="/build">
        <span aria-hidden="true" class="menu-icon"><Cog size={16} /></span>
        Visit as Founder / Operator
      </a>
      <a data-role-switch="Investor / Advisor" href="/vision">
        <span aria-hidden="true" class="menu-icon"
          ><DollarSign size={16} /></span
        >
        Visit as Investor / Advisor
      </a>
      <a data-role-switch="Developer / Builder" href="/dev">
        <span aria-hidden="true" class="menu-icon"><Code2 size={16} /></span>
        Visit as Developer / Builder
      </a>
    </nav>
  </details>
</aside>
