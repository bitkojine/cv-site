<script>
  (() => {
    const ROLE_PATHS = {
      'Recruiter / Hiring Manager': '/hiring',
      'Founder / Operator': '/build',
      'Investor / Advisor': '/vision',
      'Developer / Builder': '/dev',
    };

    const ROLE_BY_PATH = {
      '/hiring': 'Recruiter / Hiring Manager',
      '/build': 'Founder / Operator',
      '/vision': 'Investor / Advisor',
      '/dev': 'Developer / Builder',
    };

    const depthMarks = [25, 50, 75, 100];
    let sentDepth = new Set();
    let activeScrollHandler = null;
    let activeReadingProgressHandler = null;

    const reportEvent = (eventName, props = {}) => {
      const sendEvent = window.cvReportEvent ?? window.cvTrack;
      if (typeof sendEvent === 'function') {
        sendEvent(eventName, props);
        return;
      }
      if (window.location.search.includes('debug=1')) {
        console.log('[event-report]', eventName, props);
      }
    };

    const getPageDescription = () =>
      document
        .querySelector('meta[name="description"]')
        ?.getAttribute('content') || 'Profile link';

    const revealProgressive = () => {
      const revealables = document.querySelectorAll('[data-progressive]');
      revealables.forEach((node) => {
        node.removeAttribute('hidden');
      });
    };

    const bindOnce = (element, key, eventName, handler, options) => {
      if (!element) return;
      const marker = `bound${key}`;
      if (element.dataset[marker] === '1') return;
      element.dataset[marker] = '1';
      element.addEventListener(eventName, handler, options);
    };

    const normalizePath = (value) => {
      if (!value || value === '/') return '/';
      return value.endsWith('/') ? value.slice(0, -1) : value;
    };

    const updateShareButtonLabel = (button, label) => {
      const labelNode = button.querySelector('[data-role-share-label]');
      if (!labelNode) return;
      const baseLabel =
        button.getAttribute('data-role-share-label-default') ||
        labelNode.textContent ||
        'Share';
      labelNode.textContent = label;
      window.setTimeout(() => {
        labelNode.textContent = baseLabel;
      }, 1800);
    };

    const buildShareUrl = (roleLabel) => {
      const url = new URL(window.location.href);
      url.searchParams.set('ref', 'peer_share');
      if (roleLabel) {
        url.searchParams.set('shared_role', roleLabel);
      }
      return url.toString();
    };

    const initPage = () => {
      sentDepth = new Set();
      const getSessionValue = (key) => {
        try {
          return window.sessionStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const setSessionValue = (key, value) => {
        try {
          window.sessionStorage.setItem(key, value);
        } catch {
          void 0;
        }
      };

      const path = normalizePath(window.location.pathname);
      const currentRole = ROLE_BY_PATH[path] || '';
      const roleForAnalytics = currentRole || 'Role Selection';
      const params = new URLSearchParams(window.location.search);
      const ref = params.get('ref');
      const sessionKey = `share-visit:${window.location.pathname}${window.location.search}`;
      if (ref === 'peer_share' && !getSessionValue(sessionKey)) {
        reportEvent('share_visit', {
          mode: roleForAnalytics,
          ref,
          shared_role: params.get('shared_role') || 'unknown',
        });
        setSessionValue(sessionKey, '1');
      }

      document.querySelectorAll('[data-role-door]').forEach((link) => {
        bindOnce(
          link,
          'DoorClick',
          'click',
          () => {
            const selectedRole = link.getAttribute('data-role-door') || '';
            reportEvent('mode_selected', { role: selectedRole });
          },
          { once: true }
        );
      });

      const indicator = document.querySelector('[data-role-indicator]');
      const isRolePage = Boolean(currentRole);

      if (indicator && isRolePage) {
        indicator.hidden = false;
      }

      document.querySelectorAll('[data-role-switch]').forEach((link) => {
        bindOnce(link, 'SwitchClick', 'click', () => {
          const nextRole = link.getAttribute('data-role-switch') || '';
          const nextPath = ROLE_PATHS[nextRole];
          if (!nextPath || nextPath === path) return;
          reportEvent('mode_switched', { from: currentRole, to: nextRole });
        });
      });

      document.querySelectorAll('[data-return-door]').forEach((link) => {
        bindOnce(link, 'ReturnClick', 'click', () => {
          reportEvent('mode_switched', {
            from: currentRole,
            to: 'Role Selection',
          });
        });
      });

      document.querySelectorAll('[data-role-share]').forEach((button) => {
        const shareLabelNode = button.querySelector('[data-role-share-label]');
        if (
          !button.getAttribute('data-role-share-label-default') &&
          shareLabelNode?.textContent
        ) {
          button.setAttribute(
            'data-role-share-label-default',
            shareLabelNode.textContent
          );
        }

        bindOnce(button, 'RoleShareClick', 'click', async () => {
          const selectedRole = button.getAttribute('data-role-share') || '';
          const shareSource =
            button.getAttribute('data-share-source') || 'role_share';
          const shareUrl = buildShareUrl(selectedRole || currentRole);
          const sharePayload = {
            title: button.getAttribute('data-share-title') || document.title,
            text:
              button.getAttribute('data-share-text') || getPageDescription(),
            url: shareUrl,
          };

          reportEvent('share_clicked', {
            source: shareSource,
            mode: roleForAnalytics,
          });

          if (navigator.share) {
            try {
              await navigator.share(sharePayload);
              reportEvent('share_completed', {
                method: 'web_share',
                source: shareSource,
                mode: roleForAnalytics,
              });
              updateShareButtonLabel(button, 'Shared');
              return;
            } catch (err) {
              void err;
            }
          }

          try {
            await navigator.clipboard.writeText(shareUrl);
            reportEvent('share_completed', {
              method: 'copy_link',
              source: shareSource,
              mode: roleForAnalytics,
            });
            updateShareButtonLabel(button, 'Link copied');
          } catch (err) {
            void err;
            updateShareButtonLabel(button, 'Copy failed');
          }
        });
      });

      const peerSharePrompt = document.querySelector(
        '[data-peer-share-prompt]'
      );
      const peerShareButton = document.querySelector(
        '[data-peer-share-forward]'
      );
      const peerShareLabelNode = document.querySelector(
        '[data-peer-share-forward-label]'
      );
      const peerShareBaseLabel =
        peerShareLabelNode?.textContent?.trim() || 'Forward Profile';
      const setPeerShareLabel = (label) => {
        if (!peerShareLabelNode) return;
        peerShareLabelNode.textContent = label;
      };
      const resetPeerShareLabel = () => {
        window.setTimeout(() => {
          setPeerShareLabel(peerShareBaseLabel);
        }, 1800);
      };

      if (peerSharePrompt) {
        if (ref !== 'peer_share') {
          peerSharePrompt.hidden = true;
        } else {
          peerSharePrompt.hidden = false;
          const sharedRole =
            params.get('shared_role') || currentRole || 'unknown';
          const promptSessionKey = `peer-share-prompt:${path}:${sharedRole}`;
          if (!getSessionValue(promptSessionKey)) {
            reportEvent('peer_share_prompt_viewed', {
              mode: roleForAnalytics,
              shared_role: sharedRole,
            });
            setSessionValue(promptSessionKey, '1');
          }

          bindOnce(peerShareButton, 'PeerShareForward', 'click', async () => {
            const shareUrl = buildShareUrl(sharedRole || currentRole);
            const sharePayload = {
              title: document.title,
              text: getPageDescription(),
              url: shareUrl,
            };
            reportEvent('share_clicked', {
              source: 'peer_share_prompt',
              mode: roleForAnalytics,
            });

            if (navigator.share) {
              try {
                await navigator.share(sharePayload);
                reportEvent('peer_share_forwarded', {
                  method: 'web_share',
                  mode: roleForAnalytics,
                  shared_role: sharedRole,
                });
                setPeerShareLabel('Forwarded');
                resetPeerShareLabel();
                return;
              } catch (err) {
                void err;
              }
            }

            try {
              await navigator.clipboard.writeText(shareUrl);
              reportEvent('peer_share_forwarded', {
                method: 'copy_link',
                mode: roleForAnalytics,
                shared_role: sharedRole,
              });
              setPeerShareLabel('Link copied');
              resetPeerShareLabel();
            } catch (err) {
              void err;
              setPeerShareLabel('Copy failed');
              resetPeerShareLabel();
            }
          });
        }
      }

      document.querySelectorAll('[data-cta]').forEach((element) => {
        bindOnce(element, 'CtaClick', 'click', () => {
          const cta = element.getAttribute('data-cta') || 'unknown';
          const mode = element.getAttribute('data-cta-mode') || currentRole;
          reportEvent('cta_clicked', { cta, mode });
          revealProgressive();
        });

        bindOnce(element, 'CtaHover', 'mouseenter', () => {
          revealProgressive();
        });

        bindOnce(element, 'CtaTouch', 'touchstart', revealProgressive, {
          passive: true,
        });
      });

      const revealOnDepth = () => {
        const documentHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        if (documentHeight <= 0) return;

        const depth = Math.min(
          100,
          Math.round((window.scrollY / documentHeight) * 100)
        );

        depthMarks.forEach((mark) => {
          if (depth >= mark && !sentDepth.has(mark)) {
            sentDepth.add(mark);
            reportEvent('scroll_depth', {
              depth: mark,
              mode: roleForAnalytics,
            });
          }
        });

        if (depth >= 35) {
          revealProgressive();
        }
      };

      if (activeScrollHandler) {
        window.removeEventListener('scroll', activeScrollHandler);
      }
      activeScrollHandler = revealOnDepth;
      window.addEventListener('scroll', activeScrollHandler, { passive: true });
      revealOnDepth();

      if (activeReadingProgressHandler) {
        window.removeEventListener('scroll', activeReadingProgressHandler);
        window.removeEventListener('resize', activeReadingProgressHandler);
      }
      const progressRoot = document.querySelector('[data-reading-progress]');
      const progressBar = document.querySelector('[data-reading-progress-bar]');
      if (
        !(progressRoot instanceof HTMLElement) ||
        !(progressBar instanceof HTMLElement)
      ) {
        return;
      }
      const targetSelector = progressRoot.getAttribute(
        'data-reading-progress-target'
      );
      const target = targetSelector
        ? document.querySelector(targetSelector)
        : null;
      if (!(target instanceof HTMLElement)) {
        progressRoot.hidden = true;
        return;
      }

      const updateReadingProgress = () => {
        const targetRect = target.getBoundingClientRect();
        const topOffset = window.scrollY + targetRect.top;
        const maxDistance = Math.max(
          1,
          target.offsetHeight - window.innerHeight
        );
        const traveled = Math.min(
          maxDistance,
          Math.max(0, window.scrollY - topOffset)
        );
        const percent = Math.max(
          0,
          Math.min(100, Math.round((traveled / maxDistance) * 100))
        );
        progressBar.style.width = `${percent}%`;
        progressRoot.setAttribute('aria-valuenow', String(percent));
      };

      activeReadingProgressHandler = updateReadingProgress;
      window.addEventListener('scroll', activeReadingProgressHandler, {
        passive: true,
      });
      window.addEventListener('resize', activeReadingProgressHandler, {
        passive: true,
      });
      updateReadingProgress();
    };

    document.addEventListener('astro:page-load', initPage);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage, { once: true });
    } else {
      initPage();
    }
  })();
</script>
