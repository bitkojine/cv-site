---
interface Props {
  targetSelector: string;
  label?: string;
}

const { targetSelector, label = 'Reading progress' } = Astro.props;
---

<div
  aria-label={label}
  class="reading-progress"
  data-reading-progress
  data-reading-progress-target={targetSelector}
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <span class="reading-progress__bar" data-reading-progress-bar></span>
</div>
