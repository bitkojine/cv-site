---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string[];
}

const { title, company, period, description } = Astro.props;
---

<article class="job-item">
  <header class="job-header">
    <div class="job-info">
      <h3>{title}</h3>
      <span class="company">{company}</span>
    </div>
    <span class="job-period" aria-label={`Period: ${period}`}>{period}</span>
  </header>
  <ul class="job-content">
    {description.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .job-item {
    margin-bottom: 1.25rem;
    padding-bottom: 0.25rem;
  }

  .job-header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 0.4rem;
  }

  .job-info h3 {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.3;
  }

  .company {
    display: block;
    font-weight: 600;
    color: inherit;
  }

  .job-period {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-weight: 500;
  }

  .job-content {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .job-content li {
    margin-bottom: 0.35rem;
  }

  @media (min-width: 768px) {
    .job-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
  }
</style>
