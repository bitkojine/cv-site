---
import {
  createDraftTooltip,
  type EmailCtaConfig,
} from '../lib/email-drafts.mts';
import {
  Briefcase,
  CalendarClock,
  Handshake,
  PhoneCall,
  Radio,
  Landmark,
} from '@lucide/astro';

interface Props {
  cta: EmailCtaConfig;
  mode: string;
}

const { cta, mode } = Astro.props;
const className = cta.variant === 'primary' ? 'cta-primary' : 'cta-secondary';
const [recipientLocalPart = '', recipientDomain = ''] =
  cta.recipientEmail.split('@');
const encodedSubject = encodeURIComponent(cta.draft.subject);
const encodedBody = encodeURIComponent(cta.draft.body);

const iconByLabel = {
  'Request Resume': Briefcase,
  'Schedule Intro': CalendarClock,
  'Work Together': Handshake,
  'Book a Call': PhoneCall,
  'Get Product Updates': Radio,
  'Request Investment Details': Landmark,
} as const;

const Icon = iconByLabel[cta.label] ?? Briefcase;
---

<a
  class={className}
  href="#contact-email"
  title={createDraftTooltip(cta.draft)}
  data-cta={cta.label}
  data-cta-mode={mode}
  data-mailto-link
  data-email-local={recipientLocalPart}
  data-email-domain={recipientDomain}
  data-email-subject={encodedSubject}
  data-email-body={encodedBody}
>
  <span class="cta-icon" aria-hidden="true"><Icon size={16} /></span>
  <span>{cta.label}</span>
</a>
