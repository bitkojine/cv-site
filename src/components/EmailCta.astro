---
import {
  createDraftTooltip,
  createMailtoHref,
  type EmailCtaConfig,
} from '../lib/email-drafts.mts';

interface Props {
  cta: EmailCtaConfig;
  mode: string;
}

const { cta, mode } = Astro.props;
const className = cta.variant === 'primary' ? 'cta-primary' : 'cta-secondary';
---

<a
  class={className}
  href={createMailtoHref(cta.recipientEmail, cta.draft)}
  title={createDraftTooltip(cta.draft)}
  data-cta={cta.label}
  data-cta-mode={mode}
>
  {cta.label}
</a>
