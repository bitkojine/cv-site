---
import {
  type EmailCtaConfig,
  createDraftTooltip,
} from '../lib/email-drafts.mts';

interface Props {
  cta: EmailCtaConfig;
  mode: string;
}

const { cta, mode } = Astro.props,
  className = cta.variant === 'primary' ? 'cta-primary' : 'cta-secondary',
  [recipientLocalPart = '', recipientDomain = ''] =
    cta.recipientEmail.split('@'),
  encodedSubject = encodeURIComponent(cta.draft.subject),
  encodedBody = encodeURIComponent(cta.draft.body);
---

<a
  class:list={className}
  data-cta={cta.label}
  data-cta-mode={mode}
  data-email-body={encodedBody}
  data-email-domain={recipientDomain}
  data-email-local={recipientLocalPart}
  data-email-subject={encodedSubject}
  data-mailto-link
  href="#contact-email"
  title={createDraftTooltip(cta.draft)}
>
  {cta.label}
</a>
