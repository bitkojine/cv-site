---
import {
  createDraftTooltip,
  type EmailCtaConfig,
} from '../lib/email-drafts.mts';

interface Props {
  cta: EmailCtaConfig;
  mode: string;
}

const { cta, mode } = Astro.props;
const className = cta.variant === 'primary' ? 'cta-primary' : 'cta-secondary';
const [recipientLocalPart = '', recipientDomain = ''] =
  cta.recipientEmail.split('@');
const encodedSubject = encodeURIComponent(cta.draft.subject);
const encodedBody = encodeURIComponent(cta.draft.body);
---

<a
  class={className}
  href="#contact-email"
  title={createDraftTooltip(cta.draft)}
  data-cta={cta.label}
  data-cta-mode={mode}
  data-mailto-link
  data-email-local={recipientLocalPart}
  data-email-domain={recipientDomain}
  data-email-subject={encodedSubject}
  data-email-body={encodedBody}
>
  {cta.label}
</a>
