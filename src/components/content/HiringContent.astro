---
import { Briefcase } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';

const hiringExperience = [
  {
    title: 'Senior .NET Software Engineer',
    company: 'Product Company (EU, Remote)',
    period: '2026 - Present',
    details: [
      'Owns backend services and APIs supporting core product workflows.',
      'Improves performance and production reliability in mature systems.',
      'Delivers roadmap work with product and data stakeholders.',
    ],
  },
  {
    title: 'Senior .NET Software Engineer',
    company: 'Adform Lithuania',
    period: '2025',
    details: [
      'Built backend services in a high-concurrency production environment.',
      'Delivered mission-critical features in large existing codebases.',
      'Worked within mature testing and reliability standards.',
    ],
  },
  {
    title: 'Senior Software Engineer (.NET)',
    company: 'Ignitis Group Services Center',
    period: '2023',
    details: [
      'Refactored and maintained enterprise .NET systems used by business teams.',
      'Extended legacy code while preserving stability and maintainability.',
      'Improved maintainability in systems with complex operational context.',
    ],
  },
  {
    title: 'Software Engineer (.NET / Blockchain)',
    company: 'Super How',
    period: '2021 - 2022',
    details: [
      'Delivered end-to-end features in a fast-moving product setting.',
      'Built decentralized application integrations and service logic.',
      'Shipped practical outcomes under changing product constraints.',
    ],
  },
  {
    title: 'Software Engineer (.NET / SQL)',
    company: 'Euromonitor International',
    period: '2018 - 2020',
    details: [
      'Implemented data-heavy SQL solutions for research products.',
      'Delivered product modules with .NET and Angular.',
      'Maintained long-lived business systems used across global teams.',
    ],
  },
  {
    title: 'Software Engineer (C# / Unity)',
    company: 'Invenis',
    period: '2015',
    details: [
      'Developed interactive applications using C# and Unity3D.',
      'Implemented gameplay logic and UI systems for client projects.',
      'Built delivery discipline in early professional engineering work.',
    ],
  },
];
---

<section class="mode-hero" aria-labelledby="hiring-heading">
  <div class="headline-row">
    <span class="headline-icon" aria-hidden="true"><Briefcase size={86} /></span
    >
    <h1 id="hiring-heading">
      Senior .NET engineer for stable, long-term product delivery.
    </h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.hiring.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.hiring} />
      ))
    }
    <PageShareButton
      shareRole="Recruiter / Hiring Manager"
      label="Share with hiring team"
      source="hiring_hero_cta"
      shareTitle="Robertas Rudys | Recruiter / Hiring Manager"
      shareText="Sharing this profile for backend hiring review."
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Hiring for a role now: request the resume or book a short intro.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one teammate hiring for backend product engineering."
/>

<section class="card" aria-labelledby="hiring-summary">
  <h2 id="hiring-summary">Profile Snapshot</h2>
  <p>
    Professional engineer since 2015 focused on C# and .NET systems. Strong fit
    for teams that need dependable backend ownership, practical communication,
    and low-risk onboarding into existing product architecture.
  </p>
</section>

<section class="card" aria-labelledby="hiring-skills">
  <h2 id="hiring-skills">Core Technical Scope</h2>
  <ul>
    <li>C#, .NET (Framework/Core/modern .NET), ASP.NET Core, REST APIs</li>
    <li>Relational data modeling, query optimization, performance tuning</li>
    <li>Production troubleshooting, legacy-system debugging, safe refactors</li>
    <li>CI/CD collaboration, code reviews, cross-functional delivery</li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-experience">
  <h2 id="hiring-experience">Experience Highlights</h2>
  {
    hiringExperience.map((role) => (
      <article>
        <h3>{role.title}</h3>
        <p>
          {role.company} | {role.period}
        </p>
        <ul>
          {role.details.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<section class="card" aria-labelledby="hiring-availability">
  <h2 id="hiring-availability">Availability</h2>
  <ul>
    <li>Open to full-time or long-term product roles</li>
    <li>Remote collaboration in EU-aligned time zones</li>
    <li>Structured onboarding and direct communication preferred</li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-workflow">
  <h2 id="hiring-workflow">Hiring Workflow (Fast Path)</h2>
  <ol>
    <li>
      Send role context with the <strong>Request Resume</strong> CTA: title, team
      setup, timezone expectations, and compensation range.
    </li>
    <li>
      For intro calls, use <strong>Schedule Intro</strong> with a preferred window
      and interview format.
    </li>
    <li>
      Initial screening should focus on role fit, onboarding constraints, and
      ownership expectations for the first quarter.
    </li>
  </ol>
  <h3>What I Need To Qualify Fast</h3>
  <ul>
    <li>
      Role scope for the first 90 days, not just generic stack requirements
    </li>
    <li>Decision owners in the process and expected interview stages</li>
    <li>Compensation band and employment setup before deep technical rounds</li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-decision-boundary">
  <h2 id="hiring-decision-boundary">Decision Boundary (Before Interviews)</h2>
  <h3>Reasonable Decisions From This Page Alone</h3>
  <ul>
    <li>Proceed to recruiter screen for backend-focused .NET ownership roles</li>
    <li>Reject if timezone or relocation requirements are incompatible</li>
    <li>Reject if compensation transparency is withheld until late stages</li>
  </ul>
  <h3>Not Decision-Safe Yet</h3>
  <ul>
    <li>Final-level impact ranking versus other shortlisted candidates</li>
    <li>Compensation close decision without legal setup and start-date details</li>
    <li>
      Technical depth calibration without role-level ownership examples in live
      discussion
    </li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-evidence">
  <h2 id="hiring-evidence">Evidence Boundary</h2>
  <ul>
    <li>
      Public profile highlights ownership scope and technical context, not
      confidential internal KPIs.
    </li>
    <li>
      Role history is intentionally conservative: no inflated titles, no
      fabricated leadership claims.
    </li>
    <li>
      If your process requires quantified outcomes, ask directly for role-level
      examples suitable for interview discussion.
    </li>
  </ul>
  <h3>Observable Facts On This Page</h3>
  <ul>
    <li>Role history is listed from 2015 through 2026-present</li>
    <li>Named employers and role periods are shown for each listed role</li>
    <li>Scope is explicitly backend-focused (.NET, APIs, reliability work)</li>
  </ul>
  <h3>Not Verified On-Page</h3>
  <ul>
    <li>Quantified production impact deltas</li>
    <li>Public references from former managers or teams</li>
    <li>Exact legal/employment setup and start-date commitment</li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-fit">
  <h2 id="hiring-fit">Best Team Fit</h2>
  <ul>
    <li>Product teams modernizing existing backend services</li>
    <li>Organizations prioritizing reliability and predictable delivery</li>
    <li>Teams that value ownership and sustainable engineering pace</li>
  </ul>
  <h3>Known Misfit Conditions</h3>
  <ul>
    <li>Roles that require relocation or non-EU timezone-first overlap</li>
    <li>Processes that hide compensation until late-stage interviews</li>
    <li>Positions with undefined ownership boundaries in the first quarter</li>
  </ul>
</section>

<section class="card brutal-ai-score" aria-labelledby="hiring-ai-score">
  <h2 id="hiring-ai-score">Brutal AI Score</h2>
  <p><strong>Overall (5.9 / 10)</strong></p>
  <ul>
    <li>Role clarity: 6.0/10</li>
    <li>Skills specificity: 5.8/10</li>
    <li>Evidence of impact: 4.9/10</li>
    <li>Hiring readiness constraints: 5.8/10</li>
    <li>CTA workflow utility: 5.9/10</li>
    <li>Risk signals (reverse): 4.8/10</li>
  </ul>
  <h3>Top 3 gaps</h3>
  <ul>
    <li>
      No public before/after outcomes tied to named ownership in a specific
      project context.
    </li>
    <li>
      Start-date and legal employment setup are not committed on-page.
    </li>
    <li>
      Final calibration still depends on interview-provided examples, not
      on-page artifacts.
    </li>
  </ul>
  <h3>Can this hold water?</h3>
  <p>
    This page supports a rational first-pass hiring decision to screen in or
    screen out for role-fit constraints. It does not support low-risk final
    hiring commitment because impact proof is qualitative and non-verifiable on
    page.
  </p>
</section>

<style>
  .brutal-ai-score {
    position: relative;
    overflow: clip;
    border: 1px solid #f3c2cd;
    background:
      radial-gradient(circle at 100% 0%, #ffe9ef 0%, transparent 42%),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--surface) 93%, #fff0f4),
        var(--surface) 58%
      );
  }

  .brutal-ai-score::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #fb7185, #e11d48 38%, #be123c 78%);
    opacity: 0.8;
  }

  .brutal-ai-score h2,
  .brutal-ai-score h3 {
    color: #9f1239;
  }

  .brutal-ai-score strong {
    color: #be123c;
  }
</style>
