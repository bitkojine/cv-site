---
import { Briefcase } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';

const hiringExperience = [
  {
    title: 'Senior .NET Software Engineer',
    company: 'Product Company (EU, Remote)',
    period: '2026 - Present',
    details: [
      {
        scope:
          'Own service and API scope for core product workflows end to end.',
        metric: '31% faster lead time (13 days -> 9 days)',
        result:
          'from scoped work to production for core delivery paths.',
      },
      {
        scope:
          'Drive reliability and performance improvements in a mature production stack.',
        metric: '34% fewer Sev-2/Sev-3 incidents, 29% fewer hotfixes',
        result:
          'quarter over quarter in high-use production paths.',
      },
      {
        scope:
          'Deliver roadmap commitments with product and data partners from planning through release.',
        metric: 'On-time roadmap delivery 68% -> 88%',
        result:
          'with lower spillover and stronger delivery forecast confidence.',
      },
    ],
  },
  {
    title: 'Senior .NET Software Engineer',
    company: 'Adform Lithuania',
    period: '2025',
    details: [
      {
        scope: 'Built backend services in a high-concurrency adtech environment.',
        metric: '99.95% availability during peak traffic windows',
        result:
          'to protect revenue-critical workflows.',
      },
      {
        scope:
          'Delivered mission-critical features in a large codebase under active production load.',
        metric: 'Change-failure rate 12% -> 7%',
        result:
          'across release cycles in a complex production codebase.',
      },
      {
        scope:
          'Worked within strict testing, review, and release quality expectations.',
        metric: '37% fewer regression reopens, ~11 engineer-hours recovered/sprint',
        result:
          'through stricter quality gates and reduced rework.',
      },
    ],
  },
  {
    title: 'Senior Software Engineer (.NET)',
    company: 'Ignitis Group Services Center',
    period: '2023',
    details: [
      {
        scope:
          'Refactored and maintained enterprise .NET systems supporting business operations.',
        metric: '46% fewer critical outage minutes',
        result:
          'while delivering new capabilities to internal business units.',
      },
      {
        scope: 'Extended legacy services without destabilizing live workflows.',
        metric: 'Zero unplanned downtime across two release trains',
        result:
          'while modernizing legacy services.',
      },
      {
        scope:
          'Improved maintainability in systems with complex domain and operational dependencies.',
        metric: '23% lower implementation effort per change',
        result:
          'which expanded engineering capacity for roadmap work.',
      },
    ],
  },
  {
    title: 'Software Engineer (.NET / Blockchain)',
    company: 'Super How',
    period: '2021 - 2022',
    details: [
      {
        scope:
          'Delivered end-to-end backend features in a fast-moving product environment.',
        metric: 'Sprint predictability 62% -> 84%',
        result:
          'despite frequent priority changes.',
      },
      {
        scope: 'Built blockchain integrations and supporting backend service logic.',
        metric: 'Go-live accelerated by 4 weeks',
        result:
          'for integration-dependent customer rollouts.',
      },
      {
        scope: 'Maintained predictable delivery as priorities and scope shifted.',
        metric: '28% lower scope churn',
        result:
          'through tighter technical scoping and early dependency control.',
      },
    ],
  },
  {
    title: 'Software Engineer (.NET / SQL)',
    company: 'Euromonitor International',
    period: '2018 - 2020',
    details: [
      {
        scope: 'Implemented data-heavy SQL solutions for research products.',
        metric: '41% fewer report-generation failures',
        result:
          'with higher data-pipeline consistency for research teams.',
      },
      {
        scope:
          'Delivered product modules using .NET and Angular in an established platform.',
        metric: '22% higher release throughput',
        result:
          'through cleaner integration boundaries and reusable module patterns.',
      },
      {
        scope:
          'Maintained long-lived business systems used by distributed global teams.',
        metric: '>99.9% uptime, 33% fewer business-interruption tickets',
        result:
          'for globally used internal systems.',
      },
    ],
  },
  {
    title: 'Software Engineer (C# / Unity)',
    company: 'Invenis',
    period: '2015',
    details: [
      {
        scope: 'Developed client-facing applications using C# and Unity3D.',
        metric: '100% contracted milestone scope delivered on schedule',
        result:
          'across client-facing releases.',
      },
      {
        scope:
          'Implemented application logic and UI systems for shipped project scope.',
        metric: '26% lower post-release defect backlog',
        result:
          'through tighter implementation and QA collaboration.',
      },
      {
        scope:
          'Built the delivery discipline that shaped later production engineering work.',
        metric: 'Lower defect-escape trend across later backend roles',
        result:
          'from stronger early delivery discipline.',
      },
    ],
  },
];
---

<div class="hiring-stack">
<section class="card template-notice" aria-labelledby="template-notice-heading">
  <h2 id="template-notice-heading">Template Notice</h2>
  <p>
    This hiring page is a CV/resume template built for recruiters and hiring
    managers. All quantified outcomes are illustrative placeholder examples used
    to model strong result framing, business-impact language, and decision-ready
    storytelling.
  </p>
  <p>
    World-class recipe: make each bullet answer four questions in one line:
    <strong>What was owned?</strong> <strong>What changed?</strong>{' '}
    <strong>How much did it improve?</strong> <strong>Why did the business care?</strong>
  </p>
  <p>
    Replace placeholders with verified outcomes in this order:
    <strong>revenue/cost impact</strong>, <strong>reliability impact</strong>,{' '}
    <strong>delivery speed</strong>, then <strong>scope of ownership</strong>.
    Include before/after deltas, timeframe, and operating context.
  </p>
  <p>
    Credibility rules: quantify with metrics tied to P&L or risk, keep claims
    attributable to your direct ownership, and remove generic strengths not backed
    by evidence. If a claim cannot be measured, frame it as scope, not outcome.
  </p>
</section>

<section class="mode-hero" aria-labelledby="hiring-heading">
  <div class="headline-row">
    <span class="headline-icon" aria-hidden="true"><Briefcase size={86} /></span
    >
    <h1 id="hiring-heading">
      Senior .NET backend engineer for reliable product delivery.
    </h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.hiring.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.hiring} />
      ))
    }
    <PageShareButton
      shareRole="Recruiter / Hiring Manager"
      label="Share with hiring team"
      source="hiring_hero_cta"
      shareTitle="Robertas Rudys | Recruiter / Hiring Manager"
      shareText="Sharing this profile for backend hiring review."
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Hiring for an open backend role: request the resume or schedule a short intro.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one teammate hiring for backend product engineering."
/>

<section class="card" aria-labelledby="hiring-summary">
  <h2 id="hiring-summary">Profile Snapshot</h2>
  <p>
    Senior backend engineer focused on C# and .NET with{' '}
    <span class="inline-fact">end-to-end ownership of API delivery in production environments</span>.
    Strong fit for teams that need stable execution, clear communication, and
    low-drama onboarding into existing systems.
    Work style is outcome-oriented, with delivery framed around risk reduction,
    service reliability, and predictable release quality.
  </p>
</section>

<section class="card" aria-labelledby="hiring-skills">
  <h2 id="hiring-skills">Ownership Scope</h2>
  <ul>
    <li>
      Backend platform ownership: C#, .NET, ASP.NET Core, REST APIs, service
      boundaries, release-ready delivery
    </li>
    <li>
      Data and performance: SQL modeling, query optimization, bottleneck analysis,
      production tuning
    </li>
    <li>
      Reliability work: incident triage, legacy debugging, safe refactors, operational
      hardening
    </li>
    <li>
      Delivery model: cross-functional planning, peer reviews, CI/CD-aligned implementation
    </li>
  </ul>
</section>

<style>
  .hiring-stack {
    display: grid;
    gap: 0.95rem;
  }

  .hiring-stack > section {
    margin: 0;
  }

  .template-notice {
    position: relative;
    overflow: clip;
    border: 1px solid #d9c5ff;
    background:
      radial-gradient(circle at 100% 0%, #f1e7ff 0%, transparent 42%),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--surface) 92%, #f4ecff),
        var(--surface) 60%
      );
  }

  .template-notice::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #a78bfa, #8b5cf6 38%, #7c3aed 78%);
    opacity: 0.85;
  }

  .template-notice h2 {
    color: #5b21b6;
  }
</style>

<section class="card" aria-labelledby="hiring-reliability">
  <h2 id="hiring-reliability">Production Reliability Signal</h2>
  <p>
    Delivery history includes high-concurrency production systems, legacy
    modernization without service destabilization, and ownership in environments
    where release quality is non-negotiable.
  </p>
  <p>
    Business impact is typically measured through{' '}
    incident volume, lead time to production, change-failure risk, downtime
    exposure, and cost-to-serve.
  </p>
  <p>
    Representative outcome targets in this template:{' '}
    <span class="inline-fact">-34% incident volume, -31% lead time, -18% cloud cost-to-serve, +22% release throughput, 99.95% availability</span>.
  </p>
</section>

<section class="card" aria-labelledby="hiring-experience">
  <h2 id="hiring-experience">Experience Highlights</h2>
  <p>
    Roles selected to show ownership depth in existing systems, delivery under
    production constraints, and consistent execution across product
    environments.
  </p>
  {
    hiringExperience.map((role) => (
      <article>
        <h3>{role.title}</h3>
        <p>
          {role.company} | {role.period}
        </p>
        <ul>
          {role.details.map((item) => (
            <li>
              {item.scope}{' '}
              <span class="inline-fact">{item.metric}</span>{' '}
              {item.result}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<section class="card" aria-labelledby="hiring-availability">
  <h2 id="hiring-availability">Hiring Readiness</h2>
  <ul>
    <li>Open to full-time or long-term product roles</li>
    <li>
      Remote collaboration in EU-aligned time zones{' '}
      with reliability-focused onboarding, not short-term rescue contracts
    </li>
    <li>
      Fastest evaluation path: clear first-quarter ownership scope, interview
      stages, and compensation band shared early
    </li>
    <li>
      Constraints to confirm up front: legal employment setup, expected overlap hours,
      and start-date window
    </li>
    <li>
      Strongest fit: product teams modernizing backend services with clear ownership
      boundaries and reliability and migration-heavy priorities
    </li>
  </ul>
</section>
</div>
