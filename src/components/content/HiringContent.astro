---
import { Briefcase } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';

const hiringExperience = [
  {
    title: 'Senior .NET Software Engineer',
    company: 'Product Company (EU, Remote)',
    period: '2026 - Present',
    details: [
      'Own backend services and API delivery for core product workflows.',
      'Improve service reliability and performance in an existing production stack.',
      'Ship roadmap scope with product and data stakeholders without handoff gaps.',
    ],
  },
  {
    title: 'Senior .NET Software Engineer',
    company: 'Adform Lithuania',
    period: '2025',
    details: [
      'Built backend services in a high-concurrency adtech environment.',
      'Delivered mission-critical features in a large established codebase.',
      'Worked under mature testing and release reliability standards.',
    ],
  },
  {
    title: 'Senior Software Engineer (.NET)',
    company: 'Ignitis Group Services Center',
    period: '2023',
    details: [
      'Refactored and maintained enterprise .NET systems used by internal business teams.',
      'Extended legacy services while preserving production stability.',
      'Reduced maintenance friction in systems with complex operational dependencies.',
    ],
  },
  {
    title: 'Software Engineer (.NET / Blockchain)',
    company: 'Super How',
    period: '2021 - 2022',
    details: [
      'Delivered end-to-end backend features in a fast-moving product setting.',
      'Built blockchain application integrations and service logic.',
      'Shipped under changing product constraints while keeping delivery predictable.',
    ],
  },
  {
    title: 'Software Engineer (.NET / SQL)',
    company: 'Euromonitor International',
    period: '2018 - 2020',
    details: [
      'Implemented data-heavy SQL solutions for research products.',
      'Delivered product modules with .NET and Angular.',
      'Maintained long-lived business systems used by global teams.',
    ],
  },
  {
    title: 'Software Engineer (C# / Unity)',
    company: 'Invenis',
    period: '2015',
    details: [
      'Developed interactive applications using C# and Unity3D.',
      'Implemented gameplay logic and UI systems for client projects.',
      'Built delivery discipline in early professional engineering work.',
    ],
  },
];
---

<section class="mode-hero" aria-labelledby="hiring-heading">
  <div class="headline-row">
    <span class="headline-icon" aria-hidden="true"><Briefcase size={86} /></span
    >
    <h1 id="hiring-heading">
      Senior .NET engineer for stable, long-term product delivery.
    </h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.hiring.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.hiring} />
      ))
    }
    <PageShareButton
      shareRole="Recruiter / Hiring Manager"
      label="Share with hiring team"
      source="hiring_hero_cta"
      shareTitle="Robertas Rudys | Recruiter / Hiring Manager"
      shareText="Sharing this profile for backend hiring review."
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Hiring for an open backend role: request the resume or book a short intro.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one teammate hiring for backend product engineering."
/>

<section class="card" aria-labelledby="hiring-summary">
  <h2 id="hiring-summary">Profile Snapshot</h2>
  <p>
    Senior backend engineer focused on C# and .NET with direct ownership of API
    delivery in existing product environments. Strong fit for teams that need{' '}
    <span class="inline-fact">stable execution and clear communication from discovery through production rollout</span>,
    with <span class="inline-fact">long-term backend ownership in production systems</span> and a{' '}
    <span class="inline-fact">track record across product organizations</span>.
  </p>
</section>

<section class="card" aria-labelledby="hiring-skills">
  <h2 id="hiring-skills">Core Technical Scope</h2>
  <ul>
    <li>
      Backend ownership:{' '}
      <span class="inline-fact">
        C#, .NET, ASP.NET Core, REST APIs, service boundaries, release-ready
        delivery
      </span>
    </li>
    <li>
      Data and performance: SQL modeling, query optimization, bottleneck
      analysis, production tuning
    </li>
    <li>
      Reliability work: incident triage, legacy debugging, safe refactors,
      operational hardening
    </li>
    <li>
      Delivery model: cross-functional planning, peer reviews, CI/CD-aligned
      implementation
    </li>
  </ul>
</section>

<section class="card" aria-labelledby="hiring-experience">
  <h2 id="hiring-experience">Experience Highlights</h2>
  {
    hiringExperience.map((role) => (
      <article>
        <h3>{role.title}</h3>
        <p>
          {role.company} | {role.period}
        </p>
        <ul>
          {role.details.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<section class="card" aria-labelledby="hiring-availability">
  <h2 id="hiring-availability">Availability</h2>
  <ul>
    <li>Open to full-time or long-term product roles</li>
    <li>
      Remote collaboration in EU-aligned time zones{' '}
      <span class="inline-fact">with reliability-focused onboarding, not short-term rescue contracts</span>
    </li>
    <li>
      Best hiring path:{' '}
      <span class="inline-fact">
        role scope for first 90 days, interview stages, and compensation band
        shared early
      </span>
    </li>
    <li>
      Constraints to confirm up front: legal employment setup, expected overlap
      hours, and start date window
    </li>
    <li>
      Team fit: product teams modernizing existing backend services with clear
      ownership lines{' '}
      <span class="inline-fact">where reliability and migration-heavy contexts are a priority</span>
    </li>
  </ul>
</section>
