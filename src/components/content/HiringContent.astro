---
import { Briefcase } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';

const hiringExperience = [
  {
    title: 'Senior .NET Software Engineer',
    company: 'Product Company (EU, Remote)',
    period: '2026 - Present',
    details: [
      'Owns backend services and APIs supporting core product workflows.',
      'Improves performance and production reliability in mature systems.',
      'Delivers roadmap work with product and data stakeholders.',
    ],
  },
  {
    title: 'Senior .NET Software Engineer',
    company: 'Adform Lithuania',
    period: '2025',
    details: [
      'Built backend services in a high-concurrency production environment.',
      'Delivered mission-critical features in large existing codebases.',
      'Worked within mature testing and reliability standards.',
    ],
  },
  {
    title: 'Senior Software Engineer (.NET)',
    company: 'Ignitis Group Services Center',
    period: '2023',
    details: [
      'Refactored and maintained enterprise .NET systems used by business teams.',
      'Extended legacy code while preserving stability and maintainability.',
      'Improved maintainability in systems with complex operational context.',
    ],
  },
  {
    title: 'Software Engineer (.NET / Blockchain)',
    company: 'Super How',
    period: '2021 - 2022',
    details: [
      'Delivered end-to-end features in a fast-moving product setting.',
      'Built decentralized application integrations and service logic.',
      'Shipped practical outcomes under changing product constraints.',
    ],
  },
  {
    title: 'Software Engineer (.NET / SQL)',
    company: 'Euromonitor International',
    period: '2018 - 2020',
    details: [
      'Implemented data-heavy SQL solutions for research products.',
      'Delivered product modules with .NET and Angular.',
      'Maintained long-lived business systems used across global teams.',
    ],
  },
  {
    title: 'Software Engineer (C# / Unity)',
    company: 'Invenis',
    period: '2015',
    details: [
      'Developed interactive applications using C# and Unity3D.',
      'Implemented gameplay logic and UI systems for client projects.',
      'Built delivery discipline in early professional engineering work.',
    ],
  },
];
---

<section aria-labelledby="hiring-heading" class="mode-hero">
  <div class="headline-row">
    <span aria-hidden="true" class="headline-icon"><Briefcase size={86} /></span
    >
    <h1 id="hiring-heading">
      Senior .NET engineer for stable, long-term product delivery.
    </h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.hiring.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.hiring} />
      ))
    }
    <PageShareButton
      label="Share with hiring team"       shareRole="Recruiter / Hiring Manager"
      shareText="Sharing this profile for backend hiring review."       shareTitle="Robertas Rudys | Recruiter / Hiring Manager"       source="hiring_hero_cta"
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Hiring for a role now: request the resume or book a short intro.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one teammate hiring for backend product engineering."
/>

<section aria-labelledby="hiring-fit-snapshot" class="card">
  <h2 id="hiring-fit-snapshot">Fast Fit Snapshot</h2>
  <ul>
    <li>
      Professional .NET engineer since 2015 with backend/API delivery focus
    </li>
    <li>Best fit: product teams modernizing existing backend services</li>
    <li>
      Availability: full-time or long-term product roles, remote EU overlap
    </li>
    <li>
      Core scope: C#, .NET, ASP.NET Core, SQL performance, reliability work
    </li>
  </ul>
</section>

<section aria-labelledby="hiring-experience" class="card">
  <h2 id="hiring-experience">Experience Timeline</h2>
  {
    hiringExperience.map((role, index) => (
      <details class="timeline-role" open={index === 0}>
        <summary class="timeline-role__summary">
          <span class="timeline-role__title">{role.title}</span>
          <span class="timeline-role__meta">
            {role.company} | {role.period}
          </span>
        </summary>
        <ul>
          {role.details.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </details>
    ))
  }
</section>

<section aria-labelledby="hiring-next-step" class="card">
  <h2 id="hiring-next-step">Next Step To Hire Fast</h2>
  <ol>
    <li>
      Use <strong>Request Resume</strong> with role title, team setup, timezone expectations,
      and compensation band.
    </li>
    <li>
      Use <strong>Schedule Intro</strong> with a preferred time window and interview
      format.
    </li>
    <li>
      Initial screening should confirm role fit, onboarding constraints, and
      first-quarter ownership scope.
    </li>
  </ol>
  <p>
    If you include these items in first contact, I can confirm fit and process
    readiness quickly.
  </p>
</section>

<details aria-labelledby="hiring-extra-summary" class="card">
  <summary id="hiring-extra-summary"
    ><strong>Additional Hiring Context</strong></summary
  >
  <section aria-labelledby="hiring-context-fit">
    <h3 id="hiring-context-fit">Best Team Fit</h3>
    <ul>
      <li>Product teams modernizing existing backend services</li>
      <li>Organizations prioritizing reliability and predictable delivery</li>
      <li>Teams that value ownership and sustainable engineering pace</li>
    </ul>
    <h3>Known Misfit Conditions</h3>
    <ul>
      <li>Roles that require relocation or non-EU timezone-first overlap</li>
      <li>Processes that hide compensation until late-stage interviews</li>
      <li>Undefined ownership boundaries in the first quarter</li>
    </ul>
  </section>
  <section aria-labelledby="hiring-context-proof">
    <h3 id="hiring-context-proof">Evidence Boundary</h3>
    <ul>
      <li>
        Public profile highlights ownership scope and technical context, not
        confidential internal KPIs.
      </li>
      <li>
        Role history is intentionally conservative with no inflated leadership
        claims.
      </li>
      <li>
        If you require quantified outcomes, ask for role-level examples during
        interview discussion.
      </li>
    </ul>
    <h3>Not Verified On-Page</h3>
    <ul>
      <li>Quantified production impact deltas</li>
      <li>Public references from former managers or teams</li>
      <li>Exact legal/employment setup and start-date commitment</li>
    </ul>
  </section>
</details>

<style>
  .timeline-role + .timeline-role {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .timeline-role__summary {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    list-style: none;
    min-height: 44px;
    justify-content: center;
  }

  .timeline-role__summary::-webkit-details-marker {
    display: none;
  }

  .timeline-role__summary::after {
    content: 'Show details';
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .timeline-role[open] .timeline-role__summary::after {
    content: 'Hide details';
  }

  .timeline-role__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .timeline-role__meta {
    color: var(--muted);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .timeline-role ul {
    margin-top: 0.65rem;
  }

  @media (orientation: landscape) and (max-width: 932px) {
    .timeline-role__title {
      font-size: 0.96rem;
    }

    .timeline-role__meta {
      font-size: 0.88rem;
    }
  }
</style>
