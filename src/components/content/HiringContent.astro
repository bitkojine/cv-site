---
import { Briefcase } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';
import { hiringEvidenceData } from '../../data/hiring-evidence.mts';

const allEvidence = [
  ...hiringEvidenceData.caseStudies.map((item) => ({
    ...item,
    type: 'case-study' as const,
  })),
  ...hiringEvidenceData.decisionRecords.map((item) => ({
    ...item,
    type: 'decision' as const,
  })),
  ...hiringEvidenceData.productionPatterns.map((item) => ({
    ...item,
    type: 'pattern' as const,
  })),
];

const evidenceById = new Map(allEvidence.map((item) => [item.id, item]));

const seniorSignals = hiringEvidenceData.seniorSignals.reduce<
  Array<
    (typeof hiringEvidenceData.seniorSignals)[number] & {
      evidence: (typeof allEvidence)[number];
    }
  >
>((acc, signal) => {
  const evidence = evidenceById.get(signal.evidenceRef);
  if (!evidence) {
    return acc;
  }
  acc.push({ ...signal, evidence });
  return acc;
}, []);

const previewEvidence = [
  ...hiringEvidenceData.caseStudies.slice(0, 2),
  ...hiringEvidenceData.decisionRecords.slice(0, 1),
  ...hiringEvidenceData.productionPatterns.slice(0, 1),
];

const toTitleCase = (value: string) =>
  value.charAt(0).toUpperCase() + value.slice(1);

const evidenceHref = (id: string) => `/hiring/evidence#evidence-${id}`;
---

<section aria-labelledby="hiring-heading" class="mode-hero">
  <div class="headline-row">
    <span aria-hidden="true" class="headline-icon"><Briefcase size={86} /></span
    >
    <h1 id="hiring-heading">
      Senior backend engineer for teams that need scope ownership, reliable
      delivery, and tradeoff-aware decisions.
    </h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.hiring.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.hiring} />
      ))
    }
    <a
      class="cta-secondary"
      data-cta="View Hiring Pack"
      data-cta-mode={visitorModes.hiring}
      href="/hiring/pack"
    >
      View Evidence Pack
    </a>
    <PageShareButton
      label="Share with hiring team"
      shareRole="Recruiter / Hiring Manager"
      shareText="Sharing this profile for backend hiring review."
      shareTitle="Robertas Rudys | Recruiter / Hiring Manager"
      source="hiring_hero_cta"
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    If you want to assess me, use the evidence below and ask me to teach the
    decision logic behind real tradeoffs in production scenarios.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one teammate hiring for backend product engineering."
/>

<section aria-labelledby="hiring-fit-summary" class="card">
  <h2 id="hiring-fit-summary">60-Second Fit Summary</h2>
  <ul>
    <li>
      <strong>Role focus:</strong>
      {hiringEvidenceData.fitSummary.roleFocus}
    </li>
    <li>
      <strong>Experience:</strong>
      {hiringEvidenceData.fitSummary.yearsExperience}
    </li>
    <li>
      <strong>Domains:</strong>
      {hiringEvidenceData.fitSummary.domains.join('; ')}
    </li>
    <li>
      <strong>Collaboration style:</strong>
      {hiringEvidenceData.fitSummary.collaborationStyle}
    </li>
    <li>
      <strong>Timezone overlap:</strong>
      {hiringEvidenceData.fitSummary.timezoneOverlap}
    </li>
    <li>
      <strong>Availability:</strong>
      {hiringEvidenceData.fitSummary.availability}
    </li>
  </ul>
  <p>
    <strong>How I interview:</strong>
    {hiringEvidenceData.interviewPolicy.statement}
  </p>
  <p>{hiringEvidenceData.interviewPolicy.prompt}</p>
  <p>
    Proof standard: if I truly understand a system, I can teach it clearly. Weak
    understanding shows up as vague, tool-first explanations.
  </p>
  <p>
    Start here:
    <a href="/hiring/evidence">Evidence library</a>
    for case studies, decision records, and production patterns.
  </p>
</section>

<section aria-labelledby="hiring-learn" class="card">
  <h2 id="hiring-learn">What You Will Learn Here</h2>
  <ul>
    <li>How to assess senior backend capability through decision evidence</li>
    <li>How to run interviews around tradeoffs, risk, and delivery context</li>
    <li>How reliability and incident behavior reflect engineering maturity</li>
    <li>How to distinguish tool familiarity from ownership-level judgment</li>
  </ul>
</section>

<section aria-labelledby="hiring-signals" class="card">
  <h2 id="hiring-signals">Senior Signals</h2>
  <p>
    Claims are paired with concrete artifacts. Open any signal to review
    context, decision, tradeoffs, and outcomes.
  </p>
  <div class="signals-grid">
    {
      seniorSignals.map((signal) => (
        <article class="signal-tile">
          <p class="signal-head">
            <strong>{signal.title}</strong>
            <span>{signal.claim}</span>
          </p>
          <div class="signal-proof">
            <p>
              <strong>Context:</strong> {signal.evidence.context}
            </p>
            <p>
              <strong>Decision:</strong> {signal.evidence.decision}
            </p>
            <p>
              <strong>Tradeoffs:</strong>
              {signal.evidence.tradeoffs.join('; ')}
            </p>
            <p>
              <strong>Outcome:</strong> {signal.evidence.outcome}
            </p>
            <p>
              <strong>What I would improve:</strong>
              {signal.evidence.learnings[0]}
            </p>
            <p class="signal-themes">
              {signal.themes.map((theme) => toTitleCase(theme)).join(' · ')}
            </p>
            <a
              data-signal-artifact-link
              data-evidence-id={signal.evidence.id}
              data-evidence-type={signal.evidence.type}
              href={evidenceHref(signal.evidence.id)}
            >
              Open proof artifact
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section aria-labelledby="hiring-evidence-preview" class="card">
  <h2 id="hiring-evidence-preview">Evidence Library Preview</h2>
  <p>
    Review the full library at <a href="/hiring/evidence">/hiring/evidence</a>
    with filters for reliability, performance, architecture, delivery, and data.
  </p>
  <ul class="evidence-preview-list">
    {
      previewEvidence.map((item) => (
        <li>
          <article>
            <h3>{item.title}</h3>
            <p>{item.situation}</p>
            <p>
              <strong>Outcome:</strong>
              {item.outcome}
            </p>
            <a href={evidenceHref(item.id)}>Read full record</a>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<section aria-labelledby="hiring-working-style" class="card">
  <h2 id="hiring-working-style">Working Style And Process Filters</h2>
  <h3>How I De-Risk Delivery</h3>
  <ul>
    <li>Align scope to business risk before implementation starts</li>
    <li>Make tradeoffs explicit with product and engineering stakeholders</li>
    <li>Instrument reliability feedback into each delivery cycle</li>
    <li>Prefer reversible rollouts for high-impact changes</li>
  </ul>
  <h3>Interview Bypass Pack</h3>
  <p>
    Share <a href="/hiring/pack">/hiring/pack</a> for a concise recruiter-friendly
    brief and print-ready PDF export.
  </p>
  <h3>Misfit Filter</h3>
  <p>
    If your process depends on trivia screening (tool checklists, definition
    quizzes, or language gotchas) and not real decision discussion, we are
    unlikely to be a strong fit.
  </p>
  <h3>Higher-Signal Interview Prompts</h3>
  <ul>
    <li>Talk me through a system you owned and the tradeoffs you made</li>
    <li>How do you approach reliability and incidents in production?</li>
    <li>How do you deliver under hard constraints and changing context?</li>
  </ul>
</section>

<style>
  .signals-grid {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.75rem;
  }

  .signal-tile {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem;
    background: color-mix(in oklab, var(--surface) 92%, var(--accent-soft));
  }

  .signal-head {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .signal-head span {
    color: var(--muted);
  }

  .signal-proof {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.45rem;
  }

  .signal-proof p {
    margin: 0;
  }

  .signal-themes {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .evidence-preview-list {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.8rem;
  }

  .evidence-preview-list article h3 {
    margin: 0;
    font-size: 1rem;
  }

  .evidence-preview-list article p {
    margin: 0.45rem 0 0;
  }

  .evidence-preview-list article a {
    display: inline-flex;
    margin-top: 0.5rem;
  }

  @media (min-width: 760px) {
    .signals-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  (() => {
    const reportEvent = (eventName, props = {}) => {
      const sendEvent = window.cvReportEvent ?? window.cvTrack;
      if (typeof sendEvent === 'function') {
        sendEvent(eventName, props);
      }
    };

    const bindSignalTracking = () => {
      document
        .querySelectorAll('[data-signal-artifact-link]')
        .forEach((linkElement) => {
          if (!(linkElement instanceof HTMLAnchorElement)) return;
          if (linkElement.dataset.boundSignalLink === '1') return;
          linkElement.dataset.boundSignalLink = '1';
          linkElement.addEventListener('click', () => {
            reportEvent('evidence_opened', {
              source: 'hiring_signals',
              evidence_id: linkElement.dataset.evidenceId || 'unknown',
              evidence_type: linkElement.dataset.evidenceType || 'unknown',
            });
          });
        });
    };

    document.addEventListener('astro:page-load', bindSignalTracking);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindSignalTracking, {
        once: true,
      });
    } else {
      bindSignalTracking();
    }
  })();
</script>
