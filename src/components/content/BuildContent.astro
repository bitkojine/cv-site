---
import { Cog } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import SectionLastUpdated from '../SectionLastUpdated.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';
---

<section aria-labelledby="build-heading" class="mode-hero">
  <div class="headline-row">
    <span aria-hidden="true" class="headline-icon"><Cog size={86} /></span>
    <h1 id="build-heading">Backend execution support for product teams.</h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.build.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.build} />
      ))
    }
    <PageShareButton
      label="Share With Founder"
      shareRole="Founder / Operator"
      shareText="Sharing this builder profile for execution support."
      shareTitle="Robertas Rudys | Founder / Operator"
      source="build_hero_cta"
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Send one bottleneck, timeline, and expected outcome to start.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one founder or operator who needs hands-on execution support."
/>

<section aria-labelledby="build-summary" class="card">
  <h2 id="build-summary">Execution Snapshot</h2>
  <SectionLastUpdated />
  <p>
    Product execution support for teams that need speed now, technical leverage
    this quarter, and clear ownership from discovery to shipped output in
    existing codebases.
  </p>
</section>

<section aria-labelledby="build-offers" class="card">
  <h2 id="build-offers">Offers</h2>
  <ul>
    <li>
      Backend Stability Sprint (5 business days): one production reliability
      bottleneck, scoped fixes, and short handoff note.
    </li>
    <li>
      Feature Delivery Block (10 business days): one backend feature from scope
      lock to shipped implementation.
    </li>
    <li>
      Legacy Refactor Pass (2-3 weeks): targeted cleanup for the
      highest-friction backend surfaces.
    </li>
  </ul>
</section>

<section aria-labelledby="build-start" class="card">
  <h2 id="build-start">How Engagement Starts</h2>
  <ol>
    <li>
      Use the <strong>Work Together</strong> CTA with project context, current bottleneck,
      expected outcome, and timeline.
    </li>
    <li>
      Initial response confirms fit/no-fit, likely engagement shape, and
      earliest available start window.
    </li>
    <li>
      Work begins only after scope lock, named owner, and acceptance criteria
      are agreed.
    </li>
  </ol>
  <h3>Minimum Inputs To Start</h3>
  <ul>
    <li>One prioritized bottleneck with business impact context</li>
    <li>Repository and environment access needed to ship safely</li>
    <li>One accountable product/engineering owner for sign-off</li>
  </ul>
  <h3>Not A Fit</h3>
  <ul>
    <li>Open-ended advisory without a defined shipping target</li>
    <li>Projects that cannot provide owner-level acceptance decisions</li>
    <li>Teams expecting broad rewrites inside a short sprint window</li>
  </ul>
</section>
