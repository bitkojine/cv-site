---
import { Cog } from '@lucide/astro';
import EmailCta from '../EmailCta.astro';
import PageShareButton from '../PageShareButton.astro';
import PeerSharePrompt from '../PeerSharePrompt.astro';
import SectionLastUpdated from '../SectionLastUpdated.astro';
import { roleEmailCtas, visitorModes } from '../../lib/email-drafts.mts';

const buildCaseStudies = [
  {
    title: 'Reliability Recovery In Existing APIs',
    outcomes: [
      'Found failure points in mature backend modules without full rewrites.',
      'Prioritized fixes that reduced release risk while roadmap work continued.',
      'Clarified service boundaries to lower maintenance cost.',
    ],
  },
  {
    title: 'Delivery Unblock For Product Roadmaps',
    outcomes: [
      'Shipped high-priority backend changes in systems with technical debt.',
      'Improved query behavior to reduce performance bottlenecks.',
      'Kept implementation scope narrow and outcome-focused.',
    ],
  },
  {
    title: 'Architecture Plus Hands-On Execution',
    outcomes: [
      'Provided practical architecture direction tied to implementation.',
      'Reduced founder/operator coordination overhead in decisions.',
      'Left clean handoff points for internal follow-on contributors.',
    ],
  },
];
---

<section aria-labelledby="build-heading" class="mode-hero">
  <div class="headline-row">
    <span aria-hidden="true" class="headline-icon"><Cog size={86} /></span>
    <h1 id="build-heading">Ship faster with focused technical execution.</h1>
  </div>
  <div class="cta-row">
    {
      roleEmailCtas.build.map((cta) => (
        <EmailCta cta={cta} mode={visitorModes.build} />
      ))
    }
    <a
      class="cta-secondary"
      data-cta="Open Website System"
      data-cta-mode={visitorModes.build}
      href="/operating-system"
    >
      Open Website System
    </a>
    <PageShareButton
      label="Share with founder"
      shareRole="Founder / Operator"
      shareText="Sharing this builder profile for execution support."
      shareTitle="Robertas Rudys | Founder / Operator"
      source="build_hero_cta"
    />
  </div>
  <noscript>
    <p class="cta-note">
      Email links require JavaScript. Please enable JavaScript to contact me.
    </p>
  </noscript>
  <p class="cta-note">
    Need execution support now: send one bottleneck, timeline, and expected
    outcome to start.
  </p>
</section>

<PeerSharePrompt
  message="Forward this profile to one founder or operator who needs hands-on execution support."
/>

<section aria-labelledby="build-summary" class="card">
  <h2 id="build-summary">Execution Snapshot</h2>
  <SectionLastUpdated />
  <p>
    Product execution support for teams that need speed now, technical leverage
    this quarter, and clear ownership from discovery to shipped output in
    existing codebases.
  </p>
</section>

<section aria-labelledby="build-learn" class="card">
  <h2 id="build-learn">What You Will Learn Here</h2>
  <SectionLastUpdated />
  <ul>
    <li>How to scope backend work for speed without sacrificing safety</li>
    <li>
      How to choose fixes that reduce risk while roadmap delivery continues
    </li>
    <li>How to run short execution blocks with clear acceptance boundaries</li>
    <li>How to convert technical bottlenecks into business-level decisions</li>
  </ul>
</section>

<section aria-labelledby="build-fit" class="card">
  <h2 id="build-fit">Where I Add Leverage Fast</h2>
  <SectionLastUpdated />
  <ul>
    <li>Backend/API bottlenecks blocking product iteration</li>
    <li>Legacy architecture friction slowing delivery cadence</li>
    <li>Reliability incidents pulling focus from roadmap work</li>
    <li>Teams needing both execution and technical decision support</li>
  </ul>
</section>

<section aria-labelledby="build-cases" class="card">
  <h2 id="build-cases">Case Study Snapshots</h2>
  {
    buildCaseStudies.map((study) => (
      <article>
        <h3>{study.title}</h3>
        <ul>
          {study.outcomes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<section aria-labelledby="build-shapes" class="card">
  <h2 id="build-shapes">Collaboration Shapes</h2>
  <ul>
    <li>Freelance</li>
    <li>Contract</li>
    <li>Fractional engineering</li>
    <li>Long-term partnership / cofounder path</li>
  </ul>
</section>

<section aria-labelledby="build-offers" class="card">
  <h2 id="build-offers">Current Offer Menu</h2>
  <ul>
    <li>
      Backend Stability Sprint (5 business days): one production reliability
      bottleneck, scoped fixes, and short handoff note.
    </li>
    <li>
      Feature Delivery Block (10 business days): one backend feature from scope
      lock to shipped implementation.
    </li>
    <li>
      Legacy Refactor Pass (2-3 weeks): targeted cleanup for the
      highest-friction backend surfaces.
    </li>
  </ul>
</section>

<section aria-labelledby="build-model" class="card">
  <h2 id="build-model">Engagement Model</h2>
  <ul>
    <li>Start with one constrained bottleneck and ship first</li>
    <li>Work in short blocks with explicit outcomes and constraints</li>
    <li>Close each block with clear handoff and next-step options</li>
  </ul>
</section>

<section aria-labelledby="build-start" class="card">
  <h2 id="build-start">How Engagement Starts</h2>
  <ol>
    <li>
      Use the <strong>Work Together</strong> CTA with project context, current bottleneck,
      expected outcome, and timeline.
    </li>
    <li>
      Initial response confirms fit/no-fit, likely engagement shape, and
      earliest available start window.
    </li>
    <li>
      Work begins only after scope lock, named owner, and acceptance criteria
      are agreed.
    </li>
  </ol>
  <h3>Minimum Inputs To Start</h3>
  <ul>
    <li>One prioritized bottleneck with business impact context</li>
    <li>Repository and environment access needed to ship safely</li>
    <li>One accountable product/engineering owner for sign-off</li>
  </ul>
  <h3>Not A Fit</h3>
  <ul>
    <li>Open-ended advisory without a defined shipping target</li>
    <li>Projects that cannot provide owner-level acceptance decisions</li>
    <li>Teams expecting broad rewrites inside a short sprint window</li>
  </ul>
</section>

<section aria-labelledby="build-proof" class="card">
  <h2 id="build-proof">Proof and Constraint Policy</h2>
  <ul>
    <li>
      No fake case studies: public examples stay qualitative unless metrics can
      be shared responsibly.
    </li>
    <li>
      Delivery trust is built through shipped output, constrained scope, and
      handoff artifacts per block.
    </li>
    <li>
      If you need hard metrics before engagement, request measurable baseline
      and success definitions in kickoff.
    </li>
  </ul>
  <h3>Observable Facts On This Page</h3>
  <ul>
    <li>
      Offer packaging has explicit duration windows (5 days, 10 days, 2-3 weeks)
    </li>
    <li>
      Start workflow requires scope lock, named owner, and acceptance criteria
    </li>
    <li>
      Case framing is constrained to reliability, bottleneck removal, and
      handoff
    </li>
  </ul>
  <h3>Not Verified On-Page</h3>
  <ul>
    <li>Before/after metric deltas for specific client outcomes</li>
    <li>Price ranges for each offer package</li>
    <li>Public artifact links proving delivered outputs</li>
  </ul>
</section>
