---
import 'github-markdown-css/github-markdown.css';
import '../styles/global.css';
import { cvData } from '../data/cv.mts';
import { BUILD_VERSION } from '../lib/build-version.mts';

interface Props {
  title?: string;
  description?: string;
}

const {
    title = 'Robertas Rudys',
    description = 'Resume and writing by Robertas Rudys.',
  } = Astro.props,
  currentYear = Number(
    new Intl.DateTimeFormat('lt-LT', {
      timeZone: 'Europe/Vilnius',
      year: 'numeric',
    }).format(new Date())
  ),
  { personalInfo, coreSkills, experience, independentProjects } = cvData;

function toIsoMonth(value: string) {
  return value.length === 4 ? `${value}-01` : value;
}

function toSortableMonth(value: string) {
  const normalized = toIsoMonth(value),
    [year, month] = normalized.split('-').map(Number);
  return year * 100 + month;
}

const experienceTimeline = [...experience, ...independentProjects].sort(
    (a, b) => toSortableMonth(b.startDate) - toSortableMonth(a.startDate)
  ),
  knowsAbout = coreSkills.flatMap((skill) =>
    skill.value
      .split(',')
      .map((entry) => entry.trim())
      .filter(Boolean)
  ),
  jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': 'https://robertasrudys.com/#person',
        name: personalInfo.name,
        jobTitle: personalInfo.title,
        description,
        url: 'https://robertasrudys.com',
        email: personalInfo.contact.email,
        address: {
          '@type': 'PostalAddress',
          addressLocality: personalInfo.contact.location,
        },
        sameAs: [
          'https://github.com/bitkojine',
          'https://www.linkedin.com/in/robertasr/',
        ],
        knowsAbout,
      },
      {
        '@type': 'ItemList',
        '@id': 'https://robertasrudys.com/#experience',
        name: 'Professional Experience',
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        numberOfItems: experienceTimeline.length,
        itemListElement: experienceTimeline.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Role',
            roleName: item.title,
            startDate: toIsoMonth(item.startDate),
            ...(item.endDate ? { endDate: toIsoMonth(item.endDate) } : {}),
            worksFor: {
              '@type': 'Organization',
              name: item.company,
            },
            description: item.description.join(' '),
          },
        })),
      },
    ],
  };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width, initial-scale=1, viewport-fit=cover"
      name="viewport"
    />
    <meta content="light" name="color-scheme" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <link href={new URL(Astro.url.pathname, Astro.site)} rel="canonical" />
    <meta content={personalInfo.name} name="author" />
    <meta content="index, follow" name="robots" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="profile" property="og:type" />
    <meta content={new URL(Astro.url.pathname, Astro.site)} property="og:url" />
    <meta content={new URL('og-image.png', Astro.site)} property="og:image" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={new URL('og-image.png', Astro.site)} name="twitter:image" />
    <script set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main class="page-shell" id="main-content" tabindex="-1">
      <nav aria-label="Site navigation" class="page-topnav">
        <a class="page-home-link" href="/">Home</a>
      </nav>
      <article class="markdown-body">
        <slot />
        <footer aria-label="Site footer" class="site-footer-note">
          <p>
            &copy; {currentYear} Robertas Rudys. All rights reserved.
            <span class="build-version">Build {BUILD_VERSION}</span>
          </p>
        </footer>
      </article>
    </main>
  </body>
</html>
