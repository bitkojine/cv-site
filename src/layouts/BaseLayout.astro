---
import 'github-markdown-css/github-markdown.css';
import '../styles/global.css';
import cvData from '../data/cv.json';
import { BUILD_VERSION } from '../lib/build-version.mts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Robertas Rudys',
  description = 'Resume and writing by Robertas Rudys.',
} = Astro.props;
const currentYear = new Date().getFullYear();
const { personalInfo, coreSkills, experience, independentProjects } = cvData;

function toIsoMonth(value: string) {
  return value.length === 4 ? `${value}-01` : value;
}

function toSortableMonth(value: string) {
  const normalized = toIsoMonth(value);
  const [year, month] = normalized.split('-').map(Number);
  return year * 100 + month;
}

const experienceTimeline = [...experience, ...independentProjects].sort(
  (a, b) => toSortableMonth(b.startDate) - toSortableMonth(a.startDate)
);
const knowsAbout = coreSkills.flatMap((skill) =>
  skill.value
    .split(',')
    .map((entry) => entry.trim())
    .filter(Boolean)
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://robertasrudys.com/#person',
      name: personalInfo.name,
      jobTitle: personalInfo.title,
      description,
      url: 'https://robertasrudys.com',
      email: personalInfo.contact.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: personalInfo.contact.location,
      },
      sameAs: [
        'https://github.com/bitkojine',
        'https://www.linkedin.com/in/robertasr/',
      ],
      knowsAbout,
    },
    {
      '@type': 'ItemList',
      '@id': 'https://robertasrudys.com/#experience',
      name: 'Professional Experience',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: experienceTimeline.length,
      itemListElement: experienceTimeline.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Role',
          roleName: item.title,
          startDate: toIsoMonth(item.startDate),
          ...(item.endDate ? { endDate: toIsoMonth(item.endDate) } : {}),
          worksFor: {
            '@type': 'Organization',
            name: item.company,
          },
          description: item.description.join(' '),
        },
      })),
    },
  ],
};
---

<!-- Intent: render every page like a plain Markdown document with minimal structure and styling. --><!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="author" content={personalInfo.name} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('og-image.png', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main class="page-shell" id="main-content" tabindex="-1">
      <nav class="page-topnav" aria-label="Site navigation">
        <a class="page-home-link" href="/">Home</a>
      </nav>
      <article class="markdown-body">
        <slot />
        <footer class="site-footer-note" aria-label="Site footer">
          <p>
            &copy; {currentYear} Robertas Rudys. All rights reserved.
            <span class="build-version"> | Build {BUILD_VERSION}</span>
          </p>
        </footer>
      </article>
    </main>
  </body>
</html>
