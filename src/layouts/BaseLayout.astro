---
import 'github-markdown-css/github-markdown.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Robertas Rudys',
  description = 'Resume and writing by Robertas Rudys.',
} = Astro.props;
const currentYear = new Date().getFullYear();
---

<!-- Intent: render every page like a plain Markdown document with minimal structure and styling. --><!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main class="page-shell" id="main-content" tabindex="-1">
      <article class="markdown-body">
        <slot />
        <footer class="site-footer-note" aria-label="Privacy note">
          <p>
            I clicked enough cookies in Cookie Clicker; this site uses none.
          </p>
          <p>&copy; {currentYear} Robertas Rudys. All rights reserved.</p>
          <p>As if AI web scrapers care, lmao.</p>
        </footer>
      </article>
    </main>
  </body>
</html>
