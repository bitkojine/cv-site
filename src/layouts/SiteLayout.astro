---
import { ClientRouter } from 'astro:transitions';
import { House } from '@lucide/astro';
import '../styles/global.css';
import RoleClientEnhancements from '../components/RoleClientEnhancements.astro';
import LiveBuildBadge from '../components/LiveBuildBadge.astro';
import SelfReferenceNote from '../components/SelfReferenceNote.astro';
import { resolveEchoNote } from '../data/echo-notes.mts';
import { BUILD_VERSION } from '../lib/build-version.mts';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  roleLabel?: string;
  schemaType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  schemaExtras?: Record<string, unknown>;
  ogType?: 'website' | 'profile';
  showBuildVersion?: boolean;
  showLiveBuildBadge?: boolean;
}

const {
    title,
    description,
    canonicalPath,
    roleLabel,
    schemaType = 'WebPage',
    schemaExtras = {},
    ogType = 'website',
    showBuildVersion = true,
    showLiveBuildBadge = true,
  } = Astro.props,
  canonicalUrl = new URL(canonicalPath, Astro.site),
  isHomePage = canonicalPath === '/',
  siteName = 'Robertas Rudys',
  currentYear = Number(
    new Intl.DateTimeFormat('lt-LT', {
      timeZone: 'Europe/Vilnius',
      year: 'numeric',
    }).format(new Date())
  ),
  echoNote = resolveEchoNote(canonicalPath),
  structuredData = {
    '@context': 'https://schema.org',
    '@type': schemaType,
    name: title,
    description,
    url: canonicalUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: siteName,
      url: new URL('/', Astro.site),
    },
    ...(roleLabel
      ? {
          audience: {
            '@type': 'Audience',
            audienceType: roleLabel,
          },
        }
      : {}),
    ...schemaExtras,
  };

const pageDensity =
  canonicalPath === '/'
    ? 'hero'
    : canonicalPath === '/hiring/evidence' || canonicalPath.startsWith('/blog/')
      ? 'dense'
      : 'default';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width, initial-scale=1, viewport-fit=cover"
      name="viewport"
    />
    <title>{title}</title>
    <meta content={description} name="description" />
    <link href={canonicalUrl} rel="canonical" />
    <meta content="index,follow" name="robots" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={ogType} property="og:type" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content={new URL('/og-image.png', Astro.site)} property="og:image" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={new URL('/og-image.png', Astro.site)} name="twitter:image" />
    <meta content="strict-origin-when-cross-origin" name="referrer" />
    <meta
      content="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:;"
      http-equiv="Content-Security-Policy"
    />
    <script
      set:html={JSON.stringify(structuredData)}
      type="application/ld+json"
    />
    <script>
      import { installGlobalEventReporter } from '../lib/event-reporting.mts';
      import { installMailtoLinkHandler } from '../lib/mailto-links.mts';

      installGlobalEventReporter(window);
      installMailtoLinkHandler(window, document);
    </script>
  </head>
  <body data-current-role={roleLabel ?? ''}>
    <ClientRouter />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header aria-label="Page header" class="mail-topbar">
      <div class="mail-topbar__inner">
        <div class="mail-topbar__meta">
          <p class="mail-topbar__eyebrow">{siteName}</p>
          <p class="mail-topbar__title">{roleLabel ?? 'Inbox'}</p>
        </div>
        {
          !isHomePage && (
            <a aria-label="Go to homepage" class="mail-topbar__home" href="/">
              <span aria-hidden="true" class="menu-icon">
                <House size={16} />
              </span>
              Home
            </a>
          )
        }
      </div>
    </header>
    <main
      class:list={['site-shell', `site-shell--${pageDensity}`]}
      data-page-density={pageDensity}
      data-route={canonicalPath}
      id="main-content"
    >
      <SelfReferenceNote
        className="site-global-echo"
        note={echoNote}
        pathname={canonicalPath}
      />
      <slot />
      <footer class="site-footer">
        <small class="site-footer-copy">
          &copy; {currentYear}
          {siteName}
          {
            showBuildVersion && (
              <span class="build-version">Build {BUILD_VERSION}</span>
            )
          }
        </small>
        {showLiveBuildBadge && <LiveBuildBadge />}
      </footer>
    </main>
    <RoleClientEnhancements />
  </body>
</html>
