---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import RoleClientEnhancements from '../components/RoleClientEnhancements.astro';
import LiveBuildBadge from '../components/LiveBuildBadge.astro';
import { BUILD_VERSION } from '../lib/build-version.mts';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  roleLabel?: string;
  schemaType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  schemaExtras?: Record<string, unknown>;
  ogType?: 'website' | 'profile';
  showBuildVersion?: boolean;
  showLiveBuildBadge?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  roleLabel,
  schemaType = 'WebPage',
  schemaExtras = {},
  ogType = 'website',
  showBuildVersion = true,
  showLiveBuildBadge = true,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site);
const isHomePage = canonicalPath === '/';
const siteName = 'Robertas Rudys';
const currentYear = Number(
  new Intl.DateTimeFormat('lt-LT', {
    timeZone: 'Europe/Vilnius',
    year: 'numeric',
  }).format(new Date())
);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: siteName,
    url: new URL('/', Astro.site),
  },
  ...(roleLabel
    ? {
        audience: {
          '@type': 'Audience',
          audienceType: roleLabel,
        },
      }
    : {}),
  ...schemaExtras,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:;"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script>
      import { installGlobalEventReporter } from '../lib/event-reporting.mts';
      import { installMailtoLinkHandler } from '../lib/mailto-links.mts';

      installGlobalEventReporter(window);
      installMailtoLinkHandler(window, document);
    </script>
  </head>
  <body data-current-role={roleLabel ?? ''}>
    <ClientRouter />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="mail-topbar" aria-label="Page header">
      <div class="mail-topbar__inner">
        <div class="mail-topbar__meta">
          <p class="mail-topbar__eyebrow">{siteName}</p>
          <p class="mail-topbar__title">{roleLabel ?? 'Inbox'}</p>
        </div>
        {
          !isHomePage && (
            <a class="mail-topbar__home" href="/" aria-label="Go to homepage">
              Home
            </a>
          )
        }
      </div>
    </header>
    <main id="main-content" class="site-shell">
      <slot />
      <footer class="site-footer">
        <small class="site-footer-copy">
          &copy; {currentYear}
          {siteName}
          {
            showBuildVersion && (
              <span class="build-version">Build {BUILD_VERSION}</span>
            )
          }
        </small>
        {showLiveBuildBadge && <LiveBuildBadge />}
      </footer>
    </main>
    <RoleClientEnhancements />
  </body>
</html>
