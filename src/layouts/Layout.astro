---
import '../styles/global.css';
import Controls from '../components/Controls.astro';
import { cvData } from '../data/cv.mts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props,
 { personalInfo } = cvData,

 jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personalInfo.name,
  jobTitle: personalInfo.title,
  description,
  url: 'https://robertasrudys.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: personalInfo.contact.location,
  },
  email: personalInfo.contact.email,
  sameAs: [
    'https://github.com/bitkojine',
    'https://www.linkedin.com/in/robertasr/',
  ],
  knowsAbout: cvData.coreSkills.map((s) => s.value).join(', '),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>

    <meta content={description} name="description" />
    <link href={new URL(Astro.url.pathname, Astro.site)} rel="canonical" />
    <meta content={personalInfo.name} name="author" />
    <meta content="index, follow" name="robots" />
    <meta
      content="Software Engineer, .NET, ASP.NET, C#, Backend Developer, Azure, Microservices"       name="keywords"
    />

    <meta content="light" name="color-scheme" />
    <script is:inline>
      document.documentElement.classList.remove('dark-mode');
      document.documentElement.style.colorScheme = 'light';

      const isStandalone =
        window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true;
      if (isStandalone) {
        document.documentElement.classList.add('standalone');
      }
    </script>
    <script>
      import { installGlobalEventReporter } from '../lib/event-reporting.mts';

      installGlobalEventReporter(window);
    </script>

    <link href="https://rsms.me/" rel="preconnect" />
    <link as="style" href="https://rsms.me/inter/inter.css" rel="preload" />
    <link
      href="https://rsms.me/inter/inter.css"       media="print"       onload="this.media='all'"       rel="stylesheet"
    />
    <noscript>
      <link href="https://rsms.me/inter/inter.css" rel="stylesheet" />
    </noscript>

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="profile" property="og:type" />
    <meta content={new URL(Astro.url.pathname, Astro.site)} property="og:url" />
    <meta content={new URL('og-image.png', Astro.site)} property="og:image" />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={new URL('og-image.png', Astro.site)} name="twitter:image" />

    <script set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
  </head>
  <body>
    <slot />
    <Controls />
  </body>
</html>
