{
  "name": "cv-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "fetch-activity": "tsx src/scripts/fetch-github-activity.mts",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui-stress": "env -u NO_COLOR playwright test tests/e2e/ui-stress.spec.ts",
    "test": "npm run test:unit",
    "lint:workflows": "./scripts/lint-workflows.sh",
    "lint": "astro sync && eslint \"src/**/*.{astro,ts,mts,js,mjs}\" \"tests/**/*.{ts,mts,js,mjs}\" \"*.config.{ts,mts,mjs,js}\" eslint.config.mjs --max-warnings=0",
    "lint:md": "markdownlint-cli2",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:sh": "shellcheck scripts/*.sh stress/run_all.sh",
    "lint:yaml": "yamllint .github/workflows/*.yml",
    "lint:json": "find . -name '*.json' -not -path './node_modules/*' -not -path './dist/*' -not -path './.astro/*' -print0 | xargs -0 -n1 jq -e . >/dev/null",
    "lint:extra": "npm run lint:md && npm run lint:css && npm run lint:sh && npm run lint:yaml && npm run lint:json",
    "lint:comments": "./scripts/zero-comment-policy.sh --all",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:e2e:ci": "env -u NO_COLOR playwright test --fail-on-flaky-tests"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@lucide/astro": "^0.563.0",
    "astro": "^5.17.1",
    "github-markdown-css": "^5.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "shellcheck": "^4.1.0",
    "stylelint": "^17.3.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "yaml-lint": "^1.7.0"
  }
}
