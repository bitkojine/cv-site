{
  "name": "cv-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "fetch-activity": "tsx src/scripts/fetch-github-activity.mts",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui-stress": "env -u NO_COLOR playwright test tests/e2e/ui-stress.spec.ts",
    "test": "npm run test:unit",
    "lint": "eslint .",
    "lint:comments": "./scripts/zero-comment-policy.sh --all",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@lucide/astro": "^0.563.0",
    "astro": "^5.17.1",
    "github-markdown-css": "^5.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
